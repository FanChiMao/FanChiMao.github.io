---
/**
 * "Stamp collected" toast for the 52Hz Logbook, and the personal-world event sources
 * (chapter visits, whale breach, shooting star). Only rendered by PersonalLayout.
 *
 * Its strings sit on a hidden element inside <main> (see PersonalLayout) so the in-place
 * language switch updates them; the toast itself lives outside and is built on demand.
 */
import Medal from './Medal.astro';
import { ACHIEVEMENTS } from '@/lib/passport';
---

<div class="ptoast" data-ptoast role="status" aria-live="polite" hidden></div>
<!-- One badge per achievement, cloned into the toast (badges are language-independent). -->
<template data-ptoast-medals>
  {ACHIEVEMENTS.map((a) => <Medal icon={a.icon} class="ptoast__medal" data-medal={a.id} />)}
</template>

<script>
  import { markSeen, track, unseen, type AchievementId } from '@/lib/passport';
  import { startSync } from '@/lib/passport-stats';

  // Anonymous badge stats: register this browser and report its badges (personal world only).
  startSync();

  const toast = document.querySelector<HTMLElement>('[data-ptoast]')!;
  const strings = () => {
    try {
      return JSON.parse(document.querySelector<HTMLElement>('[data-passport-strings]')?.dataset.passportStrings ?? '{}') as {
        toast: string;
        earned: string;
        view: string;
        href: string;
        names: Record<string, string>;
      };
    } catch {
      return null;
    }
  };
  const onPassportPage = () => !!document.querySelector('[data-passport]');

  // ---- Event sources in the personal world
  const chapter = document.querySelector<HTMLElement>('[data-chapter]')?.dataset.chapter;
  if (chapter) track('visit', chapter);
  document.addEventListener('breach', () => track('breach'));
  if (new Date().getHours() < 4) track('night');
  document.addEventListener('meteor', () => track('meteor'));
  document.addEventListener('whale-touch', () => track('whale-touch'));
  document.addEventListener('boat', () => track('boat'));
  document.addEventListener('boat-sun', () => track('boat-sun'));
  // Opening an album page.
  const album = location.pathname.match(/\/personal\/gallery\/([^/]+)\/?$/)?.[1];
  if (album) track('album', album);

  // ---- Stack up to three toasts; keep the rest pending until a card leaves.
  const queue: AchievementId[] = [];
  const active = new Set<AchievementId>();
  const announced = new Set<AchievementId>();
  const maxVisible = 3;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function next(): void {
    if (active.size >= maxVisible) return;
    const id = queue.shift();
    if (!id) return;
    // The passport page shows (and marks) every stamp itself.
    if (onPassportPage()) {
      markSeen(id);
      return next();
    }
    const s = strings();
    if (!s) return;
    active.add(id);
    announced.add(id);
    markSeen(id);
    const link = document.createElement('a');
    link.className = 'ptoast__card';
    link.href = s.href;
    link.dataset.state = 'unlocked';
    const medal = document.querySelector<HTMLTemplateElement>('[data-ptoast-medals]')?.content.querySelector(`[data-medal="${id}"]`);
    if (medal) {
      const m = medal.cloneNode(true) as HTMLElement;
      m.classList.add('is-shining');
      link.append(m);
    }
    const text = document.createElement('span');
    text.className = 'ptoast__text';
    text.innerHTML = '<small></small><strong></strong><em></em>';
    text.querySelector('small')!.textContent = s.toast;
    text.querySelector('strong')!.textContent = s.earned.replace('{name}', s.names[id] ?? id);
    text.querySelector('em')!.textContent = `${s.view} →`;
    link.append(text);
    toast.append(link);
    toast.hidden = false;
    requestAnimationFrame(() => link.classList.add('is-in'));
    let done = false;
    let timer: ReturnType<typeof setTimeout>;
    const hide = () => {
      if (done) return;
      done = true;
      clearTimeout(timer);
      link.classList.remove('is-in');
      setTimeout(
        () => {
          link.remove();
          active.delete(id);
          toast.hidden = active.size === 0;
          next();
        },
        reduce ? 0 : 350,
      );
    };
    timer = setTimeout(hide, 5000);
    // Hovering or focusing keeps it up; leaving lets it go.
    const pause = () => clearTimeout(timer);
    const resume = () => {
      clearTimeout(timer);
      if (!done && !link.matches(':hover, :focus-within')) timer = setTimeout(hide, 1500);
    };
    link.addEventListener('pointerenter', pause);
    link.addEventListener('pointerleave', resume);
    link.addEventListener('focusin', pause);
    link.addEventListener('focusout', resume);
    next();
  }

  const enqueue = (id: AchievementId) => {
    if (!announced.has(id) && !queue.includes(id)) queue.push(id);
    next();
  };
  for (const id of unseen()) enqueue(id);
  addEventListener('passport:unlock', (e) => enqueue((e as CustomEvent<{ id: AchievementId }>).detail.id));
</script>

<style is:global>
  .ptoast {
    --pt-bg: rgb(4 14 28 / 0.88);
    --pt-ink: #e6f1fb;
    --pt-dim: rgb(230 241 251 / 0.6);
    --pt-accent: #7fd8e6;
    --pt-line: rgb(127 216 230 / 0.35);
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 80;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(24rem, calc(100vw - max(1rem, env(safe-area-inset-left)) - max(1rem, env(safe-area-inset-right))));
    max-height: calc(100dvh - max(1rem, env(safe-area-inset-top)) - max(1rem, env(safe-area-inset-bottom)));
    overflow-y: auto;
  }
  .ptoast[hidden] {
    display: none;
  }
  .ptoast__card {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1.1rem 0.75rem 0.8rem;
    border: 1px solid var(--pt-line);
    border-radius: 16px;
    background: var(--pt-bg);
    backdrop-filter: blur(12px);
    color: var(--pt-ink);
    box-shadow: 0 18px 50px -18px rgb(0 0 0 / 0.7);
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 0.35s,
      translate 0.45s var(--ease-out);
  }
  .ptoast__card.is-in {
    opacity: 1;
    translate: 0 0;
  }
  .ptoast__medal {
    --size: 3.4rem;
    flex: none;
  }
  .ptoast__card.is-in .ptoast__medal {
    animation: ptoast-medal 0.7s 0.1s var(--ease-out) both;
  }
  @keyframes ptoast-medal {
    from {
      scale: 0.4;
      rotate: -35deg;
      opacity: 0;
    }
  }
  .ptoast__text {
    display: grid;
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }
  .ptoast__text small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pt-accent);
  }
  .ptoast__text strong {
    font-family: var(--font-display);
    font-size: 1rem;
    max-width: 18rem;
  }
  .ptoast__text em {
    font-style: normal;
    font-size: 0.78rem;
    color: var(--pt-dim);
  }
  [data-theme='light'] .ptoast {
    --pt-bg: rgb(255 255 255 / 0.92);
    --pt-ink: #0a1626;
    --pt-dim: #566a80;
    --pt-accent: #0b6f8c;
    --pt-line: rgb(11 111 140 / 0.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .ptoast__card,
    .ptoast__card.is-in .ptoast__medal {
      transition: none;
      animation: none;
    }
  }
</style>

---
/**
 * Photos and videos of one post (Ajie, Journey), as a swipeable strip.
 * - image: responsive <Image>
 * - video: a clip in the R2 bucket (src "/media/..." -> https://media.52hzfan.com/...); muted loop like an IG clip (plays only while in view,
 *   never with reduced motion), or with controls and sound when `loop: false`
 * - youtube: poster with a play button; opens in the shared media dialog (Base.astro)
 */
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { ui, type Locale } from '@/i18n/ui';
import { personalUi } from '@/i18n/personal';
import { asset } from '@/lib/assets';
import { clipUrl } from '@/lib/media';

/** `fit: 'contain'` shows the whole picture (e.g. a square illustration) instead of cropping it. */
type Media = CollectionEntry<'ajie'>['data']['media'][number] & { fit?: 'contain' };

interface Props {
  lang: Locale;
  media: Media[];
  /** CSS aspect-ratio of the frame. */
  ratio?: string;
  /** Text used for alt when an item has none. */
  label: string;
  sizes?: string;
  eager?: boolean;
  /** The first item is an optional AI illustration controlled by the Ajie page preference. */
  firstIsAi?: boolean;
}
const { lang, media, ratio = '4 / 5', label, sizes = '(min-width: 900px) 560px, 100vw', eager = false, firstIsAi = false } = Astro.props;
const a11y = ui[lang].a11y;
const pm = personalUi[lang].posts;
const pick = (v: string | Record<Locale, string> | undefined) => (typeof v === 'string' ? v : v?.[lang]);
const items = await Promise.all(
  media.map(async (m, i) => {
    const alt = pick(m.alt) ?? (media.length > 1 ? `${label} (${i + 1}/${media.length})` : label);
    if (m.type === 'image') return { ...m, alt, img: asset(m.src) };
    const poster = m.poster ? await getImage({ src: asset(m.poster), width: 1080, format: 'webp', quality: 78 }) : null;
    return { ...m, alt, posterSrc: poster?.src, ...(m.type === 'video' ? { src: clipUrl(m.src) } : {}) };
  }),
);
---

<div class="pmedia" data-pmedia style={`--ratio: ${ratio}`}>
  <ul class="pmedia__track" tabindex={items.length > 1 ? 0 : undefined} aria-label={label}>
    {
      items.map((m, i) => (
        <li class="pmedia__slide" data-ai-cover={firstIsAi && i === 0 ? '' : undefined} aria-label={items.length > 1 ? `${i + 1} / ${items.length}` : undefined}>
          {m.type === 'image' && <Image class:list={{ 'pmedia__contain': m.fit === 'contain' }} src={m.img} alt={m.alt} width={1200} widths={[480, 800, 1200]} {sizes} quality={80} loading={eager && i === 0 ? 'eager' : 'lazy'} />}
          {m.type === 'video' &&
            (m.loop ? (
              <>
                <video src={m.src} poster={m.posterSrc} muted loop playsinline preload="none" data-autoplay aria-label={m.alt} />
                <img class="pmedia__poster" src={m.posterSrc} alt="" aria-hidden="true" decoding="async" />
                <span class="pmedia__spin" aria-hidden="true" />
                <button class="pmedia__sound" type="button" data-sound aria-pressed="false" aria-label={pm.sound}>
                  <Icon name="lucide:volume-x" class="pmedia__muted" />
                  <Icon name="lucide:volume-2" class="pmedia__unmuted" />
                </button>
              </>
            ) : (
              <>
                <video src={m.src} poster={m.posterSrc} controls playsinline preload="metadata" aria-label={m.alt} />
                <span class="pmedia__spin" aria-hidden="true" />
              </>
            ))}
          {m.type === 'youtube' && (
            <a class="pmedia__yt" href={`https://www.youtube.com/watch?v=${m.id}`} data-video={m.id} data-title={m.alt} aria-label={`${pm.play}: ${m.alt}`}>
              {m.posterSrc ? <img src={m.posterSrc} alt="" loading="lazy" decoding="async" /> : <img src={`https://i.ytimg.com/vi/${m.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />}
              <span class="pmedia__play" aria-hidden="true">
                <Icon name="lucide:play" />
              </span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
  {
    items.length > 1 && (
      <>
        <button class="pmedia__btn pmedia__btn--prev" type="button" data-pmedia-control data-dir="-1" aria-label={a11y.prev}>
          <Icon name="lucide:chevron-left" />
        </button>
        <button class="pmedia__btn pmedia__btn--next" type="button" data-pmedia-control data-dir="1" aria-label={a11y.next}>
          <Icon name="lucide:chevron-right" />
        </button>
        <div class="pmedia__dots" data-pmedia-control>
          {items.map((_, i) => (
            <button type="button" class:list={{ 'is-on': i === 0 }} data-ai-cover={firstIsAi && i === 0 ? '' : undefined} aria-label={`${a11y.goTo} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
          ))}
        </div>
      </>
    )
  }
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Looping clips play only while visible (and never with reduced motion).
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting && !reduce) v.play().catch(() => {});
        else v.pause();
      }
    },
    { threshold: 0.6 },
  );

  document.querySelectorAll<HTMLElement>('[data-pmedia]:not([data-ready])').forEach((root) => {
    root.dataset.ready = '';
    const track = root.querySelector<HTMLElement>('.pmedia__track')!;
    const allSlides = Array.from(track.children) as HTMLElement[];
    const allDots = Array.from(root.querySelectorAll<HTMLButtonElement>('.pmedia__dots button'));
    const controls = Array.from(root.querySelectorAll<HTMLElement>('[data-pmedia-control]'));
    const slides = () => allSlides.filter((s) => !s.hidden);
    const dots = () => allDots.filter((d) => !d.hidden);

    root.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
      if (reduce) v.controls = true;
      else io.observe(v);
    });
    // Some browsers (Safari) drop the poster as soon as play() is called and show black until the
    // first frame is decoded. A poster <img> stays on top until a frame is really on screen, and a
    // spinner shows (after a short delay, see CSS) only while the clip is waiting for data.
    root.querySelectorAll<HTMLVideoElement>('.pmedia__slide video').forEach((v) => {
      const slide = v.parentElement!;
      const set = (state: 'loading' | 'playing' | 'paused') => (slide.dataset.state = state);
      let framed = false; // a frame has been on screen at least once
      const shown = () => {
        framed = true;
        set('playing');
      };
      v.addEventListener('play', () => v.readyState < 3 && set('loading'));
      v.addEventListener('waiting', () => set('loading'));
      v.addEventListener('playing', () => {
        if (framed) set('playing');
        else if (v.requestVideoFrameCallback) v.requestVideoFrameCallback(shown);
      });
      // Fallback (and for browsers without requestVideoFrameCallback): time moving means frames are showing.
      v.addEventListener('timeupdate', () => !v.paused && v.currentTime > 0 && slide.dataset.state !== 'playing' && shown());
      v.addEventListener('pause', () => slide.dataset.state === 'loading' && set('paused'));
      v.addEventListener('error', () => set('paused'));
    });
    root.querySelectorAll<HTMLButtonElement>('[data-sound]').forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.parentElement!.querySelector('video')!;
        v.muted = !v.muted;
        b.setAttribute('aria-pressed', String(!v.muted));
        if (!v.muted) v.play().catch(() => {});
      }),
    );

    const current = () => Math.min(Math.max(0, slides().length - 1), Math.round(track.scrollLeft / track.clientWidth));
    const paint = () => {
      const shownSlides = slides();
      const shownDots = dots();
      const i = current();
      allDots.forEach((d) => {
        d.classList.remove('is-on');
        d.removeAttribute('aria-current');
      });
      const active = shownDots[i];
      active?.classList.add('is-on');
      active?.setAttribute('aria-current', 'true');
      allSlides.forEach((s) => s !== shownSlides[i] && s.querySelector('video')?.pause());
      // Warm up the clip on this slide and the next one.
      for (const s of [shownSlides[i], shownSlides[i + 1]]) {
        const v = s?.querySelector<HTMLVideoElement>('video[data-autoplay]');
        if (v && v.preload === 'none' && root.offsetParent !== null) v.preload = 'auto';
      }
    };
    // Wraps around: past the last photo comes the first, and the other way round.
    const go = (i: number) => {
      const n = slides().length;
      if (n < 1) return;
      const to = ((i % n) + n) % n;
      const jump = Math.abs(to - current()) > 1;
      track.scrollTo({ left: to * track.clientWidth, behavior: reduce || jump ? 'auto' : 'smooth' });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => go(current() + Number(b.dataset.dir))));
    allDots.forEach((d) => d.addEventListener('click', () => go(dots().indexOf(d))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
    track.addEventListener(
      'scroll',
      paint,
      { passive: true },
    );
    const syncAiCover = () => {
      const hide = root.closest('[data-ai-illustrations="hide"]') !== null;
      root.querySelectorAll<HTMLElement>('[data-ai-cover]').forEach((el) => (el.hidden = hide));
      track.scrollLeft = 0;
      controls.forEach((el) => (el.hidden = slides().length < 2));
      paint();
    };
    syncAiCover();
    document.addEventListener('ajie-ai-change', syncAiCover);
  });
</script>

<style is:global>
  .pmedia {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #050a14;
  }
  .pmedia__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .pmedia__track::-webkit-scrollbar {
    display: none;
  }
  .pmedia__slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: var(--ratio, 4 / 5);
    scroll-snap-align: start;
  }
  .pmedia__slide > img,
  .pmedia__slide > video,
  .pmedia__yt img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Poster layer over a clip, gone once a frame is on screen (data-state set by the script). */
  .pmedia__slide > .pmedia__poster {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .pmedia__slide[data-state='playing'] > .pmedia__poster {
    opacity: 0;
  }
  .pmedia__spin {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem;
    box-sizing: border-box;
    border: 3.5px solid rgb(255 255 255 / 0.28);
    border-top-color: #fff;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.38);
    box-shadow: 0 0 0 6px rgb(0 0 0 / 0.18), 0 4px 14px rgb(0 0 0 / 0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  /* Only when loading takes a moment, so quick starts never flash a spinner. */
  .pmedia__slide[data-state='loading'] > .pmedia__spin {
    opacity: 1;
    transition-delay: 0.35s;
    animation: pmedia-spin 0.8s linear infinite;
  }
  @keyframes pmedia-spin {
    to {
      rotate: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pmedia__slide[data-state='loading'] > .pmedia__spin {
      animation-duration: 2.4s;
    }
  }
  .pmedia__slide > img.pmedia__contain {
    object-fit: contain;
    background: #f7ecdf;
  }
  .pmedia__yt {
    position: absolute;
    inset: 0;
    display: block;
  }
  .pmedia__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .pmedia__play svg {
    width: 3.4rem;
    height: 3.4rem;
    padding: 0.9rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(6px);
    transition: transform 0.25s var(--ease-out);
  }
  .pmedia__yt:hover .pmedia__play svg {
    transform: scale(1.08);
  }
  .pmedia__sound {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    cursor: pointer;
  }
  .pmedia__sound svg {
    width: 1rem;
    height: 1rem;
  }
  .pmedia__sound[aria-pressed='true'] .pmedia__muted,
  .pmedia__sound[aria-pressed='false'] .pmedia__unmuted {
    display: none;
  }
  .pmedia__btn {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    color: #0a1626;
    cursor: pointer;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
  }
  .pmedia__btn[hidden] {
    display: none;
  }
  .pmedia__btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .pmedia__btn--prev {
    left: 0.6rem;
  }
  .pmedia__btn--next {
    right: 0.6rem;
  }
  .pmedia__dots {
    position: absolute;
    left: 50%;
    bottom: 0.4rem;
    translate: -50% 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    max-width: calc(100% - 6rem);
    padding: 0.15rem 0.3rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.25);
  }
  /* Each dot is a button with a comfortable hit area around the visible 6px dot. */
  .pmedia__dots button {
    display: grid;
    place-items: center;
    width: 16px;
    height: 18px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .pmedia__dots button::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.5);
    transition:
      background-color 0.25s,
      transform 0.25s;
  }
  .pmedia__dots button:hover::before {
    background: rgb(255 255 255 / 0.85);
    transform: scale(1.3);
  }
  .pmedia__dots button.is-on::before {
    background: #fff;
    transform: scale(1.3);
  }
  .pmedia__dots button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
    border-radius: 4px;
  }
</style>

---
import Whale from './Whale.astro';
import type { Locale } from '@/i18n/ui';
import { personalUi } from '@/i18n/personal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = personalUi[lang].whale;

// Approximate call ranges (Hz). Blue and fin whale calls sit far below the 52 Hz voice.
const rows = [
  { label: t.blue, from: 10, to: 39, text: '10–39 Hz', lone: false },
  { label: t.fin, from: 15, to: 30, text: '15–30 Hz', lone: false },
  { label: t.lone, from: 52, to: 52, text: '≈ 52 Hz', lone: true },
];
const X0 = 8;
const X1 = 592;
const x = (hz: number) => X0 + (hz / 100) * (X1 - X0);
const rowY = (i: number) => 34 + i * 44;
const ticks = [0, 20, 40, 60, 80, 100];
const AXIS_Y = 170;
---

<section class="section whale-note" id="why" aria-labelledby="why-title">
  <div class="container whale-note__grid">
    <div class="whale-note__text">
      <p class="pw-kicker" data-reveal>{t.kicker}</p>
      <h2 class="whale-note__title serif" id="why-title" data-reveal style="--i:1">{t.title}</h2>
      {t.body.map((para, i) => <p class="whale-note__body" data-reveal style={`--i:${i + 2}`}>{para}</p>)}
    </div>

    <figure class="freq" data-reveal="right">
      <Whale class="freq__whale" />
      <svg class="freq__chart" viewBox="0 0 600 196" role="img" aria-labelledby="freq-cap">
        {ticks.map((v) => <line class="freq__grid" x1={x(v)} x2={x(v)} y1="14" y2={AXIS_Y} />)}
        <line class="freq__axis" x1={X0} x2={X1} y1={AXIS_Y} y2={AXIS_Y} />
        {ticks.map((v) => <text class="freq__tick" x={x(v)} y={AXIS_Y + 18} text-anchor="middle">{v}</text>)}
        {
          rows.map((r, i) =>
            r.lone ? (
              <g class="freq__lone">
                <title>{`${r.label}: ${r.text}`}</title>
                <line class="freq__drop" x1={x(r.from)} x2={x(r.from)} y1={rowY(i) + 8} y2={AXIS_Y} />
                <circle class="freq__halo" cx={x(r.from)} cy={rowY(i)} r="16" />
                <circle class="freq__dot" cx={x(r.from)} cy={rowY(i)} r="6" />
                <text class="freq__label" x={x(r.from) + 16} y={rowY(i) - 10}>{r.label}</text>
                <text class="freq__value freq__value--lone" x={x(r.from) + 16} y={rowY(i) + 10}>{r.text}</text>
              </g>
            ) : (
              <g class="freq__band">
                <title>{`${r.label}: ${r.text}`}</title>
                <rect x={x(r.from)} y={rowY(i) - 7} width={x(r.to) - x(r.from)} height="14" rx="4" />
                <text class="freq__label" x={x(r.to) + 10} y={rowY(i) - 2}>{r.label}</text>
                <text class="freq__value" x={x(r.to) + 10} y={rowY(i) + 14}>{r.text}</text>
              </g>
            ),
          )
        }
      </svg>
      <figcaption id="freq-cap" class="freq__cap">{t.axis}</figcaption>
      <table class="sr-only">
        <caption>{t.axis}</caption>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.text}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </figure>
  </div>
</section>

<style>
  .whale-note__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .whale-note__text {
    display: grid;
    gap: 1.1rem;
  }
  .whale-note__title {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    line-height: 1.05;
  }
  .whale-note__body {
    color: var(--text-2);
    font-size: 1.05rem;
    max-width: 36rem;
  }

  .freq {
    position: relative;
    margin: 0;
    padding: 2rem 1.5rem 1.25rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .freq :global(.freq__whale) {
    width: 140px;
    margin: 0 0 0.5rem auto;
    color: var(--accent);
    opacity: 0.35;
    --whale-eye: var(--bg);
  }
  .freq__chart {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .freq__grid {
    stroke: var(--border);
    stroke-width: 1;
  }
  .freq__axis {
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .freq__tick {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .freq__band rect {
    fill: #9fb0c2;
    transition: opacity 0.2s;
  }
  :global([data-theme='dark']) .freq__band rect {
    fill: #43546a;
  }
  .freq__label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 600;
  }
  .freq__value {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .freq__value--lone {
    fill: var(--text-2);
  }
  .freq__dot {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .freq__halo {
    fill: var(--accent);
    opacity: 0.14;
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.is-visible) .freq__halo {
    animation: halo 3.2s var(--ease-in-out) infinite;
  }
  @keyframes halo {
    50% {
      transform: scale(1.5);
      opacity: 0.04;
    }
  }
  .freq__drop {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.6;
  }
  .freq__chart:hover .freq__band rect {
    opacity: 0.7;
  }
  .freq__band:hover rect {
    opacity: 1 !important;
  }
  .freq__cap {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 899px) {
    .whale-note__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

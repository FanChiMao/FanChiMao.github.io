---
import { localePath, type Locale } from '@/i18n/ui';
import { personalUi, chapters } from '@/i18n/personal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const p = personalUi[lang];

// Star positions of the four chapters inside the constellation box (percent). They float
// around the whale figure rather than sitting on its lines.
const pos: Record<string, [number, number]> = {
  gallery: [8, 9],
  journey: [60, 6],
  companion: [16, 88],
  secrets: [64, 91],
};
const nodes = chapters.map((c) => ({ ...c, href: localePath(lang, c.path), at: pos[c.id], copy: p.chapters[c.id] }));
/*
 * Star-atlas style figure behind the chapters: a humpback seen from the side, heading left,
 * tail fluke raised on the right. Drawn in its own 200 x 110 space (kept in proportion).
 */
const whale = {
  body: 'M14 62C18 46 40 36 70 36C100 36 122 40 140 48C150 52 158 54 164 50C170 44 176 34 188 27C186 38 182 46 176 52C184 58 190 66 196 77C184 72 172 64 164 60C150 62 132 70 108 74C80 78 46 78 30 72C22 69 16 66 14 62Z',
  fin: 'M62 74C66 86 74 96 89 103C85 92 79 82 75 75',
  dorsal: 'M126 41C130 35 134 34 138 39',
  grooves: 'M17 64C30 69 46 71 62 71M24 69C38 74 52 75 66 74',
};
/** A few faint stars on the figure, as on a star chart. */
const figureStars: [number, number, number][] = [
  [14, 62, 1.6],
  [70, 36, 1.3],
  [132, 36, 1.4],
  [188, 27, 1.8],
  [196, 77, 1.5],
  [108, 74, 1.2],
  [89, 103, 1.5],
  [30, 59, 1.1],
];
---

<section class="abyss" aria-labelledby="abyss-title" data-theme-scene>
  <!-- Night sky is the section background; the sunrise sky cross-fades in over it. -->
  <div class="abyss__day" aria-hidden="true"></div>
  <canvas class="abyss__sky" data-abyss aria-hidden="true"></canvas>
  <!-- Moon by night, rising sun by day; both sit above the sea's glitter path (--light-x). -->
  <div class="abyss__moon" aria-hidden="true"></div>
  <div class="abyss__sun" aria-hidden="true"></div>
  <canvas class="abyss__sea" data-sea aria-hidden="true"></canvas>
  <div class="abyss__horizon" aria-hidden="true"></div>

  <!-- Far away on the horizon: someone in a small boat, drifting slowly left to right. -->
  <div class="abyss__boat-track" aria-hidden="true">
    <!-- Heading right: raised bow on the right, rower leaning forward, paddle reaching ahead,
         and a cat sitting at the stern looking towards them. -->
    <svg class="abyss__boat" viewBox="0 0 60 26">
      <ellipse cx="10.8" cy="15.9" rx="2.7" ry="3" />
      <circle cx="12.3" cy="12" r="1.85" />
      <path d="M10.7 11.1 11 8.9 12.3 10.5Z M12.6 10.4 14 8.8 14.2 11.1Z" />
      <path d="M8.3 17.6Q5.4 17 6 13.9" stroke-width="0.9" stroke-linecap="round" fill="none" />
      <path d="M2 18.5Q26 20 50 18L58.5 13.5Q56 20.5 51 23.5Q30 25 10 23.8Q4 22 2 18.5Z" />
      <circle cx="24.2" cy="8.4" r="2.3" />
      <path d="M21.2 18.2 22.2 12.6Q24.6 10.6 26.6 12.4L28.6 17.6Z" />
      <path d="M27.4 12.9 39.6 22.3" stroke-width="0.9" stroke-linecap="round" fill="none" />
      <ellipse cx="40.4" cy="22.9" rx="1.7" ry="0.7" transform="rotate(38 40.4 22.9)" />
    </svg>
  </div>

  <!-- Whale breaches and their spray (lib/breach.ts). -->
  <canvas class="abyss__fx" data-fx aria-hidden="true"></canvas>

  <div class="container abyss__inner">
    <div class="abyss__copy">
      <p class="abyss__eyebrow">{p.hero.eyebrow}</p>
      <h1 class="abyss__title" id="abyss-title">
        <span class="abyss__hz">{p.hero.title}</span>
        <span class="abyss__sub">{p.hero.subtitle}</span>
      </h1>
      <p class="abyss__tagline">{p.hero.tagline}</p>
    </div>

    <nav class="sky-map" aria-label={p.hero.explore}>
      <svg class="sky-map__whale" viewBox="0 0 200 110" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <!-- Puffy, uneven edges for the daytime cloud. -->
          <filter id="whale-cloud" x="-15%" y="-25%" width="130%" height="150%">
            <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="52" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G" result="puffed" />
            <feGaussianBlur in="puffed" stdDeviation="2.4" />
          </filter>
        </defs>
        <!-- By day there are no constellations: the whale is a cloud instead. -->
        <g class="whale__day" filter="url(#whale-cloud)">
          <path d={whale.body} />
          <path d={whale.fin} />
          <path d={whale.dorsal} />
        </g>
        <g class="whale__night">
          <path class="whale__line" d={whale.body} pathLength="1" />
          <path class="whale__line whale__line--fine" d={whale.fin} pathLength="1" />
          <path class="whale__line whale__line--fine" d={whale.dorsal} pathLength="1" />
          <path class="whale__line whale__line--faint" d={whale.grooves} pathLength="1" />
          {figureStars.map(([x, y, r], i) => <circle class="whale__star" cx={x} cy={y} r={r} style={`--i:${i}`} />)}
        </g>
      </svg>
      <ol>
        {
          nodes.map((n, i) => (
            <li style={`--x:${n.at[0]}%;--y:${n.at[1]}%;--i:${i}`}>
              <a href={n.href} class="sky-node">
                <span class="sky-node__star" aria-hidden="true" />
                <span class="sky-node__text">
                  <span class="sky-node__name serif">{n.copy.name}</span>
                  <span class="sky-node__kind">{n.copy.kind}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <a class="abyss__dive" href="#chapters">
    <span>{p.hero.scroll}</span>
    <span class="abyss__dive-line" aria-hidden="true"></span>
  </a>
</section>

<script>
  import { createOcean, PALETTES, type OceanPalette } from '@/lib/ocean';
  import { createBreach } from '@/lib/breach';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-abyss]');
  const seaCanvas = document.querySelector<HTMLCanvasElement>('[data-sea]');
  const hero = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');
  if (canvas && hero && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const HORIZON = 0.78;
    // Light theme is a sunrise, dark theme a moonlit night. `day` (0..1) eases between
    // them when the theme changes: stars fade, the sea's palette is interpolated.
    const isDay = () => document.documentElement.dataset.theme === 'light';
    let day = isDay() ? 1 : 0;
    const lerp = (a: number[], b: number[], t: number) => a.map((v, i) => v + (b[i] - v) * t) as [number, number, number];
    const blend = (t: number): OceanPalette => {
      const n = PALETTES.night;
      const d = PALETTES.dawn;
      return { horizon: lerp(n.horizon, d.horizon, t), zenith: lerp(n.zenith, d.zenith, t), deep: lerp(n.deep, d.deep, t), light: lerp(n.light, d.light, t), glow: lerp(n.glow, d.glow, t), fade: lerp(n.fade, d.fade, t), lightY: n.lightY + (d.lightY - n.lightY) * t, spec: n.spec + (d.spec - n.spec) * t };
    };
    let pal = blend(day);
    // WebGL sea below the horizon; without it, the 2D canvas draws starlight glints instead.
    let ocean = seaCanvas ? createOcean(seaCanvas, pal) : null;
    const fx = hero.querySelector<HTMLCanvasElement>('[data-fx]');
    const breach = fx
      ? createBreach(fx, {
          look: () => ({ haze: pal.horizon, light: pal.light, day }),
          waterline: () => fx.clientHeight * 0.86,
          x: () => fx.clientWidth * (innerWidth < 900 ? 0.34 : 0.72),
        })
      : null;
    if (!ocean) seaCanvas?.remove();
    seaCanvas?.addEventListener('ocean:lost', () => {
      ocean = null;
      seaCanvas.remove();
    });
    type Star = { x: number; y: number; r: number; a: number; ph: number; sp: number };
    type Glint = { x: number; y: number; len: number; ph: number; sp: number };
    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    let glints: Glint[] = [];
    let shoot: { x: number; y: number; vx: number; vy: number; t0: number } | null = null;
    /** A caught shooting star bursts into a small ring of sparks (52Hz Logbook: Stargazer). */
    let caught: { x: number; y: number; t0: number } | null = null;
    let nextShoot = performance.now() + 4000 + Math.random() * 6000;

    const seed = () => {
      const sky = h * HORIZON;
      const n = Math.max(60, Math.min(260, Math.round((w * sky) / 5200)));
      stars = Array.from({ length: n }, () => {
        const bright = Math.random() < 0.08;
        return {
          x: Math.random() * w,
          // Denser towards the top of the sky.
          y: Math.pow(Math.random(), 1.5) * sky * 0.97,
          r: bright ? 1.2 + Math.random() * 0.7 : 0.35 + Math.random() * 0.75,
          a: 0.35 + Math.random() * 0.6,
          ph: Math.random() * Math.PI * 2,
          sp: 0.5 + Math.random() * 1.5,
        };
      });
      glints = Array.from({ length: Math.round(w / 28) }, () => ({
        x: Math.random() * w,
        y: sky + 6 + Math.pow(Math.random(), 1.3) * (h - sky - 6),
        len: 6 + Math.random() * 28,
        ph: Math.random() * Math.PI * 2,
        sp: 0.6 + Math.random() * 1.2,
      }));
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      const s = t / 1000;
      const nightness = 1 - day;
      if (nightness > 0.001) for (const st of stars) {
        const a = nightness * (reduce ? st.a : st.a * (0.62 + 0.38 * Math.sin(s * st.sp + st.ph)));
        ctx.fillStyle = `rgba(222, 236, 255, ${a.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2);
        ctx.fill();
        if (st.r > 1.1) {
          ctx.fillStyle = `rgba(150, 205, 255, ${(a * 0.12).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(st.x, st.y, st.r * 4, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      // Starlight on the water: short horizontal glints (fallback when there is no WebGL sea).
      if (!ocean) for (const g of glints) {
        const a = reduce ? 0.12 : 0.05 + 0.22 * Math.max(0, Math.sin(s * g.sp + g.ph));
        ctx.fillStyle = `rgba(170, 215, 255, ${a.toFixed(3)})`;
        ctx.fillRect(g.x - g.len / 2, g.y, g.len, 1);
      }
      if (caught) {
        const k = (t - caught.t0) / 700;
        if (k >= 1) caught = null;
        else {
          const a = 1 - k;
          ctx.strokeStyle = `rgba(235, 245, 255, ${(a * 0.9).toFixed(3)})`;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.arc(caught.x, caught.y, 4 + k * 26, 0, Math.PI * 2);
          ctx.stroke();
          ctx.fillStyle = `rgba(255, 236, 190, ${a.toFixed(3)})`;
          for (let i = 0; i < 8; i++) {
            const ang = (i / 8) * Math.PI * 2;
            const d = 6 + k * 34;
            ctx.beginPath();
            ctx.arc(caught.x + Math.cos(ang) * d, caught.y + Math.sin(ang) * d, 1.4 * a + 0.3, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
      if (shoot) {
        const k = (t - shoot.t0) / 900;
        if (k >= 1) shoot = null;
        else {
          const x = shoot.x + shoot.vx * k;
          const y = shoot.y + shoot.vy * k;
          const grad = ctx.createLinearGradient(x, y, x - shoot.vx * 0.25, y - shoot.vy * 0.25);
          const a = Math.sin(k * Math.PI);
          grad.addColorStop(0, `rgba(235, 245, 255, ${a})`);
          grad.addColorStop(1, 'rgba(235, 245, 255, 0)');
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(x - shoot.vx * 0.25, y - shoot.vy * 0.25);
          ctx.stroke();
        }
      }
    };

    // Touching the whale mid-leap (52Hz Logbook).
    hero.addEventListener('pointerdown', (ev) => {
      if (!fx || !breach || (ev.target as Element).closest('a, button')) return;
      const r = fx.getBoundingClientRect();
      if (breach.hit(ev.clientX - r.left, ev.clientY - r.top)) fx.dispatchEvent(new CustomEvent('whale-touch', { bubbles: true }));
    });
    // The little boat (and the cat on board) answers a click with a rock.
    const boat = hero.querySelector<SVGElement>('.abyss__boat');
    boat?.addEventListener('click', () => {
      boat.classList.remove('is-rocking');
      boat.getBoundingClientRect();
      boat.classList.add('is-rocking');
      boat.dispatchEvent(new CustomEvent('boat', { bubbles: true }));
    });

    // The boat sailing across the rising sun (light theme): it has to be seen approaching
    // from the left and then reach the sun. Checked twice a second, once per page.
    const sun = hero.querySelector<HTMLElement>('.abyss__sun');
    if (boat && sun && !reduce) {
      let approaching = false;
      const watch = window.setInterval(() => {
        if (document.hidden || !onScreen || day < 0.95) return void (approaching = false);
        const b = boat.getBoundingClientRect();
        const s = sun.getBoundingClientRect();
        const x = b.left + b.width / 2;
        if (x <= s.left) approaching = true;
        else if (approaching && x < s.right) {
          clearInterval(watch);
          boat.dispatchEvent(new CustomEvent('boat-sun', { bubbles: true }));
        }
      }, 500);
    }

    // Click (or tap) a shooting star while it is still visible to catch it.
    hero.addEventListener('pointerdown', (ev) => {
      if (!shoot || (ev.target as Element).closest('a, button')) return;
      const now = performance.now();
      const k = (now - shoot.t0) / 900;
      if (k < 0 || k >= 1) return;
      const r = canvas.getBoundingClientRect();
      const px = ev.clientX - r.left;
      const py = ev.clientY - r.top;
      const hx = shoot.x + shoot.vx * k;
      const hy = shoot.y + shoot.vy * k;
      const tx = hx - shoot.vx * 0.25;
      const ty = hy - shoot.vy * 0.25;
      // Distance from the pointer to the visible streak (head -> tail segment).
      const dx = tx - hx;
      const dy = ty - hy;
      const u = Math.max(0, Math.min(1, ((px - hx) * dx + (py - hy) * dy) / (dx * dx + dy * dy || 1)));
      const dist = Math.hypot(px - (hx + u * dx), py - (hy + u * dy));
      if (dist > (ev.pointerType === 'touch' ? 56 : 40)) return;
      caught = { x: hx, y: hy, t0: now };
      shoot = null;
      canvas.dispatchEvent(new CustomEvent('meteor', { bubbles: true }));
    });

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      draw(performance.now());
      ocean?.resize();
      breach?.resize();
      if (reduce) ocean?.still();
    };

    let raf = 0;
    let last = 0;
    let onScreen = true;
    const frame = (t: number) => {
      raf = requestAnimationFrame(frame);
      if (t - last < 33) return; // ~30 fps is plenty for twinkling.
      last = t;
      if (!shoot && t > nextShoot && day < 0.5) {
        shoot = { x: w * (0.15 + Math.random() * 0.6), y: h * HORIZON * (0.05 + Math.random() * 0.35), vx: 220 + Math.random() * 160, vy: 90 + Math.random() * 60, t0: t };
        nextShoot = t + 9000 + Math.random() * 9000;
      }
      draw(t);
    };
    const run = () => {
      cancelAnimationFrame(raf);
      ocean?.stop();
      breach?.stop();
      if (reduce || !onScreen || document.hidden) return;
      raf = requestAnimationFrame(frame);
      ocean?.start();
      breach?.start();
    };
    // Theme switch: ease the sky and sea over the same 2.4 s as the moon / sun (CSS).
    // The moon sets to the right (CSS); rising, it should come up from the left, so park it
    // there (below the horizon) before its transition starts.
    const moon = hero.querySelector<HTMLElement>('.abyss__moon');
    const moonFromLeft = () => {
      if (!moon || reduce) return;
      moon.style.transition = 'none';
      moon.style.left = 'calc(var(--light-x) * 100% - 14%)';
      moon.style.top = '88%';
      moon.getBoundingClientRect();
      requestAnimationFrame(() => {
        moon.style.transition = moon.style.left = moon.style.top = '';
      });
    };
    let tween = 0;
    new MutationObserver(() => {
      const from = day;
      const to = isDay() ? 1 : 0;
      if (to === 0 && from > 0.5) moonFromLeft();
      cancelAnimationFrame(tween);
      if (reduce || from === to) {
        day = to;
        pal = blend(day);
        ocean?.setPalette(pal);
        draw(performance.now());
        return;
      }
      const t0 = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / 2400);
        const e = k < 0.5 ? 4 * k * k * k : 1 - (-2 * k + 2) ** 3 / 2;
        day = from + (to - from) * e;
        pal = blend(day);
        ocean?.setPalette(pal);
        draw(now);
        if (k < 1) tween = requestAnimationFrame(step);
      };
      tween = requestAnimationFrame(step);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    resize();
    new ResizeObserver(() => resize()).observe(hero);
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      run();
    }).observe(hero);
    document.addEventListener('visibilitychange', run);
    run();
  }
</script>

<style>
  .abyss__hz,
  .abyss__eyebrow,
  .abyss__sub,
  .abyss__tagline,
  .sky-map__hint,
  .sky-node__name,
  .sky-node__kind,
  .abyss__dive {
    /* Ink holds, then flips around the middle of the sky's 2.4 s change. Only leaf text
       transitions: if an ancestor also transitioned colour, Chromium would restart these
       every frame until the ancestor finished. */
    transition: color 1.7s cubic-bezier(0.7, 0, 0.3, 1);
  }
  .abyss {
    /* Where the light sits above the horizon (fraction of the width); shared by the sea shader. */
    --light-x: 0.45;
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding: calc(var(--nav-h) + 2rem) 0 7rem;
    overflow: hidden;
    color: var(--abyss-ink);
    /* Night sky above, deep water below; starts at the dive overlay's colour. */
    background:
      radial-gradient(90% 30% at calc(var(--light-x) * 100%) 78%, rgb(40 110 170 / 0.32), transparent 70%),
      linear-gradient(to bottom, var(--abyss) 0%, #051530 48%, #0a2645 77.6%, #041222 78.4%, #020a16 92%, var(--abyss) 100%);
  }
  .abyss__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .abyss__sea {
    position: absolute;
    left: 0;
    right: 0;
    top: 78%;
    bottom: 0;
    z-index: -1;
    width: 100%;
    height: 22%;
  }
  .abyss__horizon {
    position: absolute;
    left: 0;
    right: 0;
    top: 78%;
    z-index: -1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(170 220 255 / 0.55) 30%, rgb(170 220 255 / 0.55) 70%, transparent);
    box-shadow: 0 0 28px 3px rgb(90 170 230 / 0.3);
  }

  .abyss__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .abyss__copy > * {
    animation: rise 1.1s var(--ease-out) both;
  }
  .abyss__title {
    display: grid;
    margin: 0.6rem 0 1.4rem;
    animation-delay: 0.12s;
  }
  .abyss__tagline {
    animation-delay: 0.3s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .abyss__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgb(150 214 255 / 0.75);
  }
  /* Same display face as the professional site. */
  .abyss__hz {
    color: var(--abyss-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 6.4vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .abyss__sub {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.4vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: rgb(190 222 245 / 0.9);
  }
  .abyss__tagline {
    max-width: 26rem;
    font-size: 1.08rem;
    color: rgb(200 220 240 / 0.72);
  }

  /* ---- Constellation of chapters */
  .sky-map {
    position: relative;
    height: clamp(340px, 54vh, 520px);
  }
  .sky-map__hint {
    position: absolute;
    right: 0;
    top: -2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(150 214 255 / 0.5);
    animation: rise 1s 0.9s var(--ease-out) both;
  }
  .sky-map__whale {
    position: absolute;
    inset: 10% -2% 10% 2%;
    width: 100%;
    height: 80%;
    overflow: visible;
    pointer-events: none;
  }
  .whale__line {
    fill: none;
    stroke: rgb(170 215 250 / 0.32);
    /* In viewBox units (the figure scales uniformly). No non-scaling-stroke here: with it,
       Chromium measures the dash in screen pixels instead of pathLength and the tail stays hidden. */
    stroke-width: 0.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Drawn in, like a pen tracing the chart. */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-whale 2.8s 1.1s cubic-bezier(0.45, 0, 0.2, 1) forwards;
    transition: stroke 2.4s;
  }
  .whale__line--fine {
    stroke-width: 0.42;
    animation-delay: 2.2s;
    animation-duration: 1.6s;
  }
  .whale__line--faint {
    stroke: rgb(170 215 250 / 0.16);

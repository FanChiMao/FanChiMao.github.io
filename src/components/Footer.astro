---
import { Icon } from 'astro-icon/components';
import { locales, localeMeta, localePath, ui, type Locale } from '@/i18n/ui';
import { site } from '@/lib/site';

interface Props {
  lang: Locale;
  path: string;
  /** Show the ClustrMaps visitor widget (home page only). */
  visitors?: boolean;
  /** Continue the deep-sea colour of the section above (after "Go Deeper?"), in either theme. */
  abyss?: boolean;
}
const { lang, path, visitors = false, abyss = false } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const vm = site.visitorMap;
const vmQuery = new URLSearchParams({ d: vm.id, w: String(vm.width), t: 'm', ...vm.colors }).toString();
---

<footer class:list={['footer', { 'footer--abyss': abyss }]}>
  <div class="container footer__inner">
    <div class="footer__main">
    <div class="footer__brand">
      <p class="footer__name">Chi-Mao Fan · 范植貿</p>
      <p class="footer__copy">© {year} {site.name}. {t.footer.rights}</p>
    </div>

    <ul class="footer__socials">
      {
        site.socials.map((s) => (
          <li>
            <a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} />
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="footer__langs" aria-label={t.a11y.language}>
      {
        locales.map((l) => (
          <li>
            <a data-lang-link href={localePath(l, path)} lang={localeMeta[l].htmlLang} aria-current={l === lang ? 'true' : undefined}>
              {localeMeta[l].label}
            </a>
          </li>
        ))
      }
    </ul>

    </div>

    {
      visitors && (
        <figure class="footer__visitors">
          <figcaption>
            <Icon name="lucide:globe" />
            {t.footer.visitors}
          </figcaption>
          <div class="footer__map">
            <script is:inline type="text/javascript" id="mapmyvisitors" src={`https://mapmyvisitors.com/map.js?${vmQuery}`} onerror="this.closest('figure').remove()"></script>
            <script is:inline>
              // The widget renders as <a target="_top" href="http://...">; open it in a new tab instead.
              (() => {
                const box = document.currentScript.parentElement;
                const fix = () => {
                  const a = box.querySelector('#mapmyvisitors-widget');
                  if (!a || (a.target === '_blank' && a.href.startsWith('https:'))) return;
                  a.target = '_blank';
                  a.rel = 'noopener';
                  a.href = a.href.replace(/^http:/, 'https:');
                };
                new MutationObserver(fix).observe(box, { childList: true, subtree: true, attributes: true, attributeFilter: ['target', 'href'] });
              })();
            </script>
            <noscript>
              <a href={vm.page} title="Visit tracker" target="_blank" rel="noopener">
                <img src={`https://mapmyvisitors.com/map.png?d=${vm.id}&cl=${vm.colors.cl}`} alt={t.footer.visitors} width={vm.width} loading="lazy" />
              </a>
            </noscript>
          </div>
        </figure>
      )
    }
  </div>
</footer>

<style>
  .footer {
    margin-top: 2rem;
    padding-block: 3rem 2.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  /* Deep water to the bottom of the page: dark tokens whatever the theme. */
  .footer--abyss {
    --text: #e6f1fb;
    --text-2: #c3d3e4;
    --muted: rgb(175 200 225 / 0.62);
    --accent: #7fd8e6;
    --border: rgb(170 210 240 / 0.1);
    margin-top: 0;
    border-top: 0;
    color: var(--text);
    background: var(--abyss, #020814);
  }
  :global([data-theme='light']) .footer--abyss .footer__visitors {
    filter: none;
    border-color: var(--border);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
  }
  .footer__main {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.1rem;
  }
  .footer__copy {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer__socials,
  .footer__langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__socials .icon-btn:hover {
    color: var(--accent);
  }
  .footer__langs {
    gap: 0.25rem 1rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .footer__langs a:hover,
  .footer__langs a[aria-current] {
    color: var(--accent);
  }
  .footer__visitors {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #0b1424;
    box-shadow: var(--shadow-sm);
  }
  /* The widget's colours are baked into its PNG map, so the light theme flips the whole
     card instead of reloading the widget (a reload would count another page view).
     invert + hue-rotate(180deg) turns navy into pale blue while keeping hues roughly intact. */
  :global([data-theme='light']) .footer__visitors {
    filter: invert(1) hue-rotate(180deg);
    border-color: rgb(255 255 255 / 0.12);
    box-shadow: none;
  }
  .footer__visitors {
    transition: filter 0.4s var(--ease-out);
  }
  .footer__visitors figcaption {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.6rem 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9fb3d1;
  }
  .footer__visitors figcaption :global(svg) {
    width: 14px;
    height: 14px;
    color: #5cc6ff;
  }
  .footer__map {
    width: 300px;
    max-width: 100%;
    min-height: 147px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .footer__map :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
    .footer__visitors {
      justify-self: start;
      max-width: 100%;
    }
  }
</style>

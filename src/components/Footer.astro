---
import { Icon } from 'astro-icon/components';
import { locales, localeMeta, localePath, ui, type Locale } from '@/i18n/ui';
import { site } from '@/lib/site';

interface Props {
  lang: Locale;
  path: string;
  /** Show the ClustrMaps visitor widget (home page only). */
  visitors?: boolean;
}
const { lang, path, visitors = false } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">Chi-Mao Fan · 范植貿</p>
      <p class="footer__copy">© {year} {site.name}. {t.footer.rights}</p>
    </div>

    <ul class="footer__socials">
      {
        site.socials.map((s) => (
          <li>
            <a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} />
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="footer__langs" aria-label={t.a11y.language}>
      {
        locales.map((l) => (
          <li>
            <a href={localePath(l, path)} lang={localeMeta[l].htmlLang} aria-current={l === lang ? 'true' : undefined}>
              {localeMeta[l].label}
            </a>
          </li>
        ))
      }
    </ul>

    {
      visitors && (
        <div class="footer__visitors">
          <script is:inline type="text/javascript" id="clustrmaps" onerror="this.parentElement.remove()" src={`https://cdn.clustrmaps.com/map_v2.js?cl=1da1f2&w=240&t=n&d=${site.clustrmaps}&co=f2f3f7&ct=2d2121`}></script>
        </div>
      )
    }
  </div>
</footer>

<style>
  .footer {
    margin-top: 2rem;
    padding-block: 3rem 2.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 2rem;
    align-items: center;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.1rem;
  }
  .footer__copy {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer__socials,
  .footer__langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__socials .icon-btn:hover {
    color: var(--accent);
  }
  .footer__langs {
    gap: 0.25rem 1rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .footer__langs a:hover,
  .footer__langs a[aria-current] {
    color: var(--accent);
  }
  .footer__visitors {
    justify-self: end;
    grid-row: span 1;
    max-width: 240px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    opacity: 0.85;
  }
  @media (max-width: 700px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
    .footer__visitors {
      justify-self: start;
    }
  }
</style>

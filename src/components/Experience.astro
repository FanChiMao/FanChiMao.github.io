---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import { ui, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const items = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="experience">
  <div class="container">
    <SectionHead index={3} title={t.headings.experience} />
    <ol class="timeline">
      {
        items.map(({ data }, i) => (
          <li class="tl-item" data-reveal="right" style={`--i:${i}`}>
            <span class:list={['tl-dot', { 'is-current': data.end === null }]} aria-hidden="true">
              <Icon name="lucide:briefcase" />
            </span>
            <article class="card spotlight tl-card">
              <header class="tl-head">
                <div>
                  <h3 class="tl-company">{data.company[lang]}</h3>
                  <p class="tl-role">{data.role[lang]}</p>
                  {data.org && <p class="tl-org">{data.org[lang]}</p>}
                </div>
                <span class="badge">
                  {data.start} – {data.end ?? t.experience.present}
                </span>
              </header>
              <p class="tl-desc">{data.description[lang]}</p>
              {data.products && (
                <>
                  <h4 class="tl-sub">{t.experience.products}</h4>
                  <ol class="products">
                    {data.products.map((p) => (
                      <li class="product">
                        <header>
                          <strong>{p.name}</strong>
                          <span class="product__period">{p.period.endsWith('–') ? `${p.period}${t.experience.present}` : p.period}</span>
                        </header>
                        <p class="product__focus">{p.focus[lang]}</p>
                        <ul>
                          {p.points[lang].map((pt) => (
                            <li>{pt}</li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ol>
                </>
              )}
              {data.highlights && (
                <>
                  <h4 class="tl-sub">{t.experience.other}</h4>
                  <ul class="tl-highlights">
                    {data.highlights[lang].map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </>
              )}
              <ul class="tl-tags">
                {data.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0 0 0 3.25rem;
    list-style: none;
  }
  /* Track + progress line */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
  }
  .timeline::before {
    background: var(--border);
  }
  .timeline::after {
    background: linear-gradient(var(--accent), var(--accent-2));
    transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    .timeline::after {
      animation: grow linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 55%;
    }
    @keyframes grow {
      from {
        transform: scaleY(0);
      }
    }
  }

  .tl-item {
    position: relative;
  }
  .tl-dot {
    position: absolute;
    left: calc(-3.25rem);
    top: 1.4rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    color: var(--accent);
    z-index: 1;
  }
  .tl-dot :global(svg) {
    width: 18px;
    height: 18px;
  }
  .tl-dot.is-current::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0.5;
    animation: halo 2.4s var(--ease-out) infinite;
  }
  @keyframes halo {
    to {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .tl-card {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s;
  }
  .tl-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 0.9rem;
  }
  .tl-company {
    font-size: 1.35rem;
  }
  .tl-role {
    color: var(--accent);
    font-weight: 500;
  }
  .tl-org {
    margin-top: 0.2rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .tl-desc {
    color: var(--text-2);
  }
  .tl-sub {
    margin: 1.4rem 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product {
    position: relative;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease-out);
  }
  .product::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    border-radius: 3px;
    background: linear-gradient(var(--accent), var(--accent-2));
    opacity: 0.7;
  }
  .product:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .product header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
  }
  .product strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .product__period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  .product__focus {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-2);
  }
  .product ul,
  .tl-highlights {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--text-2);
  }
  .product li::marker,
  .tl-highlights li::marker {
    color: var(--accent);
  }
  @media (max-width: 1000px) {
    .products {
      grid-template-columns: 1fr;
    }
  }
  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>

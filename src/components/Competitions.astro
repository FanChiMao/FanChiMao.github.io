---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Carousel from './Carousel.astro';
import SectionHead from './SectionHead.astro';
import { ui, type Locale } from '@/i18n/ui';
import { asset } from '@/lib/assets';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const INITIAL = 4;
const items = (await getCollection('competitions')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="competitions">
  <div class="container">
    <SectionHead index={5} title={t.headings.competitions} />
    <div class="comp-grid" data-comp-grid>
      {
        items.map(({ data }, i) => (
          <article class="card spotlight comp" data-reveal style={`--i:${i % 2}`} data-extra={i >= INITIAL ? '' : undefined}>
            {data.images?.length ? (
              <Carousel images={data.images.map(asset)} alt={data.title[lang]} labels={t.a11y} fit={data.images[0].endsWith('.png') ? 'contain' : 'cover'} />
            ) : (
              <div class="comp__art" aria-hidden="true">
                <div class="comp__grid" />
                <Icon name={data.icon ?? 'lucide:sparkles'} />
              </div>
            )}
            <div class="comp__body">
              <span class="badge">{data.year}</span>
              <h3 class="comp__title">{data.title[lang]}</h3>
              {data.achievement && (
                <p class="comp__achievement">
                  <Icon name="lucide:trophy" />
                  {data.achievement[lang]}
                </p>
              )}
              <p class="comp__desc">{data.description[lang]}</p>
              <div class="comp__actions">
                <a class="btn btn--sm comp__link" href={data.repo} target="_blank" rel="noopener">
                  <Icon name="mdi:github" />
                  {t.competitions.code}
                  <Icon name="lucide:arrow-up-right" />
                </a>
                {data.video && (
                  <a class="btn btn--sm" href={`https://www.youtube.com/watch?v=${data.video}`} data-video={data.video} data-title={data.title[lang]}>
                    <Icon name="lucide:play" />
                    {t.competitions.demo}
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
    {
      items.length > INITIAL && (
        <div class="comp-more">
          <button class="btn" type="button" data-comp-more aria-expanded="false" data-more={t.competitions.more} data-less={t.competitions.less}>
            <span data-label>{t.competitions.more}</span>
            <Icon name="lucide:chevrons-down" class="comp-more__icon" />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>('[data-comp-grid]');
  const btn = document.querySelector<HTMLButtonElement>('[data-comp-more]');
  if (grid && btn) {
    // Collapse only when JS runs, so every card stays reachable without it.
    grid.classList.add('is-collapsed');
    btn.addEventListener('click', () => {
      const expand = grid.classList.contains('is-collapsed');
      grid.classList.toggle('is-collapsed', !expand);
      btn.setAttribute('aria-expanded', String(expand));
      btn.querySelector('[data-label]')!.textContent = (expand ? btn.dataset.less : btn.dataset.more) ?? '';
      // Newly shown cards are revealed by the global IntersectionObserver.
      if (!expand) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>

<style>
  .comp__art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 70% at 30% 30%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%),
      radial-gradient(50% 60% at 80% 80%, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 70%),
      var(--surface-2);
  }
  .comp__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(closest-side, #000, transparent);
    animation: drift 18s linear infinite;
  }
  @keyframes drift {
    to {
      background-position: 28px 28px;
    }
  }
  .comp__art > :global(svg) {
    width: 72px;
    height: 72px;
    color: var(--accent);
    filter: drop-shadow(0 8px 24px color-mix(in srgb, var(--accent) 45%, transparent));
  }
  .comp__achievement {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--gold-soft);
    color: var(--gold);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .comp__achievement :global(svg) {
    width: 16px;
    height: 16px;
  }
  @media (prefers-reduced-motion: reduce) {
    .comp__grid {
      animation: none;
    }
  }
  .comp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .comp-grid:global(.is-collapsed) [data-extra] {
    display: none;
  }
  .comp {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.4s;
  }
  .comp:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-strong);
  }
  .comp__body {
    display: grid;
    gap: 0.65rem;
    justify-items: start;
    padding: 1.4rem 1.5rem 1.5rem;
    flex: 1;
    align-content: start;
  }
  .comp__title {
    font-size: 1.3rem;
  }
  .comp__desc {
    color: var(--text-2);
    font-size: 0.97rem;
  }
  .comp__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }
  .comp__link {
  }
  .comp__link :global(svg:last-child) {
    width: 0.9em;
    transition: transform 0.25s var(--ease-out);
  }
  .comp__link:hover :global(svg:last-child) {
    transform: translate(2px, -2px);
  }
  .comp-more {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .comp-more :global(.comp-more__icon) {
    transition: transform 0.35s var(--ease-out);
  }
  .comp-more [aria-expanded='true'] :global(.comp-more__icon) {
    transform: rotate(180deg);
  }
  @media (max-width: 800px) {
    .comp-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

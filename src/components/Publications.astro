---
import { getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import RestorationDemo from './RestorationDemo.astro';
import { formatStars, starsFor } from '@/lib/github';
import { ui, type Locale } from '@/i18n/ui';
import { asset } from '@/lib/assets';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const stars = new Map(await Promise.all(pubs.map(async (p) => [p.id, await starsFor(p.data.links.code)] as const)));

const certificates = new Map<string, string>();
for (const p of pubs) {
  if (p.data.extraImage) {
    const img = await getImage({ src: asset(p.data.extraImage.src), width: 1600, format: 'webp', quality: 80 });
    certificates.set(p.id, img.src);
  }
}
---

<section class="section" id="publications">
  <div class="container">
    <SectionHead index={3} title={t.headings.publications} />
    <ol class="pubs">
      {
        pubs.map(({ id, data }, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <article class:list={['card spotlight pub', { 'pub--award': data.award }]}>
              <div class="pub__media">
                {data.media ? (
                  <a href={data.links.code ?? data.links.paper} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <img src={data.media} alt="" width="480" height="330" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <div class="pub__placeholder" aria-hidden="true">
                    <span>{data.venueShort}</span>
                  </div>
                )}
              </div>

              <div class="pub__body">
                <div class="pub__meta">
                  <span class="badge">{data.venueShort}</span>
                  {data.award && (
                    <span class="badge badge--gold">
                      <Icon name="lucide:award" />
                      {t.publications.award}
                    </span>
                  )}
                </div>
                <h3 class="pub__title">
                  <a href={data.links.paper} target="_blank" rel="noopener">
                    {data.title[lang]}
                  </a>
                </h3>
                <p class="pub__venue">{data.venue[lang]}</p>

                <details class="pub__abstract" data-pub={id}>
                  <summary>
                    <Icon name="lucide:file-text" />
                    {t.publications.abstract}
                    <Icon name="lucide:chevron-right" class="pub__chev" />
                  </summary>
                  <div class="pub__abstract-body prose" set:html={data.abstract[lang]} />
                </details>

                <div class="pub__actions">
                  <a class="btn btn--sm btn--primary" href={data.links.paper} target="_blank" rel="noopener">
                    <Icon name="lucide:file-text" />
                    {t.publications.paper}
                  </a>
                  {data.links.arxiv && (
                    <a class="btn btn--sm" href={data.links.arxiv} target="_blank" rel="noopener">
                      <Icon name="lucide:book-open" />
                      arXiv
                    </a>
                  )}
                  {data.links.code && (
                    <a class="btn btn--sm" href={data.links.code} target="_blank" rel="noopener">
                      <Icon name="mdi:github" />
                      {t.publications.code}
                      {stars.get(id) !== undefined && (
                    <span class="stars" aria-label={t.github.stars(stars.get(id)!)} title={t.github.stars(stars.get(id)!)}>
                      <Icon name="lucide:star" />
                      {formatStars(stars.get(id)!)}
                    </span>
                  )}
                    </a>
                  )}
                  {data.links.video && (
                    <a class="btn btn--sm" href={`https://www.youtube.com/watch?v=${data.links.video}`} data-video={data.links.video} data-title={data.title[lang]}>
                      <Icon name="lucide:play" />
                      {t.publications.video}
                    </a>
                  )}
                  {certificates.has(id) && (
                    <a class="btn btn--sm" href={certificates.get(id)} data-image={certificates.get(id)} data-title={t.publications.certificate}>
                      <Icon name="lucide:award" />
                      {t.publications.certificate}
                    </a>
                  )}
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
    <RestorationDemo {lang} />
  </div>
</section>

<style>
  .pubs {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pub {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    padding: clamp(1rem, 2.4vw, 1.4rem);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.4s;
  }
  .pub:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .pub--award {
    border-color: color-mix(in srgb, var(--gold) 35%, var(--border));
  }
  .pub__media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    align-self: start;
  }
  .pub__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .pub:hover .pub__media img {
    transform: scale(1.04);
  }
  .pub__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 80% at 20% 20%, color-mix(in srgb, var(--accent) 35%, transparent), transparent),
      radial-gradient(60% 80% at 80% 90%, color-mix(in srgb, var(--accent-2) 35%, transparent), transparent),
      var(--surface-2);
  }
  .pub__placeholder span {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    opacity: 0.85;
  }
  .pub__body {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    min-width: 0;
  }
  .pub__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pub__meta :global(svg) {
    width: 14px;
    height: 14px;
  }
  .pub__title {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.3;
  }
  .pub__title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.4s var(--ease-out),
      color 0.2s;
  }
  .pub__title a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }
  .pub__venue {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .pub__abstract summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    color: var(--text-2);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.2rem 0;
  }
  .pub__abstract summary::-webkit-details-marker {
    display: none;
  }
  .pub__abstract summary :global(svg) {
    width: 16px;
    height: 16px;
  }
  .pub__abstract summary :global(.pub__chev) {
    transition: transform 0.3s var(--ease-out);
  }
  .pub__abstract[open] summary :global(.pub__chev) {
    transform: rotate(90deg);
  }
  .pub__abstract::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }
  .pub__abstract[open]::details-content {
    block-size: auto;
  }
  .pub__abstract-body {
    padding: 0.6rem 0 0.2rem;
    color: var(--text-2);
    font-size: 0.93rem;
    line-height: 1.75;
  }
  .pub__abstract-body :global(b) {
    color: var(--text);
  }

  .pub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }
  @media (max-width: 760px) {
    .pub {
      grid-template-columns: 1fr;
    }
  }
</style>

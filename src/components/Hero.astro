---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import bg from '@/assets/hero/1.webp';
import figure from '@/assets/hero/3.webp';
import { ui, type Locale } from '@/i18n/ui';
import { site } from '@/lib/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang].hero;
const pp = t.pipe;

/** Seamless sine path spanning two periods of the viewBox so it can loop via translateX. */
function wave(width: number, amp: number, len: number, y: number) {
  let d = `M0 ${y}`;
  for (let x = 0; x <= width * 2; x += len / 2) {
    const dir = (x / (len / 2)) % 2 === 0 ? -1 : 1;
    d += ` Q${x + len / 4} ${y + dir * amp} ${x + len / 2} ${y}`;
  }
  return d;
}
const words = t.name.split(' ');

/*
 * Hand-labelled oriented boxes on hero/3.webp, in the image's own pixel space (682 x 720).
 * cx/cy = box centre, w/h = size in the object's upright frame,
 * a = orientation in degrees, 0-359 clockwise; an upright (axis-aligned) box is 0.
 */
const W = figure.width;
const H = figure.height;
const sx = W / 682;
const sy = H / 720;
/*
 * The blister card sits right of the photo's centre (its title box is centred at x=393
 * of 682). Show the photo cropped on the left so the card is centred; boxes keep using
 * the photo's own pixel space via the SVG viewBox offset.
 */
const CROP_L = (393 * 2 - 682) * sx;
const VW = W - CROP_L;
const dets = [
  { cls: 'text', score: 0.99, cx: 393, cy: 154, w: 250, h: 92, a: 0, color: '#4ade80' },
  { cls: 'cup', score: 0.95, cx: 531, cy: 296, w: 72, h: 48, a: 0, color: '#f4c55a' },
  { cls: 'cup', score: 0.91, cx: 533, cy: 347, w: 72, h: 52, a: 0, color: '#f4c55a' },
  { cls: 'person', score: 0.97, cx: 331, cy: 454, w: 178, h: 404, a: 0, color: '#5cc6ff' },
  { cls: 'playing_card', score: 0.92, cx: 528, cy: 450, w: 62, h: 86, a: 0, color: '#f87171' },
  { cls: 'cup', score: 0.88, cx: 267, cy: 467, w: 40, h: 46, a: 0, color: '#f4c55a' },
  // Neck points up-right: the upright guitar rotated 43 degrees clockwise.
  { cls: 'guitar', score: 0.89, cx: 535, cy: 563.5, w: 58, h: 124, a: 43, color: '#a78bfa' },
]
  .map((d) => ({ ...d, cx: d.cx * sx, cy: d.cy * sy, w: d.w * sx, h: d.h * sy }))
  .map((d) => {
    // Half extents of the rotated box's axis-aligned bounds.
    const r = (d.a * Math.PI) / 180;
    const hw = (Math.abs(d.w * Math.cos(r)) + Math.abs(d.h * Math.sin(r))) / 2;
    const hh = (Math.abs(d.w * Math.sin(r)) + Math.abs(d.h * Math.cos(r))) / 2;
    return { ...d, name: pp.cls[d.cls as keyof typeof pp.cls], hw, hh };
  });
// Scan order = top of each box's bounds, so boxes appear as the scan line reaches them.
const order = dets.map((d) => (d.cy - d.hh) / H);

/* Tiny fully connected network: one input per detection -> 5 -> 5 -> outputs. */
const NW = 560;
const NH = 150;
const layers = [dets.length, 5, 5, pp.classes.length];
const LABEL_W = 190; // space right of the output layer for "0.94 AI R&D Engineer"
const lx = layers.map((_, i) => 24 + (i * (NW - 24 - LABEL_W - 24)) / (layers.length - 1));
const ly = (n: number) => Array.from({ length: n }, (_, j) => (NH * (j + 1)) / (n + 1));
const nodes = layers.map((n, i) => ly(n).map((y) => ({ x: lx[i], y })));
const edges = nodes.slice(0, -1).map((from, i) => from.flatMap((a) => nodes[i + 1].map((b) => ({ a, b }))));
const label = (d: (typeof dets)[number]) => `${d.name} ${d.score.toFixed(2)} · ${d.a}°`;
/* Tags sit above each box's bounds and are kept inside the image. CJK glyphs are ~full width. */
const TAG_H = 27;
const textWidth = (str: string) => [...str].reduce((w, ch) => w + (ch.codePointAt(0)! > 0x2e80 ? 21 : 12.6), 0);
const tags = dets.map((d) => {
  const w = textWidth(label(d)) + 14;
  const x = Math.min(Math.max(CROP_L, d.cx - d.hw), W - w);
  const top = d.cy - d.hh - TAG_H - 4;
  return { x, y: top < 0 ? d.cy - d.hh + 4 : top, w };
});
---

<section class="hero" id="home" aria-label="Intro" data-hero>
  <div class="hero__stage">
    <div class="hero__bg" aria-hidden="true">
      <Image src={bg} alt="" widths={[960, 1600, 2400]} sizes="100vw" quality={70} loading="eager" fetchpriority="high" />
      <div class="hero__shade"></div>
    </div>

    <div class="hero__grid container">
      <div class="hero__content">
        <p class="hero__eyebrow">{t.position}</p>

        <h1 class="hero__title">
          {
            words.map((w, i) => (
              <>
                <span class="word" style={`--w:${i}`}>
                  {w}
                </span>{' '}
              </>
            ))
          }
        </h1>

        <p class="hero__rotator" data-rotator aria-live="polite">
          {t.rotate.map((r, i) => <span class:list={['rot', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>{r}</span>)}
        </p>

        <div class="hero__taglines">
          {t.taglines.map((line) => <p>{line}</p>)}
        </div>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#competitions">
            <Icon name="lucide:trophy" />
            {t.competitions}
          </a>
          <a class="btn btn--glass" href={site.github} target="_blank" rel="noopener">
            <Icon name="mdi:github" />
            {t.github}
          </a>
          <a class="btn btn--glass" href={site.linkedin.url} target="_blank" rel="noopener">
            <Icon name="mdi:linkedin" />
            {t.linkedin}
          </a>
        </div>

      </div>

      <!-- Inference pipeline: scroll drives detection (stage 1) then classification (stage 2). -->
      <figure class="pipe" data-pipe style="--scan: 0; --net: 0" aria-label={pp.aria}>
        <header class="pipe__hud">
          <span class="pipe__dot" aria-hidden="true"></span>
          <span class="pipe__status" data-status data-ready={pp.ready} data-detect={pp.detecting} data-classify={pp.classifying} data-done={pp.done}>{pp.ready}</span>
          <span class="pipe__stats">
            <span>{pp.objects} <b data-count>0</b></span>
            <span>{pp.latency} <b data-ms>–</b></span>
          </span>
        </header>

        <div class="pipe__row">
          <div class="pipe__view" style={`aspect-ratio: ${VW.toFixed(1)} / ${H}`}>
            <Image src={figure} alt={pp.alt} widths={[360, 540, 720]} sizes="(min-width: 900px) 340px, 60vw" quality={78} loading="eager" />
            <div class="pipe__scanned" aria-hidden="true"></div>
            <div class="pipe__scan" aria-hidden="true"></div>
            <svg class="pipe__boxes" viewBox={`${CROP_L.toFixed(1)} 0 ${VW.toFixed(1)} ${H}`} aria-hidden="true">
              {
                dets.map((d, i) => (
                  <g class="det" data-det={i} data-at={order[i].toFixed(3)} style={`--c:${d.color}`}>
                    <rect class="det__box" x={-d.w / 2} y={-d.h / 2} width={d.w} height={d.h} rx="3" pathLength="1" transform={`translate(${d.cx} ${d.cy}) rotate(${d.a})`} />
                    <g class="det__tag" transform={`translate(${tags[i].x} ${tags[i].y})`}>
                      <rect x="0" y="0" width={tags[i].w} height={TAG_H} rx="4" />
                      <text x="7" y={TAG_H - 8}>
                        {label(d)}
                      </text>
                    </g>
                  </g>
                ))
              }
            </svg>
          </div>

          <ol class="pipe__log" aria-label={pp.detections}>
            {
              dets.map((d, i) => (
                <li data-log={i} style={`--c:${d.color}`}>
                  <span class="pipe__swatch" aria-hidden="true"></span>
                  <span class="pipe__cls">{d.name}</span>
                  <span class="pipe__score">{d.score.toFixed(2)}</span>
                  <span class="pipe__angle">{d.a}°</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="pipe__stage2">
          <div class="pipe__stage2-inner">
        <svg class="pipe__net" viewBox={`0 0 ${NW} ${NH}`} aria-hidden="true">
          {
            edges.map((group, i) => (
              <g class="net__edges" data-layer={i + 1}>
                {group.map((e) => (
                  <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />
                ))}
              </g>
            ))
          }
          {
            nodes.map((col, i) => (
              <g class="net__nodes" data-layer={i}>
                {col.map((n, j) => (
                  <circle cx={n.x} cy={n.y} r={i === 0 ? 6 : 5} style={i === 0 ? `--c:${dets[j].color}` : undefined} data-in={i === 0 ? j : undefined} />
                ))}
              </g>
            ))
          }
          <g class="net__labels">
            {
              nodes[nodes.length - 1].map((n, i) => (
                <text class:list={{ 'is-top': i === 0 }} x={n.x + 14} y={n.y} data-olabel={i}>
                  <tspan class="net__prob" data-oprob>
                    0.00
                  </tspan>
                  <tspan dx="8">{pp.classes[i]}</tspan>
                </text>
              ))
            }
          </g>
        </svg>

        <ol class="pipe__out" aria-label={pp.output}>
          {
            pp.classes.map((c, i) => (
              <li class:list={{ 'is-top': i === 0 }} data-out={pp.probs[i]}>
                <span class="pipe__label">{c}</span>
                <span class="pipe__bar"><span></span></span>
                <span class="pipe__prob" data-prob>0.00</span>
              </li>
            ))
          }
        </ol>
          </div>
        </div>

        <p class="pipe__hint" aria-hidden="true">
          <Icon name="lucide:mouse" />
          {pp.hint}
        </p>
      </figure>
    </div>

    <svg class="hero__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="w w1" d={wave(1440, 18, 240, 60)}></path>
      <path class="w w2" d={wave(1440, 10, 180, 66)}></path>
      <path class="w w3" d={wave(1440, 26, 360, 56)}></path>
    </svg>

    <a class="hero__scroll" href="#about" aria-label={t.scroll}>
      <span>{t.scroll}</span>
      <Icon name="lucide:arrow-down" />
    </a>
  </div>
</section>

<script>
  // ---- Rotating subtitle
  const root = document.querySelector<HTMLElement>('[data-rotator]');
  const items = root ? Array.from(root.querySelectorAll<HTMLElement>('.rot')) : [];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (items.length > 1 && !reduce) {
    let i = 0;
    setInterval(() => {
      items[i].classList.remove('is-active');
      items[i].setAttribute('aria-hidden', 'true');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
      items[i].removeAttribute('aria-hidden');
    }, 3600);
  }

  // ---- Scroll-driven inference pipeline
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const pipe = hero.querySelector<HTMLElement>('[data-pipe]')!;
  const dets = Array.from(pipe.querySelectorAll<SVGGElement>('[data-det]'));
  const logs = Array.from(pipe.querySelectorAll<HTMLElement>('[data-log]'));
  const inputs = Array.from(pipe.querySelectorAll<SVGCircleElement>('[data-in]'));
  const edgeLayers = Array.from(pipe.querySelectorAll<SVGGElement>('.net__edges'));
  const nodeLayers = Array.from(pipe.querySelectorAll<SVGGElement>('.net__nodes'));
  const outs = Array.from(pipe.querySelectorAll<HTMLElement>('[data-out]'));
  const oLabels = Array.from(pipe.querySelectorAll<SVGTextElement>('[data-olabel]'));
  const status = pipe.querySelector<HTMLElement>('[data-status]')!;
  const count = pipe.querySelector<HTMLElement>('[data-count]')!;
  const ms = pipe.querySelector<HTMLElement>('[data-ms]')!;
  const pinned = matchMedia('(min-width: 900px)');

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const ease = (x: number) => 1 - Math.pow(1 - x, 3);

  /** 0..1 progress. Desktop: through the pinned hero. Mobile: as the panel crosses the viewport. */
  function progress() {
    if (reduce) return 1;
    const vh = innerHeight;
    if (pinned.matches) {
      const r = hero.getBoundingClientRect();
      return clamp(-r.top / Math.max(1, r.height - vh));
    }
    const r = pipe.getBoundingClientRect();
    return clamp((vh * 0.92 - r.top) / (r.height + vh * 0.25));
  }

  let last = -1;
  function render() {
    const p = progress();
    if (Math.abs(p - last) < 0.0005) return;
    last = p;
    const scan = seg(p, 0.04, 0.5);
    const net = seg(p, 0.52, 0.94);
    pipe.style.setProperty('--scan', scan.toFixed(4));
    pipe.style.setProperty('--net', net.toFixed(4));
    pipe.classList.toggle('is-scanning', scan > 0 && scan < 1);
    pipe.classList.toggle('is-started', p > 0.02);

    // Stage 1: boxes, log rows and input nodes switch on as the scan line passes them.
    let found = 0;
    dets.forEach((d, i) => {
      const on = scan >= Number(d.dataset.at) + 0.02;
      if (on) found++;
      d.classList.toggle('is-on', on);
      logs[i]?.classList.toggle('is-on', on);
      inputs[i]?.classList.toggle('is-on', on);
    });
    count.textContent = String(found);
    pipe.classList.toggle('has-dets', found > 0);
    pipe.classList.toggle('is-classify', net > 0);
    ms.textContent = scan > 0 ? `${Math.round(6 + scan * 17 + net * 4)} ms` : '–';

    // Stage 2: light layers in turn, then fill the softmax.
    edgeLayers.forEach((g, i) => g.classList.toggle('is-on', net > 0.08 + i * 0.24));
    nodeLayers.forEach((g, i) => i > 0 && g.classList.toggle('is-on', net > 0.2 + (i - 1) * 0.24));
    const fill = ease(seg(net, 0.72, 1));
    // Output labels next to the last layer appear one by one as the softmax fills.
    oLabels.forEach((l, i) => {
      l.classList.toggle('is-on', net > 0.7 + i * 0.06);
      l.querySelector('[data-oprob]')!.textContent = (Number(outs[i].dataset.out) * fill).toFixed(2);
    });
    outs.forEach((o) => {
      const v = Number(o.dataset.out) * fill;
      o.style.setProperty('--v', v.toFixed(4));
      o.querySelector('[data-prob]')!.textContent = v.toFixed(2);
    });
    pipe.classList.toggle('is-done', net >= 1);

    status.textContent = (net >= 1 ? status.dataset.done : net > 0 ? status.dataset.classify : scan > 0 ? status.dataset.detect : status.dataset.ready) ?? '';
  }

  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      render();
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', () => {
    last = -1;
    onScroll();
  });
  pinned.addEventListener('change', () => {
    last = -1;
    onScroll();
  });
  render();
</script>

<style>
  .hero {
    position: relative;
    color: var(--hero-ink);
    background: #03060d;
    isolation: isolate;
  }
  .hero__stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }
  /* Desktop: pin the stage while the extra scroll height runs the pipeline. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .hero {
      height: 240svh;
    }
    .hero__stage {
      position: sticky;
      top: 0;
      height: 100svh;
    }
  }

  /* ---- Background: one slow Ken Burns plate */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: kenburns 30s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1.16) translate3d(-1.5%, -1%, 0);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 15% 40%, rgb(3 6 13 / 0.5), rgb(3 6 13 / 0.9) 75%),
      linear-gradient(180deg, rgb(3 6 13 / 0.55) 0%, transparent 30%, rgb(3 6 13 / 0.6) 85%, var(--bg) 100%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-block: calc(var(--nav-h) + 1.5rem) 6.5rem;
  }

  /* ---- Text */
  .hero__content {
    display: grid;
    gap: 1.1rem;
    min-width: 0;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(10px);
    font-size: 0.88rem;
    font-weight: 500;
    animation: rise 0.9s 0.1s var(--ease-out) both;
  }
  .hero__title {
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .word {
    display: inline-block;
    animation: word 1s calc(0.25s + var(--w) * 0.09s) var(--ease-out) both;
  }
  @keyframes word {
    from {
      opacity: 0;
      transform: translateY(0.45em) rotate(4deg);
      filter: blur(10px);
    }
  }
  .hero__rotator {
    display: grid;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    min-height: 1.3em;
    animation: rise 0.9s 0.6s var(--ease-out) both;
  }
  .rot {
    grid-area: 1 / 1;
    width: fit-content;
    background: linear-gradient(90deg, #7dd3fc, #c4b5fd 60%, #f0abfc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0;
    transform: translateY(0.6em);
    filter: blur(8px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out),
      filter 0.7s var(--ease-out);
  }
  .rot.is-active {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .hero__taglines {
    display: grid;
    gap: 0.2rem;
    max-width: 36rem;
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    color: rgb(255 255 255 / 0.82);
    animation: rise 0.9s 0.75s var(--ease-out) both;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.3rem;
    animation: rise 0.9s 0.9s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  /* ---- Inference panel (always dark: it sits on the dark hero in both themes) */
  .pipe {
    --line: rgb(255 255 255 / 0.12);
    --dim: rgb(255 255 255 / 0.55);
    position: relative;
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    margin: 0;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgb(7 11 22 / 0.72);
    backdrop-filter: blur(14px);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: rgb(255 255 255 / 0.85);
    animation: rise 1s 0.5s var(--ease-out) both;
  }
  .pipe__hud {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .pipe__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px #4ade80;
  }
  .pipe.is-scanning .pipe__dot,
  .pipe:not(.is-done).is-started .pipe__dot {
    background: #f4c55a;
    box-shadow: 0 0 10px #f4c55a;
    animation: blink 0.8s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .pipe__status {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pipe__stats {
    display: flex;
    gap: 0.9rem;
    margin-left: auto;
    color: var(--dim);
  }
  .pipe__stats b {
    color: #fff;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Image starts centred; the log column opens beside it as detections arrive. */
  .pipe__row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .pipe__view {
    flex: none;
  }
  .pipe__view {
    position: relative;
    height: clamp(200px, 32svh, 330px);
    overflow: hidden;
    border-radius: 10px;
    background: #e8e4df;
  }
  .pipe__view > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* Cropped on the left only (see CROP_L), so the card is centred. */
    object-fit: cover;
    object-position: 100% 50%;
  }
  /* Region already scanned gets a faint grid tint; the scan line sits at its edge. */
  .pipe__scanned {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--scan) * 100%);
    background:
      linear-gradient(rgb(92 198 255 / 0.08), rgb(92 198 255 / 0.08)),
      repeating-linear-gradient(0deg, rgb(92 198 255 / 0.12) 0 1px, transparent 1px 14px),
      repeating-linear-gradient(90deg, rgb(92 198 255 / 0.12) 0 1px, transparent 1px 14px);
    pointer-events: none;
  }
  .pipe__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--scan) * 100%);
    height: 2px;
    background: #5cc6ff;
    box-shadow:
      0 0 12px 2px rgb(92 198 255 / 0.8),

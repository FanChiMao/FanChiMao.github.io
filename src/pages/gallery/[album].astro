---
// Moved: albums live under /personal/gallery/ now.
import { getCollection } from 'astro:content';
import Redirect from '@/components/Redirect.astro';

export async function getStaticPaths() {
  const albums = await getCollection('albums', ({ data }) => !data.draft);
  return albums.map((album) => ({ params: { album: album.id } }));
}
---

<Redirect to={`/personal/gallery/${Astro.params.album}/`} />

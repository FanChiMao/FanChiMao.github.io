---
/**
 * Private admin page (52hzfan.com/admin/), behind Cloudflare Access: site stats and adding
 * albums, Journey milestones and Ajie posts, which the site-admin Worker commits to main. The page
 * itself holds no secrets; every action goes through /api/admin/* (see workers/site-admin).
 */
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { personalUi } from '@/i18n/personal';
import { asset } from '@/lib/assets';
import { clipUrl, isMedia, photoUrl } from '@/lib/media';

const ui = personalUi['zh-tw'];
const pick = (v: string | Record<string, string> | undefined) => (v == null ? undefined : typeof v === 'string' ? v : v['zh-tw']);
const posts = await getCollection('ajie');
const albums = await getCollection('albums');
const EXAMPLES = {
  album: JSON.stringify({ id: 'taipei_night', emoji: '🌃', categories: ['city'], title: { en: '…', 'zh-tw': '…', 'zh-cn': '…', ja: '…' }, photos: [{ src: 'dsc-0012.jpg' }] }, null, 2),
  ajie: JSON.stringify({ id: '2025-11-02-new-toy', date: '2025-11-02', media: [{ type: 'image', src: 'img-1234.jpg' }], caption: '…' }, null, 2),
  journey: JSON.stringify({ id: '2026-01-11-first-half-marathon', date: '2026-01-11', category: 'run', title: '…', story: '…' }, null, 2),
};
const names = {
  badges: Object.fromEntries(Object.entries(ui.passport.items).map(([id, it]) => [id, (it as { name: string }).name])),
  posts: Object.fromEntries(posts.map((p) => [p.id, `${p.id.slice(5, 10).replace('-', '/')} ${pick(p.data.title) ?? ''}`.trim()])),
  /** Album IDs already in the repo (adding only), and the order a new album gets by default. */
  albums: albums.map((a) => a.id),
  nextAlbumOrder: Math.max(-1, ...albums.map((a) => a.data.order)) + 1,
};
const FORMS = {
  album: { title: '新增相簿', files: '1. 上傳照片', accept: 'image/*', note: '照片縮到長邊 2400 px、去除 GPS；拍攝日期與相機參數會自動讀出並寫進 JSON。右邊的檔名就是 JSON 裡要寫的名字（點一下複製），按住 ⠿ 拖曳排序。' },
  journey: { title: '新增旅程里程碑', files: '1. 上傳照片與影片（選填）', accept: 'image/*,video/*', note: '' },
  ajie: { title: '新增阿桔貼文', files: '1. 上傳照片與影片', accept: 'image/*,video/*', note: '' },
} as const;
/**
 * Ajie posts as Instagram would get them: big JPEGs of every slide (AI cover first) and the clips,
 * all on R2 (the bucket allows this page to read them, for the 4:5 re-framing); older photos still
 * under src/assets are made here.
 */
const jpg = async (src: string) => (isMedia(src) ? photoUrl(src) : (await getImage({ src: asset(src), width: 1440, format: 'jpg', quality: 90 })).src);
const thumb = async (src: string) => (isMedia(src) ? photoUrl(src, 480) : jpg(src));
const igPosts = await Promise.all(
  posts
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.localeCompare(a.data.date))
    .map(async (p) => {
      const slides: { type: 'image' | 'video'; src: string; thumb: string; ai?: boolean }[] = [];
      if (p.data.cover) {
        slides.push({ type: 'image', src: await jpg(p.data.cover.src), thumb: await thumb(p.data.cover.src), ai: true });
      }
      for (const m of p.data.media) {
        if (m.type === 'image') {
          slides.push({ type: 'image', src: await jpg(m.src), thumb: await thumb(m.src) });
        } else if (m.type === 'video') slides.push({ type: 'video', src: clipUrl(m.src), thumb: await thumb(m.poster) });
      }
      return { id: p.id, date: p.data.date, from: p.data.from, title: pick(p.data.title) ?? '', caption: pick(p.data.caption) ?? '', place: pick(p.data.location) ?? '', slides };
    }),
);
const MEDIA_NOTE = '照片縮到長邊 2400 px 並去除 EXIF / GPS（阿桔、旅程的照片連同縮圖一起放 R2，相簿照片進 git）；影片重新壓縮成 720p MP4（同時去除位置資訊），並自動產生「檔名-poster.jpg」封面。右邊的檔名就是 JSON 裡要寫的名字（點一下複製），按住 ⠿ 拖曳排序。';
---

<!doctype html>
<html lang="zh-Hant-TW" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>管理 · 52Hz</title>
    <link rel="icon" href="/icon.png" />
  </head>
  <body class="admin">
    <script type="application/json" id="admin-data" set:html={JSON.stringify(names)} />
    <script type="application/json" id="ig-data" set:html={JSON.stringify(igPosts)} />

    <header class="top">
      <div class="top__brand"><strong>52Hz 管理</strong><span id="who" class="muted">確認登入中…</span></div>
      <a class="top__site muted small" href="/zh-tw/" target="_blank" rel="noopener">開啟網站 ↗</a>
    </header>

    <div id="gate" class="gate" hidden>
      <h1>無法進入後台</h1>
      <p id="gate-msg"></p>
      <p class="muted">這個頁面只開放給網站管理者，透過 Cloudflare Access 登入。</p>
    </div>

    <div class="shell">
      <!-- Desktop: Cloudflare-style sidebar in groups. Phones: a tab bar fixed at the bottom (thumb reach). -->
      <nav class="side" aria-label="管理選單">
        <div class="side__group">
          <span class="side__label">網頁</span>
          <button type="button" data-tab="stats"><span aria-hidden="true">▦</span><span class="side__text">統計資料</span><span class="side__short">統計</span></button>
          <button type="button" data-tab="deploys"><span aria-hidden="true">⟳</span><span class="side__text">網站部署</span><span class="side__short">部署</span><span class="side__status" id="deploy-latest"></span></button>
          <button type="button" data-tab="ig"><span aria-hidden="true">◎</span><span class="side__text">發到 IG</span><span class="side__short">IG</span></button>
        </div>
        <div class="side__group side__add">
          <span class="side__label">內容</span>
          <button type="button" class="side__menu-btn" aria-expanded="false" aria-controls="add-menu">
            <span aria-hidden="true">✚</span><span class="side__text">新增資料</span><span class="side__short">新增</span><span class="side__caret" aria-hidden="true">▾</span>
          </button>
          <div class="side__menu" id="add-menu" hidden>
            <button type="button" data-tab="album"><span aria-hidden="true">▣</span>新增相簿</button>
            <button type="button" data-tab="journey"><span aria-hidden="true">⚑</span>新增旅程</button>
            <button type="button" data-tab="ajie"><span aria-hidden="true">♡</span>新增阿桔貼文</button>
          </div>
        </div>
      </nav>

    <!-- Phones: a floating glass tab bar with three tabs; 發布 and 新增 open a small menu. -->
    <nav class="tabbar" aria-label="管理選單">
      <span class="tabbar__glass" aria-hidden="true"></span>
      <div class="tabbar__item">
        <button type="button" class="tabbar__btn" data-tab="stats" data-tabbar-group="stats"><span class="tabbar__icon" aria-hidden="true">▦</span>統計</button>
      </div>
      <div class="tabbar__item">
        <button type="button" class="tabbar__btn" data-tabbar-group="publish" data-tabbar-menu aria-expanded="false" aria-controls="tb-publish">
          <span class="tabbar__icon" aria-hidden="true">⇪</span>發布<span class="tabbar__dot" id="tb-deploy"></span>
        </button>
        <div class="tabbar__menu" id="tb-publish" hidden>
          <button type="button" data-tab="deploys"><span aria-hidden="true">⟳</span>網站部署</button>
          <button type="button" data-tab="ig"><span aria-hidden="true">◎</span>發到 IG</button>
        </div>
      </div>
      <div class="tabbar__item">
        <button type="button" class="tabbar__btn" data-tabbar-group="add" data-tabbar-menu aria-expanded="false" aria-controls="tb-add"><span class="tabbar__icon" aria-hidden="true">✚</span>新增</button>
        <div class="tabbar__menu tabbar__menu--end" id="tb-add" hidden>
          <button type="button" data-tab="ajie"><span aria-hidden="true">♡</span>新增阿桔貼文</button>
          <button type="button" data-tab="journey"><span aria-hidden="true">⚑</span>新增旅程</button>
          <button type="button" data-tab="album"><span aria-hidden="true">▣</span>新增相簿</button>
        </div>
      </div>
    </nav>

    <main class="wrap">
      <section data-panel="deploys" class="panel" hidden>
        <div class="panel__head">
          <h1>網站部署</h1>
          <button type="button" id="deploys-refresh" class="ghost">重新整理</button>
          <button type="button" id="redeploy" class="ghost">重新部署</button>
        </div>
        <div class="card">
          <ul id="deploys" class="deploys__list"><li class="muted">載入中…</li></ul>
        </div>
        <p class="muted small">新增內容會直接 commit 到 main，GitHub Actions 自動重建網站（約 2–4 分鐘）。「重新部署」不需要新的 commit，用在部署失敗修好之後，或想重新抓 GitHub 資料時。</p>
      </section>

      <section data-panel="ig" class="panel" hidden>
        <div class="panel__head">
          <h1>發到 IG</h1>
          <span id="ig-account" class="muted small">確認帳號中…</span>
        </div>
        <form class="post card ig" id="ig-form">
          <fieldset class="block">
            <legend>1. 選一篇阿桔貼文</legend>
            <select id="ig-post"></select>
            <p class="small good" id="ig-posted"></p>
            <p class="muted small">只列出網站上已經發布的貼文（新貼文要等網站部署完成）。還沒發過的排前面、舊的在上；已發過的標 ✓。</p>
          </fieldset>
          <fieldset class="block">
            <legend>2. 照片與影片 <span id="ig-count" class="muted small"></span></legend>
            <div class="row ig__frame">
              <span class="muted small">照片統一轉成 4:5：</span>
              <label><input type="radio" name="ig-frame" value="pad" checked /> 補邊（模糊背景，完整保留畫面）</label>
              <label><input type="radio" name="ig-frame" value="crop" /> 裁切置中</label>
            </div>
            <ul id="ig-slides" class="ig__slides"></ul>
            <p class="muted small">取消勾選就不放進 IG；最多 10 個。影片若被 IG 拒絕（例如比例不支援），取消勾選它再發一次即可，失敗時不會發出任何東西。</p>
          </fieldset>
          <fieldset class="block">
            <legend>3. IG 文案 <span id="ig-chars" class="muted small"></span></legend>
            <textarea id="ig-caption" rows="12" autocapitalize="off"></textarea>
            <button type="button" class="ghost" id="ig-reset-caption">重新產生文案</button>
          </fieldset>
          <div class="dock">
            <div id="ig-progress"></div>
            <div class="dock__buttons">
              <button type="submit" class="primary" id="ig-publish">發到 IG</button>
              <button type="button" class="ghost" id="ig-cancel" hidden>取消</button>
            </div>
          </div>
        </form>
      </section>

      <section data-panel="stats" id="stats" class="panel">
        <div class="panel__head">
          <h1>網站統計</h1>
          <span id="stats-asof" class="muted small"></span>
          <button type="button" id="stats-refresh" class="ghost">重新整理</button>
        </div>
        <p id="stats-error" class="error" hidden></p>
        <div id="kpis" class="kpis"></div>
        <div class="viz card">
          <h2>近 30 天新探索者 <span class="muted small">每天（台灣時間）</span></h2>
          <div id="chart-explorers"></div>
        </div>
        <div class="grid2">
          <div class="viz card">
            <h2>徽章解鎖人數 <span class="muted small">括號為佔全部探索者的比例</span></h2>
            <div id="chart-badges"></div>
          </div>
          <div class="viz card">
            <h2>阿桔貼文愛心</h2>
            <div id="chart-likes"></div>
          </div>
        </div>
        <p class="muted small">「探索者」是進入過個人世界、開了匿名統計的瀏覽器（不是人數，也不是頁面瀏覽量）。訪客地圖與流量請看 Cloudflare Web Analytics / Search Console。</p>
      </section>

      {
        (['album', 'journey', 'ajie'] as const).map((kind) => (
          <section data-panel={kind} class="panel" hidden>
            <form class="post card" data-kind={kind}>
              <h1>{FORMS[kind].title}</h1>

              <fieldset class="block">
                <legend>{FORMS[kind].files}</legend>
                <p class="muted small">{FORMS[kind].note || MEDIA_NOTE}</p>
                <ul class="files" />
                <label class="button">
                  選擇檔案（可多選）
                  <input type="file" accept={FORMS[kind].accept} multiple data-add-files hidden />
                </label>
              </fieldset>

              <fieldset class="block">
                <legend>2. 貼上 JSON</legend>
                <div class="row">
                  <button type="button" class="ghost" data-copy-guide>複製格式說明（給 agent）</button>
                  <label class="button ghost">
                    或選擇 .json 檔
                    <input type="file" accept=".json,application/json" data-json-file hidden />
                  </label>
                </div>
                <div class="row json-tools">
                  <button type="button" class="ghost" data-json-paste>📋 貼上（取代）</button>
                  <button type="button" class="ghost" data-json-select>全選</button>
                  <button type="button" class="ghost" data-json-clear>清空</button>
                  <span class="muted small" data-draft-note hidden>已還原上次沒發布的草稿</span>
                </div>
                <textarea data-json rows="16" spellcheck="false" autocapitalize="off" autocorrect="off" placeholder={EXAMPLES[kind]} />
                <label class="id">
                  ID（檔名，取自 JSON 的 "id" 或 .json 檔名）
                  <input type="text" name="id" required pattern="[a-z0-9]+([_\-][a-z0-9]+)*" maxlength="80" autocomplete="off" />
                </label>
              </fieldset>

              <ul class="check" aria-live="polite" />

              <div class="dock">
                <div data-progress />
                <button type="submit" class="primary">發布</button>
              </div>
            </form>
          </section>
        ))
      }
    </main>
    </div>
    <div id="toast" class="toast" role="status" hidden></div>

    <script>
      import '@/admin/app';
    </script>
  </body>
</html>

<style is:global>
  .admin {
    --viz-1: #2a78d6;
    --viz-surface: var(--bg-elev);
    --good: #1f9d55;
    --bad: #e5484d;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    min-height: 100vh;
  }
  :root[data-theme='dark'] .admin {
    --viz-1: #3987e5;
    --good: #3ecf7a;
    --bad: #ff6b6b;
  }
  .admin h1 {
    font-size: 1.35rem;
    margin: 0;
  }
  .admin h2 {
    font-size: 1rem;
    margin: 0 0 0.9rem;
  }
  .admin .muted {
    color: var(--muted);
  }
  .admin .small {
    font-size: 0.82rem;
  }
  .admin .error,
  .admin .bad {
    color: var(--bad);
  }
  .admin .good {
    color: var(--good);
  }
  .admin a {
    color: var(--accent);
  }
  .admin button,
  .admin .button {
    font: inherit;
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--text);
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }
  .admin a.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .admin .button.primary {
    background: var(--accent);
    border-color: transparent;
    color: var(--accent-contrast);
    font-weight: 600;
  }
  .admin button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .admin button.ghost {
    background: transparent;
  }
  .admin button.primary {
    background: var(--accent);
    border-color: transparent;
    color: var(--accent-contrast);
    font-weight: 600;
    padding: 0.6rem 1.2rem;
  }
  .admin button.link {
    border: 0;
    background: none;
    color: var(--accent);
    padding: 0;
  }
  .admin input:not([type='checkbox']):not([type='file']),
  .admin textarea,
  .admin select {
    font: inherit;
    width: 100%;
    box-sizing: border-box;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.65rem;
  }
  .admin textarea {
    resize: vertical;
    line-height: 1.6;
  }
  .admin :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .admin .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem var(--gutter);
    background: var(--glass);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .top__brand {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9rem;
  }
  .top__site {
    color: var(--muted) !important;
    text-decoration: none;
  }
  .top__site:hover {
    color: var(--text) !important;
  }
  .gate {
    max-width: 36rem;
    margin: 4rem auto;
    padding: 0 var(--gutter);
  }
  .gate:not([hidden]) ~ .shell {
    display: none;
  }

  /* ---- layout: sidebar + content (desktop), tab row + content (phones) */
  .shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    min-height: calc(100vh - 3.2rem);
  }
  .side {
    position: sticky;
    top: 3.2rem;
    align-self: start;
    height: calc(100vh - 3.2rem);
    box-sizing: border-box;
    overflow-y: auto;
    padding: 1.25rem 0.75rem;
    border-right: 1px solid var(--border);
    background: var(--bg-elev);
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }
  .side__group {
    display: grid;
    gap: 0.15rem;
  }
  .side__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0 0.6rem 0.35rem;
  }
  .admin .side button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-2);
    padding: 0.5rem 0.6rem;
    position: relative;
  }
  .admin .side button > span[aria-hidden] {
    width: 1rem;
    text-align: center;
    color: var(--muted);
  }
  .admin .side button:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .admin .side button[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 600;
  }
  .admin .side button[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--accent);
  }
  .admin .side button[aria-current='page'] > span[aria-hidden] {
    color: var(--accent);
  }
  .side__status {
    margin-left: auto;
  }
  .side__caret {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--muted);
    transition: transform 0.2s var(--ease-out);
  }
  .side__menu-btn[aria-expanded='true'] .side__caret {
    transform: rotate(180deg);
  }
  .admin .side .side__menu-btn.is-active {
    color: var(--text);
  }
  .side__menu {
    display: grid;
    gap: 0.15rem;
    padding-left: 1rem;
  }
  .side__menu[hidden] {
    display: none;
  }
  .side__status .pill {
    font-size: 0.66rem;
  }

  .wrap {
    width: 100%;
    max-width: 1000px;
    box-sizing: border-box;
    padding: 1.5rem var(--gutter) 4rem;
  }
  .wrap > .panel {
    min-width: 0;
    display: grid;
    gap: 1rem;
  }
  .wrap > .panel[hidden] {
    display: none;
  }
  @media (max-width: 899px) {
    .top {
      position: static;
    }
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Phones: the groups become a tab bar fixed at the bottom, within thumb reach. */
    .wrap {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
    .side {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 6;
      height: auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      overflow: visible;
      padding: 0.3rem 0.25rem calc(0.3rem + env(safe-area-inset-bottom));
      border-right: 0;
      border-top: 1px solid var(--border-strong);
      background: var(--glass);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .side__group {
      display: contents;
    }
    .side__label,
    .side__text {
      display: none;
    }
    .admin .side button {
      flex-direction: column;
      justify-content: center;
      gap: 0.15rem;
      min-height: 3.4rem;
      padding: 0.35rem 0.1rem;
      font-size: 0.72rem;
      text-align: center;
      color: var(--muted);
    }
    .admin .side button > span[aria-hidden] {
      width: auto;
      font-size: 1.3rem;
      line-height: 1;
    }
    .admin .side button[aria-current='page'] {
      background: transparent;
      color: var(--accent);
      font-weight: 600;
    }
    .admin .side button[aria-current='page']::before {
      left: 30%;
      right: 30%;
      top: 0;
      bottom: auto;
      width: auto;
      height: 3px;
      border-radius: 0 0 3px 3px;
    }
    .side__caret {
      display: none;
    }
    .admin .side .side__menu-btn.is-active,
    .admin .side .side__menu-btn[aria-expanded='true'] {
      color: var(--accent);
      font-weight: 600;
    }
    .side__add {
      position: relative;
    }
    .side__menu {
      position: absolute;
      bottom: calc(100% + 0.6rem);
      right: 0.4rem;
      min-width: 12rem;
      padding: 0.4rem;
      gap: 0.1rem;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      background: var(--bg-elev);
      box-shadow: var(--shadow-lg);
    }
    .admin .side .side__menu button {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.7rem;
      min-height: 3rem;
      padding: 0.5rem 0.85rem;
      font-size: 0.95rem;
      color: var(--text-2);
    }
    .admin .side .side__menu button > span[aria-hidden] {
      font-size: 1.1rem;
    }
    .admin .side .side__menu button[aria-current='page'] {
      background: var(--accent-soft);
      color: var(--text);
    }
    .admin .side .side__menu button[aria-current='page']::before {
      display: none;
    }
    /* Latest deploy: a dot on the tab instead of the pill. */
    .side__status {
      position: absolute;
      top: 0.45rem;
      left: calc(50% + 0.55rem);
      margin: 0;
    }
    .side__status .pill {
      display: block;
      width: 0.55rem;
      height: 0.55rem;
      padding: 0;
      font-size: 0;
      border: 0;
      background: currentColor;
    }
    .side__status .pill::before {
      content: none;
    }
  }
  .side__short {
    display: none;
  }
  @media (max-width: 899px) {
    .side__short {
      display: inline;
    }
    .toast {
      bottom: calc(5rem + env(safe-area-inset-bottom)) !important;
    }
  }
  .card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
  }
  .card__head,
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .card__head h2 {
    margin: 0;
  }
  .panel__head {
    justify-content: flex-start;
    margin: 0;
  }
  .panel__head > button:first-of-type {
    margin-left: auto;
  }
  .deploys__list {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .deploys__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.5rem;
    align-items: center;
  }
  .deploys__list a {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-2);
  }
  .deploys__list time {
    grid-column: 2;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .pill--good::before {
    content: '✓ ';
  }
  .pill--good {
    color: var(--good);
  }
  .pill--bad::before {
    content: '✕ ';
  }
  .pill--bad {
    color: var(--bad);
  }
  .pill--running::before {
    content: '◌ ';
  }
  .pill--running {
    color: var(--accent);
  }
  .pill--muted {
    color: var(--muted);
  }

  /* ---- dashboard */
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }
  .kpi {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.15rem;
  }
  .kpi__label {
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .kpi__value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  .kpi__note {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  #stats[aria-busy='true'] .viz,
  #stats[aria-busy='true'] .kpis {
    opacity: 0.55;
  }

  .cols {
    position: relative;
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    grid-template-rows: 180px auto;
  }
  .cols__grid {
    grid-column: 1 / -1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }
  .cols__grid span {
    border-top: 1px solid var(--border);
    height: 0;
    position: relative;
  }
  .cols__grid span:last-child {
    border-top-color: var(--border-strong);
  }
  .cols__grid span::before {
    content: attr(data-v);
    position: absolute;
    left: 0;
    top: -0.55rem;
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cols__plot {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }
  .admin .cols__col {
    all: unset;
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    cursor: default;
  }
  .cols__col span {
    width: min(100%, 24px);
    background: var(--viz-1);
    border-radius: 4px 4px 0 0;
    min-height: 0;
  }
  .cols__col.is-active span,
  .cols__col:focus-visible span {
    filter: brightness(1.2);
  }
  .admin .cols__col:focus-visible {
    outline: 2px solid var(--accent);
  }
  .cols__x {
    grid-column: 2;
    display: flex;
    gap: 2px;
    font-size: 0.72rem;
    color: var(--muted);
    padding-top: 0.35rem;
  }
  .cols__x span {
    flex: 1;
    white-space: nowrap;
    overflow: visible;
    width: 0;
  }
  .viz__tip {
    position: absolute;
    top: -0.5rem;
    transform: translate(-50%, -100%);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    padding: 0.35rem 0.6rem;
    font-size: 0.8rem;
    white-space: nowrap;
    pointer-events: none;
    display: grid;
  }
  .viz__tip[hidden] {
    display: none;
  }
  .viz__tip span {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .bars li {
    display: grid;
    grid-template-columns: minmax(6rem, 40%) 1fr;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
  }
  .bars__label {
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bars__track {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .bars__bar {
    height: 14px;
    background: var(--viz-1);
    border-radius: 0 4px 4px 0;
    flex: none;
    width: calc((100% - 4.5rem) * var(--r));
  }
  .bars__value {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bars__value small {
    color: var(--muted);
    margin-left: 0.3rem;
  }
  .viz__empty {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }
  .viz__table {
    margin-top: 0.9rem;
    font-size: 0.82rem;
  }
  .viz__table summary {
    color: var(--muted);
    cursor: pointer;
  }
  .viz__table table {
    margin-top: 0.5rem;
    border-collapse: collapse;
    width: 100%;
  }
  .viz__table th,
  .viz__table td {
    text-align: left;
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* ---- forms */
  .post {
    display: grid;
    gap: 1.1rem;
  }
  .post p {
    margin: 0;
  }
  .admin fieldset {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.8rem 0.9rem 0.9rem;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .admin legend {
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0 0.3rem;
  }
  .submit {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  /* ---- dock: the action button and the progress card; sticks to the bottom on phones */
  .dock {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .prog {
    justify-self: stretch;
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .prog[hidden] {
    display: none;
  }
  .prog {
    position: relative;
  }
  /* Dismiss once finished (while running there is nothing to close). */
  .admin .prog__close {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    display: none;
    min-height: 0;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .prog[data-state='done'] .prog__close,
  .prog[data-state='stopped'] .prog__close,
  .prog[data-state='failed'] .prog__close {
    display: grid;
    place-items: center;
  }
  .prog[data-state='done'] .prog__text,
  .prog[data-state='failed'] .prog__text,
  .prog[data-state='stopped'] .prog__text {
    padding-right: 2rem;
  }
  .prog[data-state='stopped'] .prog__bar span {
    background: var(--muted);
  }
  .dock__buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .dock__buttons [hidden] {
    display: none;
  }
  .prog__bar {
    position: relative;
    height: 8px;
    border-radius: 99px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .prog__bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transition: width 0.6s ease;
  }
  .prog.is-indeterminate .prog__bar span {
    width: 35% !important;
    animation: prog-slide 1.2s ease-in-out infinite;
  }
  @keyframes prog-slide {
    from {
      left: -35%;
    }
    to {
      left: 100%;
    }
  }
  .prog[data-state='done'] .prog__bar span {
    background: var(--good);
  }
  .prog[data-state='failed'] .prog__bar span {
    background: var(--bad);
  }
  .prog__text {
    margin: 0.15rem 0 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .prog[data-state='done'] .prog__text {
    color: var(--good);
  }
  .prog[data-state='failed'] .prog__text {
    color: var(--bad);
  }
  .prog__sub {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .prog__sub[hidden] {
    display: none;
  }
  .prog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .prog__actions:empty {
    display: none;
  }
  .prog__log summary {
    font-size: 0.8rem;
    color: var(--muted);
    cursor: pointer;
  }
  .prog__log ol {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.82rem;
    display: grid;
    gap: 0.2rem;
  }
  .prog__log:not(:has(li)) {
    display: none;
  }
  .json-tools {
    gap: 0.4rem;
  }
  @media (max-width: 899px) {
    /* iOS zooms into any field under 16 px: keep them at 16 px. */
    .admin input:not([type='checkbox']):not([type='radio']):not([type='file']),
    .admin textarea,
    .admin select,
    .admin textarea[data-json] {
      font-size: 16px;
    }
    /* Thumb-sized targets. */
    .admin .wrap button,
    .admin .wrap .button {
      min-height: 44px;
    }
    .admin .wrap button.link {
      min-height: 0;
    }
    .card {
      padding: 0.9rem 0.85rem;
    }
    .admin fieldset {
      padding: 0.7rem 0.7rem 0.8rem;
    }
    /* The action button and the progress stay in reach, above the tab bar. */
    .dock {
      position: sticky;
      bottom: calc(4.4rem + env(safe-area-inset-bottom));
      z-index: 4;
      justify-items: stretch;
      margin: 0 -0.35rem;
      padding: 0.6rem 0.35rem;
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .dock button.primary {
      width: 100%;
      min-height: 50px;
      font-size: 1rem;
    }
    .dock__buttons {
      flex-wrap: nowrap;
    }
    .dock__buttons button.primary {
      flex: 1;
      width: auto;
    }
    .dock__buttons button.ghost {
      min-height: 50px;
      padding-inline: 1.1rem;
    }
    .prog {
      padding: 0.7rem 0.8rem;
      max-height: 45vh;
      overflow-y: auto;
    }
    .json-tools button {
      flex: 1 1 auto;
    }
  }

  /* ---- Instagram */
  .ig select {
    width: 100%;
    padding: 0.5rem 0.6rem;
    font: inherit;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--text);
  }
  .ig textarea {
    width: 100%;
    box-sizing: border-box;
  }
  .ig__frame {
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.88rem;
  }
  .ig__slides {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 0.6rem;
    margin: 0.6rem 0;
    padding: 0;
    list-style: none;
  }
  .ig__slide label {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    border: 2px solid transparent;
    background: #000;
    cursor: pointer;
  }
  .ig__slide label:has(input:checked) {
    border-color: var(--accent);
  }
  .ig__slide label:has(input:not(:checked)) {
    opacity: 0.4;
  }
  .ig__slide .ig__bg {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    filter: blur(12px) brightness(0.8);
  }
  .ig__slide .ig__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ig[data-frame='crop'] .ig__slide .ig__img {
    object-fit: cover;
  }
  .ig__slide input {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    z-index: 1;
  }
  .ig__slide .ig__tag {
    position: absolute;
    right: 0.25rem;
    bottom: 0.25rem;
    z-index: 1;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 0.68rem;
  }
  .log {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    display: grid;
    gap: 0.3rem;
  }
  .log:empty {
    display: none;
  }
  .toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-elev);
    border: 1px solid var(--bad);
    color: var(--text);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    font-size: 0.9rem;
    z-index: 10;
  }

  /* ---- new post: files + JSON */
  .files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .files:empty {
    display: none;
  }
  /* Drag handle: press and drag to reorder (touch-action none so the page does not scroll). */
  .file__grip {
    width: 2.5rem;
  }
  .admin button.file__grip {
    align-self: stretch;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.1rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .admin button.file__grip span {
    font-size: 1.35rem;
    line-height: 1;
  }
  .admin button.file__grip small {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .files.is-sorting .file {
    transition: transform 0.15s var(--ease-out);
  }
  .files.is-sorting,
  .files.is-sorting .admin button.file__grip {
    cursor: grabbing;
  }
  .files .file.is-dragging {
    transition: none;
    position: relative;
    z-index: 2;
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
  }
  .file {
    display: grid;
    grid-template-columns: auto 56px minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }
  .file--auto {
    margin-left: 1.5rem;
    opacity: 0.8;
  }
  .file--error {
    border-color: var(--bad);
  }
  .file__thumb {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 6px;
    background: var(--surface-2);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--muted);
  }
  .file__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .file__badge {
    position: absolute;
    left: 3px;
    bottom: 3px;
    font-size: 0.66rem;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    padding: 0 0.3rem;
    border-radius: 4px;
  }
  .file__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    justify-items: start;
  }
  .admin .file__name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.1rem 0.4rem;
    background: var(--surface-2);
    border-color: var(--border);
  }
  .admin .file__name.is-copied::after {
    content: ' 已複製';
    color: var(--good);
    font-family: var(--font-sans);
  }
  .file__note {
    font-size: 0.78rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .file--error .file__note {
    color: var(--bad);
    white-space: normal;
  }
  .admin .file__remove {
    padding: 0.25rem 0.5rem;
  }
  .admin textarea[data-json] {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    tab-size: 2;
  }
  .id {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-2);
    max-width: 28rem;
  }
  .check {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--bg);
    border: 1px solid var(--border);
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
  }
  .check li::before {
    margin-right: 0.4rem;
  }
  .check .good::before {
    content: '✓';
  }
  .check .bad::before {
    content: '✕';
  }
  .check .warn {
    color: var(--gold);
  }
  .check .warn::before {
    content: '!';
  }
  .check code {
    font-size: 0.8rem;
  }

  /* ---- Phones: floating glass tab bar (the sidebar is hidden) */
  .tabbar {
    display: none;
  }
  @media (max-width: 899px) {
    .admin .side {
      display: none;
    }
    .wrap {
      padding-bottom: calc(7rem + env(safe-area-inset-bottom));

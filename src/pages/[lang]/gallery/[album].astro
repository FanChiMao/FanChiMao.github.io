---
// Moved: albums live under /<lang>/personal/gallery/ now.
import { getCollection } from 'astro:content';
import Redirect from '@/components/Redirect.astro';
import { locales, defaultLocale } from '@/i18n/ui';

export async function getStaticPaths() {
  const albums = await getCollection('albums', ({ data }) => !data.draft);
  return locales.filter((l) => l !== defaultLocale).flatMap((lang) => albums.map((album) => ({ params: { lang, album: album.id } })));
}
---

<Redirect to={`/${Astro.params.lang}/personal/gallery/${Astro.params.album}/`} />

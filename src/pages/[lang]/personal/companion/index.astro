---
// Moved: Ajie lives at /<lang>/personal/ajie/ now (keeps #post links working).
import Redirect from '@/components/Redirect.astro';
import { locales, defaultLocale } from '@/i18n/ui';

export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}
---

<Redirect to={`/${Astro.params.lang}/personal/ajie/`} />

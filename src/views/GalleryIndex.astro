---
import { getCollection } from 'astro:content';
import PersonalLayout from '@/layouts/PersonalLayout.astro';
import AlbumCard from '@/components/AlbumCard.astro';
import { ui, type Locale } from '@/i18n/ui';
import { personalUi } from '@/i18n/personal';
import { albumCategories } from '@/content.config';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const p = personalUi[lang];
const path = '/personal/gallery/';
const albums = (await getCollection('albums', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
// Only offer categories that actually have albums.
const used = albumCategories.filter((c) => albums.some((a) => a.data.categories.includes(c)));
---

<PersonalLayout {lang} {path} title={p.chapters.gallery.name} description={t.gallery.subtitle} overlay={false}>
  <div class="gallery-page pw-page pw-sea">
    <header class="container gallery-head pw-head">
      <p class="pw-kicker" data-reveal>{p.chapters.gallery.kind}</p>
      <h1 class="pw-head__title serif" data-reveal style="--i:1">{p.chapters.gallery.name}</h1>
      <p class="pw-head__lead" data-reveal style="--i:2">{t.gallery.subtitle}</p>
    </header>

    {
      used.length > 1 && (
        <div class="container filters" role="group" aria-label={p.gallery.filter} data-filters hidden>
          <button type="button" data-filter="all" aria-pressed="true">
            {p.gallery.all}
          </button>
          {used.map((c) => (
            <button type="button" data-filter={c} aria-pressed="false">
              {p.gallery.categories[c]}
            </button>
          ))}
        </div>
      )
    }

    <div class="container albums" data-albums>
      {albums.map((album, i) => <AlbumCard {lang} {album} index={i} />)}
    </div>
  </div>
</PersonalLayout>

<script>
  // Category filter. Without JS the buttons stay hidden and every album shows.
  // The choice lives in the URL hash (e.g. #astro) so it can be linked.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-albums] [data-categories]')];
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const apply = (cat: string) => {
      if (!buttons.some((b) => b.dataset.filter === cat)) cat = 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
      cards.forEach((c) => (c.hidden = cat !== 'all' && !c.dataset.categories!.split(' ').includes(cat)));
    };
    bar.addEventListener('click', (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[data-filter]');
      if (!b) return;
      const cat = b.dataset.filter!;
      history.replaceState(history.state, '', cat === 'all' ? location.pathname : `#${cat}`);
      apply(cat);
    });
    apply(location.hash.slice(1) || 'all');
  }
</script>

<style>
  .gallery-head {
    margin-bottom: 2.25rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .filters[hidden] {
    display: none;
  }
  .filters button {
    padding: 0.45rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font-size: 0.9rem;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .filters button:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .filters button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .albums > :global([hidden]) {
    display: none;
  }
  .albums {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .albums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .albums {
      grid-template-columns: 1fr;
    }
  }
</style>

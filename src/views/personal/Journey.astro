---
/**
 * /personal/journey/: first times and journeys worth remembering, newest first on a timeline, or
 * as cards pinned to a 3D globe (switch top left, remembered in this browser). Category filter
 * top right. Milestones come from src/content/journey/*.json; nothing here is invented.
 */
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import PersonalLayout from '@/layouts/PersonalLayout.astro';
import PostMedia from '@/components/personal/PostMedia.astro';
import { localeMeta, type Locale } from '@/i18n/ui';
import { personalUi } from '@/i18n/personal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const p = personalUi[lang];
const c = p.chapters.journey;
const pick = (v: string | Record<Locale, string> | undefined) => (v === undefined ? undefined : typeof v === 'string' ? v : v[lang]);
const fmt = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// Collapsed cards lead with the date: a big day-and-month, the year under it.
const dayMonth = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { month: 'short', day: 'numeric', timeZone: 'UTC' });
const asDate = (iso: string) => new Date(`${iso}T00:00:00Z`);

const ICON = { run: 'footprints', dive: 'waves', jump: 'mountain-snow', hike: 'mountain', ride: 'bike', travel: 'plane', other: 'flag' } as const;
const items = (await getCollection('journey', ({ data }) => !data.draft)).sort((a, b) => b.data.date.localeCompare(a.data.date));
// Group by year, keeping the newest-first order.
const years = [...new Set(items.map((x) => x.data.date.slice(0, 4)))].map((y) => ({ year: y, items: items.filter((x) => x.data.date.startsWith(y)) }));
// Filter chips: only the categories that have milestones, in the schema's order.
const used = (Object.keys(ICON) as (keyof typeof ICON)[]).filter((k) => items.some((x) => x.data.category === k));
const unplaced = items.filter((x) => !x.data.coords).length;
---

<PersonalLayout {lang} path="/personal/journey/" title={c.name} description={c.blurb} overlay={false} noindex={items.length === 0}>
  <div class="journey pw-page pw-sea" data-journey data-view="globe">
    <script is:inline>
      // Opens on the globe unless the timeline was picked in this browser.
      try {
        if (localStorage.getItem('journey:view:v2') === 'timeline') document.currentScript.closest('[data-journey]').dataset.view = 'timeline';
      } catch {}
    </script>
    <div class="container journey__inner">
      <header class="pw-head">
        <p class="pw-kicker" data-reveal>{c.kind}</p>
        <h1 class="pw-head__title serif" data-reveal style="--i:1">{c.name}</h1>
        <p class="pw-head__lead" data-reveal style="--i:2">{c.blurb}</p>
      </header>

      {
        items.length === 0 ? (
          <p class="journey__empty" data-reveal>
            <Icon name="lucide:flag" />
            {p.journey.empty}
          </p>
        ) : (
          <div class="journey__posts">
          <div class="journey__bar">
            <div class="journey__views" role="group" aria-label={p.journey.view}>
              <button type="button" data-view-btn="globe" aria-pressed="true" aria-label={p.journey.viewGlobe} title={p.journey.viewGlobe}>
                <Icon name="lucide:globe" />
              </button>
              <button type="button" data-view-btn="timeline" aria-pressed="false" aria-label={p.journey.viewTimeline} title={p.journey.viewTimeline}>
                <Icon name="lucide:list" />
              </button>
            </div>
            {used.length > 0 && (
              <div class="journey__filter" role="group" aria-label={p.journey.filter}>
                <button type="button" data-filter="all" aria-pressed="true">
                  {p.journey.all}
                </button>
                {used.map((k) => (
                  <button type="button" data-filter={k} aria-pressed="false">
                    <Icon name={`lucide:${ICON[k]}`} />
                    {p.journey.categories[k]}
                  </button>
                ))}
              </div>
            )}
          </div>
          <ol class="milestones">
            {years.map(({ year, items: list }) => (
              <li class="milestones__year">
                <h2 class="milestones__label" data-reveal>
                  {year}
                </h2>
                <ol class="milestones__list">
                  {list.map((m, i) => {
                    const title = pick(m.data.title) ?? '';
                    const place = pick(m.data.place);
                    const story = pick(m.data.story) ?? '';
                    return (
                      <li
                        class="milestone"
                        data-reveal="right"
                        style={`--i:${i}; --c1: var(--cat-${m.data.category}); --c2: var(--cat-${m.data.category}-2)`}
                        data-id={m.id}
                        data-category={m.data.category}
                        data-date={m.data.date}
                        data-lat={m.data.coords?.lat}
                        data-lng={m.data.coords?.lng}
                      >
                        <span class="milestone__dot" aria-hidden="true">
                          <Icon name={`lucide:${ICON[m.data.category]}`} />
                        </span>
                        {/* Collapsible: the summary is one bar (date, category, title, place); all start collapsed. */}
                        <details class="milestone__card" data-milestone={m.id}>
                          <summary class="milestone__head">
                            <time class="milestone__when" datetime={m.data.date}>
                              <span class="milestone__day">{dayMonth.format(asDate(m.data.date))}</span>
                              <span class="milestone__yr">{m.data.date.slice(0, 4)}</span>
                            </time>
                            <span class="milestone__main">
                              <span class="milestone__tags">
                                <span class="badge">{p.journey.categories[m.data.category]}</span>
                                {m.data.stat && <span class="badge milestone__stat-chip">{m.data.stat}</span>}
                              </span>
                              <h3 class="milestone__title">{title}</h3>
                              {m.data.short && <span class="milestone__short" hidden>{pick(m.data.short)}</span>}
                              <span class="milestone__meta">
                                <span class="milestone__full-date">{fmt.format(asDate(m.data.date))}</span>
                                {place && (
                                  <span>
                                    <Icon name="lucide:map-pin" />
                                    {place}
                                  </span>
                                )}
                              </span>
                            </span>
                            <span class="milestone__chev" aria-hidden="true">
                              <Icon name="lucide:chevron-down" />
                            </span>
                          </summary>
                          <div class="milestone__body">
                            {m.data.stat && <p class="milestone__stat">{m.data.stat}</p>}
                            {m.data.media.length > 0 && <PostMedia {lang} media={m.data.media} label={title} ratio="16 / 10" sizes="(min-width: 900px) 720px, 100vw" />}
                            <div class="milestone__story">
                              {story.split(/\n{2,}/).map((para) => (
                                <p>{para}</p>
                              ))}
                            </div>
                          </div>
                        </details>
                      </li>
                    );
                  })}
                </ol>
              </li>
            ))}
          </ol>
          <section class="jglobe" data-globe aria-label={p.journey.viewGlobe}>
            <div class="jglobe__stage" data-globe-stage data-swap-skip />
            <p class="jglobe__status" data-globe-status>
              {p.journey.globeLoading}
            </p>
            <p class="jglobe__unsupported" data-globe-unsupported hidden>
              {p.journey.globeUnsupported}
            </p>
            <div class="jglobe__tools">
              <button type="button" class="jglobe__tool" data-globe-spin aria-pressed="false">
                <Icon name="lucide:rotate-3d" />
                {p.journey.spin}
              </button>
              <button type="button" class="jglobe__tool" data-globe-reset>
                <Icon name="lucide:globe" />
                {p.journey.resetView}
              </button>
            </div>
            {/* Text the script needs (swapped with the page language like any other text). */}
            <span data-globe-str="group" hidden>{p.journey.groupOf}</span>
            <aside class="jglobe__panel" data-globe-panel hidden>
              <button type="button" class="icon-btn jglobe__close" data-globe-close aria-label={p.journey.closePanel}>
                <Icon name="lucide:x" />
              </button>
              <button type="button" class="jglobe__back" data-globe-back hidden>
                <Icon name="lucide:arrow-left" />
                {p.journey.backToList}
              </button>
              <div class="jglobe__panel-body" data-globe-panel-body data-swap-skip />
              <button type="button" class="jglobe__read" data-globe-read>
                {p.journey.readStory}
                <Icon name="lucide:arrow-right" />
              </button>
            </aside>
            {unplaced > 0 && <p class="jglobe__hint">{p.journey.noCoords(unplaced)}</p>}
          </section>
          </div>
        )
      }
    </div>
  </div>
</PersonalLayout>

<script>
  import { track } from '@/lib/passport';
  import type { GlobeView, Mark, Pin } from '@/lib/journey-globe';

  document.querySelectorAll<HTMLDetailsElement>('details[data-milestone]').forEach((d) =>
    d.addEventListener('toggle', () => d.open && track('milestone', d.dataset.milestone ?? '')),
  );

  const root = document.querySelector<HTMLElement>('[data-journey]');
  const globeHost = root?.querySelector<HTMLElement>('[data-globe]');
  if (root && globeHost) {
    const globeEl = globeHost;
    const stage = globeEl.querySelector<HTMLElement>('[data-globe-stage]')!;
    const status = globeEl.querySelector<HTMLElement>('[data-globe-status]')!;
    const panel = globeEl.querySelector<HTMLElement>('[data-globe-panel]')!;
    const panelBody = globeEl.querySelector<HTMLElement>('[data-globe-panel-body]')!;
    const backBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-back]')!;
    const readBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-read]')!;
    const str = (key: string, n: number) => (globeEl.querySelector(`[data-globe-str="${key}"]`)?.textContent ?? '').replace('{n}', String(n));
    const milestones = Array.from(root.querySelectorAll<HTMLElement>('.milestone'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let filter = 'all';
    let globe: GlobeView | null = null;
    let loading: Promise<void> | null = null;
    let current: string | null = null;
    /** The group whose list is in the panel (or the list a picked milestone came from). */
    let list: Pin[] | null = null;
    /** Milestone whose real pin is shown over its group (pointed at in the list). */
    let peekId: string | null = null;
    const colours = (el: HTMLElement, cat: string | undefined) => {
      el.style.setProperty('--c1', `var(--cat-${cat ?? 'other'})`);
      el.style.setProperty('--c2', `var(--cat-${cat ?? 'other'}-2)`);
    };
    /** Point at a milestone of a group: its bubble steps aside, the real pin drops in (or back). */
    const peek = (pin: Pin | null) => {
      peekId = pin?.id ?? null;
      stage.querySelectorAll<HTMLElement>('.gpin--group').forEach((g) => g.classList.toggle('is-peeking', !!peekId && (g.dataset.ids ?? '').split(',').includes(peekId)));
      globe?.peek(pin);
    };

    const byId = (id: string) => milestones.find((m) => m.dataset.id === id);
    const text = (m: HTMLElement, sel: string) => m.querySelector(sel)?.textContent?.trim() ?? '';
    const pins = (): Pin[] =>
      milestones
        .filter((m) => m.dataset.lat && m.dataset.lng && (filter === 'all' || m.dataset.category === filter))
        .map((m) => ({ id: m.dataset.id!, lat: Number(m.dataset.lat), lng: Number(m.dataset.lng) }));

    /**
     * A map pin whose tip sits on the exact coordinates, with the milestone's category icon (the
     * same one as on the timeline) and a short label: the full date, and the title only up to its
     * colon, since many milestones sit close together (the panel shows the whole title). Text
     * comes from the timeline, so it is always in the current language.
     */
    const shortOf = (m: HTMLElement) => {
      const title = text(m, '.milestone__title');
      return text(m, '.milestone__short') || title.split(/[：:｜|]/)[0].trim() || title;
    };
    /** "2023年11月" or "2023年10月 – 11月", in the page language. */
    const monthsOf = (list: Pin[]) => {
      const days = list.map((p) => byId(p.id)?.dataset.date ?? '').filter(Boolean).sort();
      if (!days.length) return '';
      const f = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { year: 'numeric', month: 'short', timeZone: 'UTC' });
      const a = new Date(`${days[0]}T00:00:00Z`), b = new Date(`${days.at(-1)}T00:00:00Z`);
      return days[0].slice(0, 7) === days.at(-1)!.slice(0, 7) ? f.format(a) : f.formatRange(a, b);
    };
    const draw = (mark: Mark) => (mark.kind === 'group' ? groupCard(mark.pins) : card(mark.pin, mark.kind === 'peek'));

    /** Pins too close together: one bubble with the count; it opens their list. */
    const groupCard = (list: Pin[]) => {
      const el = document.createElement('div');
      el.className = 'gpin gpin--group';
      el.dataset.ids = list.map((p) => p.id).join(',');
      el.classList.toggle('is-peeking', !!peekId && list.some((p) => p.id === peekId));
      // The ring shows the categories inside, in proportion.
      const cats = list.map((p) => byId(p.id)?.dataset.category ?? 'other');
      const stops = cats.map((c, i) => `var(--cat-${c}) ${(i / cats.length) * 100}% ${((i + 1) / cats.length) * 100}%`).join(', ');
      el.style.setProperty('--ring', `conic-gradient(${stops})`);
      el.innerHTML =
        '<span class="gpin__pulse" aria-hidden="true"></span><button type="button" class="gpin__btn"><span class="gpin__count" aria-hidden="true"></span><span class="gpin__label" aria-hidden="true"><span class="gpin__date"></span><span class="gpin__title"></span></span></button>';
      el.querySelector('.gpin__count')!.textContent = String(list.length);
      el.querySelector('.gpin__date')!.textContent = monthsOf(list);
      el.querySelector('.gpin__title')!.textContent = list.slice(0, 2).map((p) => shortOf(byId(p.id)!)).join('、') + (list.length > 2 ? '…' : '');
      const btn = el.querySelector('button')!;
      btn.setAttribute('aria-label', `${str('group', list.length)}: ${list.map((p) => shortOf(byId(p.id)!)).join(', ')}`);
      btn.addEventListener('click', () => openList(list));
      return el;
    };

    const card = (pin: Pin, peek = false) => {
      const m = byId(pin.id)!;
      const title = text(m, '.milestone__title');
      const short = text(m, '.milestone__short');
      const date = text(m, '.milestone__full-date');
      const el = document.createElement('div');
      el.className = 'gpin';
      el.innerHTML =
        '<span class="gpin__pulse" aria-hidden="true"></span><button type="button" class="gpin__btn"><span class="gpin__head" aria-hidden="true"></span><span class="gpin__label" aria-hidden="true"><span class="gpin__date"></span><span class="gpin__title"></span></span></button>';
      const icon = m.querySelector('.milestone__dot svg');
      if (icon) el.querySelector('.gpin__head')!.append(icon.cloneNode(true));
      el.querySelector('.gpin__date')!.textContent = date;
      el.querySelector('.gpin__title')!.textContent = short || title.split(/[：:｜|]/)[0].trim() || title;
      el.classList.toggle('is-peek', peek);
      colours(el, m.dataset.category);
      const btn = el.querySelector('button')!;
      btn.setAttribute('aria-label', [title, date].filter(Boolean).join(', '));
      btn.addEventListener('click', () => pick(pin.id));
      el.classList.toggle('is-current', pin.id === current);
      return el;
    };

    const fillPanel = (id: string) => {
      const m = byId(id);
      if (!m) return;
      panelBody.replaceChildren();
      const add = (tag: string, cls: string, value: string) => {
        if (!value) return;
        const el = document.createElement(tag);
        el.className = cls;
        el.textContent = value;
        panelBody.append(el);
      };
      add('p', 'jglobe__tags', [text(m, '.milestone__tags .badge:not(.milestone__stat-chip)'), text(m, '.milestone__stat-chip')].filter(Boolean).join(' · '));
      add('h3', 'jglobe__title', text(m, '.milestone__title'));
      add('p', 'jglobe__meta', [text(m, '.milestone__full-date'), text(m, '.milestone__meta > span:not(.milestone__full-date)')].filter(Boolean).join(' · '));
    };

    /** The list of a group: pointing at a row shows that milestone's real pin; a click opens it. */
    const fillList = (group: Pin[]) => {
      panelBody.replaceChildren();
      const head = document.createElement('p');
      head.className = 'jglobe__tags';
      head.textContent = str('group', group.length);
      const ul = document.createElement('ul');
      ul.className = 'jglobe__list';
      for (const pin of group) {
        const m = byId(pin.id);
        if (!m) continue;
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'jglobe__row';
        const icon = document.createElement('span');
        icon.className = 'jglobe__row-icon';
        colours(icon, m.dataset.category);
        icon.setAttribute('aria-hidden', 'true');
        const svg = m.querySelector('.milestone__dot svg');
        if (svg) icon.append(svg.cloneNode(true));
        const name = document.createElement('span');
        name.className = 'jglobe__row-title';
        name.textContent = shortOf(m);
        const when = document.createElement('span');
        when.className = 'jglobe__row-date';
        when.textContent = text(m, '.milestone__full-date');
        b.append(icon, name, when);
        b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && peek(pin));
        b.addEventListener('pointerleave', () => peek(null));
        b.addEventListener('focus', () => peek(pin));
        b.addEventListener('blur', () => peek(null));
        b.addEventListener('click', () => pick(pin.id, true));
        li.append(b);
        ul.append(li);
      }
      panelBody.append(head, ul);
    };

    function openList(group: Pin[], fly = true) {
      if (!globe) return;
      list = group;
      current = null;
      fillList(group);
      panel.dataset.mode = 'list';
      backBtn.hidden = true;
      readBtn.hidden = true;
      panel.hidden = false;
      peek(null);
      globe.setPins(pins());
      if (fly) globe.flyToAll(group);
    }

    function pick(id: string, fromList = false) {
      const pin = pins().find((p) => p.id === id);
      if (!pin || !globe) return;
      if (!fromList) list = null;
      current = id;
      fillPanel(id);
      panel.dataset.mode = 'one';
      backBtn.hidden = !list;
      readBtn.hidden = false;
      panel.hidden = false;
      peek(null);
      globe.setPins(pins(), id); // the picked one is never grouped
      globe.flyTo(pin);
      track('milestone', id);
    }
    const closePanel = () => {
      panel.hidden = true;
      current = null;
      list = null;
      peek(null);
      globe?.setPins(pins());
    };

    async function ensureGlobe() {
      if (globe || loading) return loading ?? undefined;
      loading = (async () => {
        const mod = await import('@/lib/journey-globe');
        if (!mod.canDrawGlobe()) {
          status.hidden = true;
          globeEl.querySelector<HTMLElement>('[data-globe-unsupported]')!.hidden = false;
          fallBack();
          return;
        }
        try {
          globe = await mod.createGlobe(stage, draw, reduce);
          globe.setPins(pins());
          globe.reset(true);
          const spinBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-spin]')!;
          globe.onSpin((on) => spinBtn.setAttribute('aria-pressed', String(on)));
          // Turning the globe away from the picked pin (or the group) closes its card.
          globe.onUserMove(() => !panel.hidden && closePanel());
          spinBtn.addEventListener('click', () => globe?.setSpin(spinBtn.getAttribute('aria-pressed') !== 'true'));
          status.hidden = true;
          globeEl.classList.add('is-ready');
        } catch {
          status.hidden = true;
          globeEl.querySelector<HTMLElement>('[data-globe-unsupported]')!.hidden = false;
          fallBack();
        }
      })();
      return loading;
    }

    // ---- Globe (default) / timeline (remembered in this browser).
    // Without WebGL the globe cannot be drawn: show the timeline instead (not remembered).
    const fallBack = () => {
      if (root.dataset.view !== 'globe') return;
      root.dataset.view = 'timeline';
      paintView();
    };
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
    const paintView = () => {
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === root.dataset.view)));
      if (root.dataset.view === 'globe') {
        ensureGlobe();
        globe?.resume();
      } else globe?.pause();
    };
    viewBtns.forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.view = b.dataset.viewBtn;
        try {
          localStorage.setItem('journey:view:v2', root.dataset.view!);
        } catch {}
        paintView();
      }),
    );
    paintView();

    // ---- Category filter (timeline and globe).
    const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const applyFilter = () => {
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      milestones.forEach((m) => (m.hidden = filter !== 'all' && m.dataset.category !== filter));
      root.querySelectorAll<HTMLElement>('.milestones__year').forEach((y) => (y.hidden = !y.querySelector('.milestone:not([hidden])')));
      if (list || (current && !pins().some((p) => p.id === current))) closePanel();
      globe?.setPins(pins(), current);
    };
    filterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter ?? 'all';
        applyFilter();
      }),
    );

    globeEl.querySelector('[data-globe-reset]')!.addEventListener('click', () => globe?.reset());
    // Long-press on a phone: no context menu (save image / select) over the globe.
    stage.addEventListener('contextmenu', (e) => e.preventDefault());
    globeEl.querySelector('[data-globe-close]')!.addEventListener('click', closePanel);
    backBtn.addEventListener('click', () => list && openList(list, false));
    globeEl.querySelector('[data-globe-read]')!.addEventListener('click', () => {
      const m = current ? byId(current) : null;
      if (!m) return;
      root.dataset.view = 'timeline'; // just this once: the page still opens on the globe next time
      paintView();
      const d = m.querySelector('details')!;
      d.open = true;
      m.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      d.querySelector('summary')?.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden && root.dataset.view === 'globe') closePanel();
    });
    // Language switched in place: redraw the cards and the open panel from the new text.
    document.addEventListener('langswap', () => {
      paintView();
      applyFilter();
      globe?.redraw();
      if (current) fillPanel(current);
      else if (list) fillList(list);
    });
  }
</script>

<style>
  .journey__inner {
    display: grid;
    gap: 2.75rem;
    max-width: 860px;
  }
  .journey__empty {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    padding: 4rem 1rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }
  .journey__empty :global(svg) {
    width: 2rem;
    height: 2rem;
    color: var(--accent);
  }

  .milestones,
  .milestones__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .milestones {
    display: grid;
    gap: 2.5rem;
  }
  .milestones__label {
    margin-bottom: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--accent);
  }
  .milestones__list {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-left: 3.25rem;
  }
  /* The trail */
  .milestones__list::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--accent), var(--accent-2));
    opacity: 0.45;
  }
  .milestone {
    position: relative;
    z-index: 1;
  }
  .milestone__dot {
    position: absolute;
    left: -3.25rem;
    top: 1.05rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--c1, var(--accent)) 45%, var(--border-strong));
    background: color-mix(in srgb, var(--c1, var(--accent)) 12%, var(--bg-elev));
    color: var(--c1, var(--accent));
  }
  .milestone__dot :global(svg) {
    width: 18px;
    height: 18px;
  }
  .milestone__card {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    backdrop-filter: blur(6px);
    transition: border-color 0.3s;
  }
  .milestone__card:hover,
  .milestone__card[open] {
    border-color: var(--border-strong);
  }
  .milestone__card::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease-out),
      content-visibility 0.5s allow-discrete;
  }
  .milestone__card[open]::details-content {
    block-size: auto;
  }
  /* The bar: date | category, title, place | chevron */
  .milestone__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.1rem;
    align-items: center;
    padding: 0.9rem clamp(1rem, 3vw, 1.4rem);
    list-style: none;
    cursor: pointer;
  }
  .milestone__head::-webkit-details-marker {
    display: none;
  }
  .milestone__head:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 18px;
  }
  .milestone__when {
    display: grid;
    justify-items: center;
    min-width: 4.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    line-height: 1.1;
    text-align: center;
  }
  .milestone__day {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .milestone__yr {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .milestone__main {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .milestone__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .milestone__stat-chip {
    font-family: var(--font-mono);
  }
  .milestone__title {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.3;
  }
  .milestone__meta .milestone__full-date {
    display: none;
  }
  .milestone__chev {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    transition:
      transform 0.4s var(--ease-out),
      color 0.25s;
  }
  .milestone__chev :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .milestone__head:hover .milestone__chev {
    color: var(--accent);
  }
  .milestone__card[open] .milestone__chev {
    transform: rotate(180deg);
  }
  .milestone__body {
    display: grid;
    gap: 1rem;
    padding: 0 clamp(1rem, 3vw, 1.4rem) clamp(1.1rem, 3vw, 1.4rem);
  }
  .milestone__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .milestone__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .milestone__meta :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .milestone__stat {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 560px) {
    .milestone__head {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .milestone__chev {
      display: none;
    }
    .milestone__when {
      min-width: 3.9rem;
    }
  }
  .milestone__story {
    display: grid;
    gap: 0.75rem;
    color: var(--text-2);
    line-height: 1.8;
    white-space: pre-line;
  }

  /* ---- Display settings: timeline / globe on the left, category filter on the right. */
  .journey__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }
  .journey__views {
    display: inline-flex;
    gap: 0.25rem;
  }
  .journey__views button {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .journey__views button:hover {
    color: var(--text);
  }
  .journey__views button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .journey__views :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .journey__filter {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    scrollbar-width: none;
    max-width: 100%;
  }
  .journey__filter button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--text-2);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .journey__filter button:hover {
    border-color: var(--accent);
  }
  .journey__filter button[aria-pressed='true'] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--text);
  }
  .journey__filter :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .journey__views button:focus-visible,
  .journey__filter button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .milestone[hidden],
  .milestones__year[hidden] {
    display: none;
  }
  [data-view='globe'] .milestones,
  [data-view='timeline'] .jglobe {
    display: none;
  }

  /* ---- Globe view */
  .jglobe {
    position: relative;
    display: grid;
    gap: 0.6rem;
    /* Read by the globe script to paint its surface (plain colours: canvas and three.js parse them). */
    --globe-ocean-top: #dcecf9;
    --globe-ocean: #c6dcf1;
    --globe-ocean-bottom: #b4cde6;
    --globe-land: rgba(30, 120, 150, 0.16);
    --globe-coast: rgba(20, 105, 150, 0.75);
    --globe-dot: rgba(10, 116, 194, 0.7);
    --globe-grid: rgba(10, 80, 160, 0.12);
    --globe-glow: #8fd0ff;
  }
  /* Category colours (pins, list icons, timeline dots): two stops each, tuned per theme so they
     read on the pale and on the deep-sea globe alike. */
  .journey {
    /* Light: deep enough that a white icon on them stays clear. */
    --cat-run: #c9431b;
    --cat-run-2: #e2622a;
    --cat-hike: #0f7a47;
    --cat-hike-2: #24924a;
    --cat-travel: #6236c9;
    --cat-travel-2: #8a3fcf;
    --cat-dive: #08708c;
    --cat-dive-2: #0e8aa3;
    --cat-ride: #a35d00;
    --cat-ride-2: #c27a05;
    --cat-jump: #b4245a;
    --cat-jump-2: #d03b78;
    --cat-other: #2d57b8;
    --cat-other-2: #4371d6;
  }
  :root[data-theme='dark'] .journey {
    --cat-run: #ff7a4d;
    --cat-run-2: #ffab5e;
    --cat-hike: #3fcf86;
    --cat-hike-2: #8be07a;
    --cat-travel: #a98bff;
    --cat-travel-2: #d58cff;
    --cat-dive: #32c8e6;
    --cat-dive-2: #6fe3ef;
    --cat-ride: #ffbe3d;
    --cat-ride-2: #ffd873;
    --cat-jump: #ff6fa3;
    --cat-jump-2: #ff9cc4;
    --cat-other: #6ea2ff;
    --cat-other-2: #9cc0ff;
  }
  :root[data-theme='dark'] .jglobe {
    --globe-ocean-top: #0a1d33;
    --globe-ocean: #0c2745;
    --globe-ocean-bottom: #06152a;
    --globe-land: rgba(70, 175, 200, 0.14);
    --globe-coast: rgba(120, 220, 240, 0.85);
    --globe-dot: rgba(130, 226, 245, 0.9);
    --globe-grid: rgba(120, 200, 255, 0.09);
    --globe-glow: #4fb6ff;
  }
  /* Long-pressing to turn the globe on a phone must not select text or pop up the callout menu
     (the panel's text stays selectable). */
  .jglobe__stage,
  .jglobe__tools,
  .jglobe__stage :global(*) {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .jglobe__stage {
    position: relative;
    /* The globe's pin layer has its own z-index: keep it inside the stage so the panel and tools stay on top. */
    isolation: isolate;
    z-index: 0;
    height: min(72vh, 620px);
    min-height: 360px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%),
      radial-gradient(1px 1px at 12% 18%, color-mix(in srgb, var(--text) 55%, transparent), transparent),
      radial-gradient(1px 1px at 82% 12%, color-mix(in srgb, var(--text) 45%, transparent), transparent),
      radial-gradient(1.5px 1.5px at 72% 78%, color-mix(in srgb, var(--text) 40%, transparent), transparent),
      radial-gradient(1px 1px at 24% 72%, color-mix(in srgb, var(--text) 35%, transparent), transparent),
      radial-gradient(1px 1px at 90% 52%, color-mix(in srgb, var(--text) 35%, transparent), transparent),
      radial-gradient(1.5px 1.5px at 8% 48%, color-mix(in srgb, var(--text) 30%, transparent), transparent),
      radial-gradient(1px 1px at 46% 8%, color-mix(in srgb, var(--text) 40%, transparent), transparent),
      radial-gradient(1px 1px at 58% 92%, color-mix(in srgb, var(--text) 30%, transparent), transparent),
      linear-gradient(180deg, var(--bg-elev), color-mix(in srgb, var(--bg-elev) 70%, var(--accent) 6%));
    touch-action: none;
    cursor: grab;
  }
  .jglobe__stage:active {
    cursor: grabbing;
  }
  .jglobe__status,
  .jglobe__unsupported {
    position: absolute;
    inset: 0 0 auto;
    height: min(72vh, 620px);
    min-height: 360px;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    color: var(--muted);
    pointer-events: none;
  }
  .jglobe__status[hidden],
  .jglobe__unsupported[hidden] {
    display: none;
  }
  .jglobe__tools {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.4rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .jglobe.is-ready .jglobe__tools {
    opacity: 1;
    pointer-events: auto;
  }
  .jglobe__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--glass);
    backdrop-filter: blur(8px);
    color: var(--text-2);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .jglobe__tool:hover {
    border-color: var(--accent);
  }
  .jglobe__tool[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .jglobe__tool:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .jglobe__tool :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .jglobe__hint {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .jglobe__panel {
    position: absolute;
    z-index: 2;
    left: 0.75rem;
    bottom: 2.6rem;
    width: min(22rem, calc(100% - 1.5rem));
    box-sizing: border-box;
    padding: 1rem 1.1rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--glass);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: 0.35rem;
  }
  .jglobe__panel[hidden] {
    display: none;
  }
  .jglobe__close {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
  }
  .jglobe__panel-body :global(.jglobe__tags) {
    margin: 0;
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }
  .jglobe__panel-body :global(.jglobe__title) {
    margin: 0.1rem 2rem 0 0;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .jglobe__panel-body :global(.jglobe__meta) {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .jglobe__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: -0.15rem 0 0.1rem;
    padding: 0.15rem 0.1rem;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .jglobe__back:hover {
    color: var(--accent);
  }
  .jglobe__back[hidden],
  .jglobe__read[hidden] {
    display: none;
  }
  .jglobe__back :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .jglobe__panel-body :global(.jglobe__list) {
    display: grid;
    gap: 0.15rem;
    margin: 0.35rem -0.4rem 0;
    padding: 0;
    list-style: none;
    max-height: min(16rem, 40vh);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .jglobe__panel-body :global(.jglobe__row) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.45rem 0.45rem;
    border: 0;
    border-radius: 10px;
    background: none;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .jglobe__panel-body :global(.jglobe__row:hover),
  .jglobe__panel-body :global(.jglobe__row:focus-visible) {
    background: var(--accent-soft);
    outline: none;
  }
  .jglobe__panel-body :global(.jglobe__row-icon) {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c1, var(--accent)), var(--c2, var(--accent-2)));
    color: #fff;
  }
  .jglobe__panel-body :global(.jglobe__row-icon svg) {
    width: 0.85rem;
    height: 0.85rem;
    stroke-width: 2.4;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.35));
  }
  .jglobe__panel-body :global(.jglobe__row-title) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .jglobe__panel-body :global(.jglobe__row-date) {
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .jglobe__read {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    padding: 0.45rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .jglobe__read :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* A milestone on the globe: the element sits exactly on the coordinates (0 x 0); the pin's tip
     is that point, a pulse ring spreads on the ground around it, the label sits beside the head. */
  .jglobe :global(.gpin) {
    position: relative;
    width: 0;
    height: 0;
    transition: opacity 0.25s;
  }
  .jglobe :global(.gpin.is-behind) {
    opacity: 0;
    pointer-events: none;
  }
  .jglobe :global(.gpin__pulse) {
    position: absolute;
    left: -12px;
    top: -5px;
    width: 24px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c1, var(--accent)) 45%, transparent);
    box-shadow: 0 0 10px var(--c1, var(--accent));
  }
  .jglobe :global(.gpin__pulse::after) {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--c1, var(--accent));
    animation: gpin-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes gpin-pulse {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .jglobe :global(.gpin__btn) {
    position: absolute;
    left: -17px;
    bottom: 0;
    width: 34px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    transform-origin: 50% 100%;
    transition: transform 0.25s var(--ease-out);
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.35));
  }
  .jglobe :global(.gpin__btn:hover),
  .jglobe :global(.gpin.is-current .gpin__btn) {
    transform: scale(1.15);
  }
  .jglobe :global(.gpin__btn:focus-visible) {
    outline: none;
  }
  .jglobe :global(.gpin__btn:focus-visible .gpin__head) {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  /* A group: a round bubble centred on the pins' middle, with the count. */
  .jglobe :global(.gpin--group .gpin__btn) {
    left: -19px;
    bottom: -19px;
    width: 38px;
    height: 38px;
    transform-origin: 50% 50%;
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.25s ease;
  }
  .jglobe :global(.gpin--group.is-peeking .gpin__btn) {
    transform: scale(0.4);
    opacity: 0;
    pointer-events: none;
  }
  .jglobe :global(.gpin--group .gpin__pulse) {
    display: none;
  }
  .jglobe :global(.gpin__count) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    border: 3px solid transparent;
    border-radius: 50%;
    background:
      linear-gradient(var(--bg-elev), var(--bg-elev)) padding-box,
      var(--ring, linear-gradient(135deg, var(--accent), var(--accent-2))) border-box;
    box-shadow:
      0 0 0 1.5px #fff,
      0 4px 12px rgb(0 0 0 / 0.3);
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .jglobe :global(.gpin--group .gpin__label) {
    left: 46px;
    top: 50%;
    translate: 0 -50%;
  }
  /* The real pin of a milestone pointed at in a group's list, drawn over the group. */
  .jglobe :global(.gpin.is-peek) {
    z-index: 1;
  }
  .jglobe :global(.gpin.is-peek .gpin__btn) {
    transform: scale(1.15);
    animation: gpin-drop 0.38s cubic-bezier(0.34, 1.5, 0.64, 1);
  }
  .jglobe :global(.gpin.is-peek .gpin__label) {
    border-color: var(--c1, var(--accent));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c1, var(--accent)) 22%, transparent);
    animation: gpin-fade 0.3s ease 0.08s backwards;
  }
  /* The pin grows out of the spot (tip first), with a little overshoot. */
  @keyframes gpin-drop {
    from {
      transform: scale(0.2);
      opacity: 0;
    }

---
/**
 * /personal/journey/: first times and journeys worth remembering, newest first on a timeline, or
 * as cards pinned to a 3D globe (switch top left, remembered in this browser). Search by title,
 * filter by year and category; on the globe, "Play" flies through what is shown, oldest first.
 * Milestones come from src/content/journey/*.json; nothing here is invented.
 */
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import PersonalLayout from '@/layouts/PersonalLayout.astro';
import PostMedia from '@/components/personal/PostMedia.astro';
import { localeMeta, type Locale } from '@/i18n/ui';
import { personalUi } from '@/i18n/personal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const p = personalUi[lang];
const c = p.chapters.journey;
const pick = (v: string | Record<Locale, string> | undefined) => (v === undefined ? undefined : typeof v === 'string' ? v : v[lang]);
const fmt = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// Collapsed cards lead with the date: a big day-and-month, the year under it.
const dayMonth = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { month: 'short', day: 'numeric', timeZone: 'UTC' });
const asDate = (iso: string) => new Date(`${iso}T00:00:00Z`);

const ICON = {
  run: 'footprints',
  dive: 'waves',
  jump: 'mountain-snow',
  hike: 'mountain',
  ride: 'bike',
  travel: 'plane',
  music: 'music',
  sky: 'sparkles',
  work: 'briefcase',
  life: 'heart',
  other: 'flag',
} as const;
const items = (await getCollection('journey', ({ data }) => !data.draft)).sort((a, b) => b.data.date.localeCompare(a.data.date));
// Group by year, keeping the newest-first order.
const years = [...new Set(items.map((x) => x.data.date.slice(0, 4)))].map((y) => ({ year: y, items: items.filter((x) => x.data.date.startsWith(y)) }));
// Filter chips: only the categories that have milestones, in the schema's order.
const used = (Object.keys(ICON) as (keyof typeof ICON)[]).filter((k) => items.some((x) => x.data.category === k));
const unplaced = items.filter((x) => !x.data.coords).length;
---

<PersonalLayout {lang} path="/personal/journey/" title={c.name} description={c.blurb} overlay={false} noindex={items.length === 0}>
  <div class="journey pw-page pw-sea" data-journey data-view="globe">
    <script is:inline>
      // Opens on the globe unless the timeline was picked in this browser.
      try {
        if (localStorage.getItem('journey:view:v2') === 'timeline') document.currentScript.closest('[data-journey]').dataset.view = 'timeline';
      } catch {}
    </script>
    <div class="container journey__inner">
      <header class="pw-head">
        <p class="pw-kicker" data-reveal>{c.kind}</p>
        <h1 class="pw-head__title serif" data-reveal style="--i:1">{c.name}</h1>
        <p class="pw-head__lead" data-reveal style="--i:2">{c.blurb}</p>
      </header>

      {
        items.length === 0 ? (
          <p class="journey__empty" data-reveal>
            <Icon name="lucide:flag" />
            {p.journey.empty}
          </p>
        ) : (
          <div class="journey__posts">
          <div class="journey__bar">
            <div class="journey__views" role="group" aria-label={p.journey.view}>
              <button type="button" data-view-btn="globe" aria-pressed="true" aria-label={p.journey.viewGlobe} title={p.journey.viewGlobe}>
                <Icon name="lucide:globe" />
              </button>
              <button type="button" data-view-btn="timeline" aria-pressed="false" aria-label={p.journey.viewTimeline} title={p.journey.viewTimeline}>
                <Icon name="lucide:list" />
              </button>
            </div>
            <div class="journey__find">
              <label class="journey__search">
                <Icon name="lucide:search" />
                <input type="search" data-search placeholder={p.journey.search} aria-label={p.journey.search} enterkeyhint="search" autocomplete="off" />
              </label>
              {years.length > 1 && (
                <div class="journey__year" data-year>
                  <button type="button" class="journey__year-btn" data-year-btn aria-haspopup="menu" aria-expanded="false" aria-label={p.journey.year}>
                    <Icon name="lucide:calendar" />
                    {/* One label per choice, the picked one shown: a language switch leaves them in step. */}
                    <span class="journey__year-label" data-year-label="all">
                      {p.journey.allYears}
                    </span>
                    {years.map(({ year }) => (
                      <span class="journey__year-label" data-year-label={year} hidden>
                        {year}
                      </span>
                    ))}
                    <span class="journey__year-chev" aria-hidden="true">
                      <Icon name="lucide:chevron-down" />
                    </span>
                  </button>
                  <div class="journey__year-menu" role="menu" aria-label={p.journey.year} data-year-menu hidden>
                    <button type="button" role="menuitemradio" aria-checked="true" data-year-opt="all">
                      <span class="journey__year-check" aria-hidden="true">
                        <Icon name="lucide:check" />
                      </span>
                      <span class="journey__year-name">{p.journey.allYears}</span>
                      <span class="journey__year-n">{items.length}</span>
                    </button>
                    {years.map(({ year, items: list }) => (
                      <button type="button" role="menuitemradio" aria-checked="false" data-year-opt={year}>
                        <span class="journey__year-check" aria-hidden="true">
                          <Icon name="lucide:check" />
                        </span>
                        <span class="journey__year-name">{year}</span>
                        <span class="journey__year-n">{list.length}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>
            {used.length > 0 && (
              <div class="journey__filter" role="group" aria-label={p.journey.filter}>
                {/* "All" stays put; the categories scroll sideways when they do not fit (phones). */}
                <button type="button" class="journey__all" data-filter="all" aria-pressed="true">
                  {p.journey.all}
                </button>
                <div class="journey__cats" data-cats>
                  {used.map((k) => (
                    <button type="button" data-filter={k} aria-pressed="false">
                      <Icon name={`lucide:${ICON[k]}`} />
                      {p.journey.categories[k]}
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
          <p class="journey__none" data-none hidden>
            {p.journey.noMatch}
          </p>
          <ol class="milestones">
            {years.map(({ year, items: list }) => (
              <li class="milestones__year">
                <h2 class="milestones__label" data-reveal>
                  {year}
                </h2>
                <ol class="milestones__list">
                  {list.map((m, i) => {
                    const title = pick(m.data.title) ?? '';
                    const place = pick(m.data.place);
                    const story = pick(m.data.story) ?? '';
                    return (
                      <li
                        class="milestone"
                        data-reveal="right"
                        style={`--i:${i}; --c1: var(--cat-${m.data.category}); --c2: var(--cat-${m.data.category}-2)`}
                        data-id={m.id}
                        data-category={m.data.category}
                        data-date={m.data.date}
                        data-lat={m.data.coords?.lat}
                        data-lng={m.data.coords?.lng}
                      >
                        <span class="milestone__dot" aria-hidden="true">
                          <Icon name={`lucide:${ICON[m.data.category]}`} />
                        </span>
                        {/* Collapsible: the summary is one bar (date, category, title, place); all start collapsed. */}
                        <details class="milestone__card" data-milestone={m.id}>
                          <summary class="milestone__head">
                            <span class="milestone__main">
                              <span class="milestone__tags">
                                {/* The date is a chip like the others (the year is the heading above). */}
                                <time class="milestone__when" datetime={m.data.date}>
                                  <Icon name="lucide:calendar" />
                                  {dayMonth.format(asDate(m.data.date))}
                                </time>
                                <span class="badge milestone__cat">{p.journey.categories[m.data.category]}</span>
                                {m.data.stat && <span class="badge milestone__stat-chip">{m.data.stat}</span>}
                              </span>
                              <h3 class="milestone__title">{title}</h3>
                              {m.data.short && <span class="milestone__short" hidden>{pick(m.data.short)}</span>}
                              <span class="milestone__meta">
                                <span class="milestone__full-date">{fmt.format(asDate(m.data.date))}</span>
                                {place && (
                                  <span>
                                    <Icon name="lucide:map-pin" />
                                    {place}
                                  </span>
                                )}
                              </span>
                            </span>
                            <span class="milestone__chev" aria-hidden="true">
                              <Icon name="lucide:chevron-down" />
                            </span>
                          </summary>
                          <div class="milestone__body">
                            {m.data.stat && <p class="milestone__stat">{m.data.stat}</p>}
                            {m.data.media.length > 0 && <PostMedia {lang} media={m.data.media} label={title} ratio="16 / 10" sizes="(min-width: 900px) 720px, 100vw" />}
                            <div class="milestone__story">
                              {story.split(/\n{2,}/).map((para) => (
                                <p>{para}</p>
                              ))}
                            </div>
                          </div>
                        </details>
                      </li>
                    );
                  })}
                </ol>
              </li>
            ))}
          </ol>
          <section class="jglobe" data-globe aria-label={p.journey.viewGlobe}>
            <div class="jglobe__stage" data-globe-stage data-swap-skip />
            <p class="jglobe__status" data-globe-status>
              {p.journey.globeLoading}
            </p>
            <p class="jglobe__unsupported" data-globe-unsupported hidden>
              {p.journey.globeUnsupported}
            </p>
            <div class="jglobe__tools">
              <button type="button" class="jglobe__tool" data-globe-play aria-pressed="false" title={p.journey.playHint}>
                <span class="jglobe__when-off">
                  <Icon name="lucide:play" />
                  {p.journey.play}
                </span>
                <span class="jglobe__when-on">
                  <Icon name="lucide:pause" />
                  {p.journey.pause}
                </span>
              </button>
              <button type="button" class="jglobe__tool" data-globe-spin aria-pressed="false">
                <Icon name="lucide:rotate-3d" />
                {p.journey.spin}
              </button>
              <button type="button" class="jglobe__tool" data-globe-reset>
                <Icon name="lucide:globe" />
                {p.journey.resetView}
              </button>
            </div>
            {/* Text the script needs (swapped with the page language like any other text). */}
            <span data-globe-str="group" hidden>{p.journey.groupOf}</span>
            <aside class="jglobe__panel" data-globe-panel hidden>
              <button type="button" class="icon-btn jglobe__close" data-globe-close aria-label={p.journey.closePanel}>
                <Icon name="lucide:x" />
              </button>
              <button type="button" class="jglobe__back" data-globe-back hidden>
                <Icon name="lucide:arrow-left" />
                {p.journey.backToList}
              </button>
              <div class="jglobe__panel-body" data-globe-panel-body data-swap-skip />
              <button type="button" class="jglobe__read" data-globe-read>
                {p.journey.readStory}
                <Icon name="lucide:arrow-right" />
              </button>
            </aside>
            {unplaced > 0 && <p class="jglobe__hint">{p.journey.noCoords(unplaced)}</p>}
          </section>
          </div>
        )
      }
    </div>
  </div>
</PersonalLayout>

<script>
  import { track } from '@/lib/passport';
  import type { GlobeView, Mark, Pin } from '@/lib/journey-globe';

  document.querySelectorAll<HTMLDetailsElement>('details[data-milestone]').forEach((d) =>
    d.addEventListener('toggle', () => d.open && track('milestone', d.dataset.milestone ?? '')),
  );

  const root = document.querySelector<HTMLElement>('[data-journey]');
  const globeHost = root?.querySelector<HTMLElement>('[data-globe]');
  if (root && globeHost) {
    const globeEl = globeHost;
    const stage = globeEl.querySelector<HTMLElement>('[data-globe-stage]')!;
    const status = globeEl.querySelector<HTMLElement>('[data-globe-status]')!;
    const panel = globeEl.querySelector<HTMLElement>('[data-globe-panel]')!;
    const panelBody = globeEl.querySelector<HTMLElement>('[data-globe-panel-body]')!;
    const backBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-back]')!;
    const readBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-read]')!;
    const str = (key: string, n: number) => (globeEl.querySelector(`[data-globe-str="${key}"]`)?.textContent ?? '').replace('{n}', String(n));
    const milestones = Array.from(root.querySelectorAll<HTMLElement>('.milestone'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let filter = 'all';
    let year = 'all';
    let query = '';
    // Play (the tour): declared up here, since closing the panel or switching views stops it.
    const playBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-play]')!;
    let touring = false;
    let tourTimer = 0;
    let globe: GlobeView | null = null;
    let loading: Promise<void> | null = null;
    let current: string | null = null;
    /** The group whose list is in the panel (or the list a picked milestone came from). */
    let list: Pin[] | null = null;
    /** Milestone whose real pin is shown over its group (pointed at in the list). */
    let peekId: string | null = null;
    const colours = (el: HTMLElement, cat: string | undefined) => {
      el.style.setProperty('--c1', `var(--cat-${cat ?? 'other'})`);
      el.style.setProperty('--c2', `var(--cat-${cat ?? 'other'}-2)`);
    };
    /** Point at a milestone of a group: its bubble steps aside, the real pin drops in (or back). */
    const peek = (pin: Pin | null) => {
      peekId = pin?.id ?? null;
      stage.querySelectorAll<HTMLElement>('.gpin--group').forEach((g) => g.classList.toggle('is-peeking', !!peekId && (g.dataset.ids ?? '').split(',').includes(peekId)));
      globe?.peek(pin);
    };

    const byId = (id: string) => milestones.find((m) => m.dataset.id === id);
    const text = (m: HTMLElement, sel: string) => m.querySelector(sel)?.textContent?.trim() ?? '';
    /** Category, year and title search (in the page language) together. */
    const fold = (s: string) => s.normalize('NFKC').toLowerCase().replace(/\s+/g, ' ');
    const shown = (m: HTMLElement) =>
      (filter === 'all' || m.dataset.category === filter) &&
      (year === 'all' || (m.dataset.date ?? '').startsWith(year)) &&
      (!query || fold(`${text(m, '.milestone__title')} ${text(m, '.milestone__short')}`).includes(query));
    const pins = (): Pin[] =>
      milestones.filter((m) => m.dataset.lat && m.dataset.lng && shown(m)).map((m) => ({ id: m.dataset.id!, lat: Number(m.dataset.lat), lng: Number(m.dataset.lng) }));

    /**
     * A map pin whose tip sits on the exact coordinates, with the milestone's category icon (the
     * same one as on the timeline) and a short label: the full date, and the title only up to its
     * colon, since many milestones sit close together (the panel shows the whole title). Text
     * comes from the timeline, so it is always in the current language.
     */
    const shortOf = (m: HTMLElement) => {
      const title = text(m, '.milestone__title');
      return text(m, '.milestone__short') || title.split(/[：:｜|]/)[0].trim() || title;
    };
    /** "2023年11月" or "2023年10月 – 11月", in the page language. */
    const monthsOf = (list: Pin[]) => {
      const days = list.map((p) => byId(p.id)?.dataset.date ?? '').filter(Boolean).sort();
      if (!days.length) return '';
      const f = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { year: 'numeric', month: 'short', timeZone: 'UTC' });
      const a = new Date(`${days[0]}T00:00:00Z`), b = new Date(`${days.at(-1)}T00:00:00Z`);
      return days[0].slice(0, 7) === days.at(-1)!.slice(0, 7) ? f.format(a) : f.formatRange(a, b);
    };
    const draw = (mark: Mark) => (mark.kind === 'group' ? groupCard(mark.pins) : card(mark.pin, mark.kind === 'peek'));

    /** Pins too close together: one bubble with the count; it opens their list. */
    const groupCard = (list: Pin[]) => {
      const el = document.createElement('div');
      el.className = 'gpin gpin--group';
      el.dataset.ids = list.map((p) => p.id).join(',');
      el.classList.toggle('is-peeking', !!peekId && list.some((p) => p.id === peekId));
      // The ring shows the categories inside, in proportion.
      const cats = list.map((p) => byId(p.id)?.dataset.category ?? 'other');
      const stops = cats.map((c, i) => `var(--cat-${c}) ${(i / cats.length) * 100}% ${((i + 1) / cats.length) * 100}%`).join(', ');
      el.style.setProperty('--ring', `conic-gradient(${stops})`);
      el.innerHTML =
        '<span class="gpin__pulse" aria-hidden="true"></span><button type="button" class="gpin__btn"><span class="gpin__count" aria-hidden="true"></span><span class="gpin__label" aria-hidden="true"><span class="gpin__date"></span><span class="gpin__title"></span></span></button>';
      el.querySelector('.gpin__count')!.textContent = String(list.length);
      el.querySelector('.gpin__date')!.textContent = monthsOf(list);
      el.querySelector('.gpin__title')!.textContent = list.slice(0, 2).map((p) => shortOf(byId(p.id)!)).join('、') + (list.length > 2 ? '…' : '');
      const btn = el.querySelector('button')!;
      btn.setAttribute('aria-label', `${str('group', list.length)}: ${list.map((p) => shortOf(byId(p.id)!)).join(', ')}`);
      btn.addEventListener('click', () => openList(list));
      return el;
    };

    const card = (pin: Pin, peek = false) => {
      const m = byId(pin.id)!;
      const title = text(m, '.milestone__title');
      const short = text(m, '.milestone__short');
      const date = text(m, '.milestone__full-date');
      const el = document.createElement('div');
      el.className = 'gpin';
      el.innerHTML =
        '<span class="gpin__pulse" aria-hidden="true"></span><button type="button" class="gpin__btn"><span class="gpin__head" aria-hidden="true"></span><span class="gpin__label" aria-hidden="true"><span class="gpin__date"></span><span class="gpin__title"></span></span></button>';
      const icon = m.querySelector('.milestone__dot svg');
      if (icon) el.querySelector('.gpin__head')!.append(icon.cloneNode(true));
      el.querySelector('.gpin__date')!.textContent = date;
      el.querySelector('.gpin__title')!.textContent = short || title.split(/[：:｜|]/)[0].trim() || title;
      el.classList.toggle('is-peek', peek);
      colours(el, m.dataset.category);
      const btn = el.querySelector('button')!;
      btn.setAttribute('aria-label', [title, date].filter(Boolean).join(', '));
      btn.addEventListener('click', () => pick(pin.id));
      el.classList.toggle('is-current', pin.id === current);
      return el;
    };

    const fillPanel = (id: string) => {
      const m = byId(id);
      if (!m) return;
      panelBody.replaceChildren();
      const add = (tag: string, cls: string, value: string) => {
        if (!value) return;
        const el = document.createElement(tag);
        el.className = cls;
        el.textContent = value;
        panelBody.append(el);
      };
      add('p', 'jglobe__tags', [text(m, '.milestone__cat'), text(m, '.milestone__stat-chip')].filter(Boolean).join(' · '));
      add('h3', 'jglobe__title', text(m, '.milestone__title'));
      add('p', 'jglobe__meta', [text(m, '.milestone__full-date'), text(m, '.milestone__meta > span:not(.milestone__full-date)')].filter(Boolean).join(' · '));
    };

    /** The list of a group: pointing at a row shows that milestone's real pin; a click opens it. */
    const fillList = (group: Pin[]) => {
      panelBody.replaceChildren();
      const head = document.createElement('p');
      head.className = 'jglobe__tags';
      head.textContent = str('group', group.length);
      const ul = document.createElement('ul');
      ul.className = 'jglobe__list';
      for (const pin of group) {
        const m = byId(pin.id);
        if (!m) continue;
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'jglobe__row';
        const icon = document.createElement('span');
        icon.className = 'jglobe__row-icon';
        colours(icon, m.dataset.category);
        icon.setAttribute('aria-hidden', 'true');
        const svg = m.querySelector('.milestone__dot svg');
        if (svg) icon.append(svg.cloneNode(true));
        const name = document.createElement('span');
        name.className = 'jglobe__row-title';
        name.textContent = shortOf(m);
        const when = document.createElement('span');
        when.className = 'jglobe__row-date';
        when.textContent = text(m, '.milestone__full-date');
        b.append(icon, name, when);
        b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && peek(pin));
        b.addEventListener('pointerleave', () => peek(null));
        b.addEventListener('focus', () => peek(pin));
        b.addEventListener('blur', () => peek(null));
        b.addEventListener('click', () => pick(pin.id, true));
        li.append(b);
        ul.append(li);
      }
      panelBody.append(head, ul);
    };

    function openList(group: Pin[], fly = true) {
      if (!globe) return;
      list = group;
      current = null;
      fillList(group);
      panel.dataset.mode = 'list';
      backBtn.hidden = true;
      readBtn.hidden = true;
      panel.hidden = false;
      peek(null);
      globe.setPins(pins());
      if (fly) globe.flyToAll(group);
    }

    function pick(id: string, fromList = false, auto = false) {
      const pin = pins().find((p) => p.id === id);
      if (!pin || !globe) return;
      if (!auto) stopTour(); // a pin picked by hand ends the tour
      if (!fromList) list = null;
      current = id;
      fillPanel(id);
      panel.dataset.mode = 'one';
      backBtn.hidden = !list;
      readBtn.hidden = false;
      panel.hidden = false;
      peek(null);
      globe.setPins(pins(), id); // the picked one is never grouped
      globe.flyTo(pin);
      if (!auto) {
        track('milestone', id);
        track('globe-pin', id);
      }
    }
    const closePanel = () => {
      stopTour();
      panel.hidden = true;
      current = null;
      list = null;
      peek(null);
      globe?.setPins(pins());
    };

    async function ensureGlobe() {
      if (globe || loading) return loading ?? undefined;
      loading = (async () => {
        const mod = await import('@/lib/journey-globe');
        if (!mod.canDrawGlobe()) {
          status.hidden = true;
          globeEl.querySelector<HTMLElement>('[data-globe-unsupported]')!.hidden = false;
          fallBack();
          return;
        }
        try {
          globe = await mod.createGlobe(stage, draw, reduce);
          globe.setPins(pins());
          globe.reset(true);
          const spinBtn = globeEl.querySelector<HTMLButtonElement>('[data-globe-spin]')!;
          globe.onSpin((on) => {
            spinBtn.setAttribute('aria-pressed', String(on));
            if (on) stopTour();
          });
          // Turning the globe away from the picked pin (or the group) closes its card.
          globe.onUserMove(() => {
            stopTour();
            if (!panel.hidden) closePanel();
          });
          spinBtn.addEventListener('click', () => globe?.setSpin(spinBtn.getAttribute('aria-pressed') !== 'true'));
          status.hidden = true;
          globeEl.classList.add('is-ready');
        } catch {
          status.hidden = true;
          globeEl.querySelector<HTMLElement>('[data-globe-unsupported]')!.hidden = false;
          fallBack();
        }
      })();
      return loading;
    }

    // ---- Globe (default) / timeline (remembered in this browser).
    // Without WebGL the globe cannot be drawn: show the timeline instead (not remembered).
    const fallBack = () => {
      if (root.dataset.view !== 'globe') return;
      root.dataset.view = 'timeline';
      paintView();
    };
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
    const paintView = () => {
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === root.dataset.view)));
      if (root.dataset.view === 'globe') {
        ensureGlobe();
        globe?.resume();
      } else {
        stopTour();
        globe?.pause();
      }
    };
    viewBtns.forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.view = b.dataset.viewBtn;
        try {
          localStorage.setItem('journey:view:v2', root.dataset.view!);
        } catch {}
        paintView();
      }),
    );
    paintView();

    // ---- Search, year and category (timeline and globe).
    const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const searchEl = root.querySelector<HTMLInputElement>('[data-search]');
    const yearBtn = root.querySelector<HTMLButtonElement>('[data-year-btn]');
    const yearMenu = root.querySelector<HTMLElement>('[data-year-menu]');
    const yearOpts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-year-opt]'));
    const noneEl = root.querySelector<HTMLElement>('[data-none]')!;
    const paintYear = () => {
      root.querySelectorAll<HTMLElement>('[data-year-label]').forEach((l) => (l.hidden = l.dataset.yearLabel !== year));
      yearOpts.forEach((o) => o.setAttribute('aria-checked', String(o.dataset.yearOpt === year)));
      yearBtn?.classList.toggle('is-set', year !== 'all');
    };
    const applyFilter = () => {
      stopTour();
      paintYear();
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      milestones.forEach((m) => (m.hidden = !shown(m)));
      root.querySelectorAll<HTMLElement>('.milestones__year').forEach((y) => (y.hidden = !y.querySelector('.milestone:not([hidden])')));
      noneEl.hidden = milestones.some((m) => !m.hidden);
      if (query) track('journey-filter', 'search');
      if (year !== 'all') track('journey-filter', 'year');
      if (filter !== 'all') track('journey-filter', 'category');
      if (list || (current && !pins().some((p) => p.id === current))) closePanel();
      globe?.setPins(pins(), current);
    };
    const catsEl = root.querySelector<HTMLElement>('[data-cats]');
    filterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter ?? 'all';
        applyFilter();
        // Bring the picked category fully into the scrolling row (back to the start for "All").
        if (catsEl) {
          if (filter === 'all') catsEl.scrollTo({ left: 0, behavior: reduce ? 'auto' : 'smooth' });
          else {
            const r = b.getBoundingClientRect(), c = catsEl.getBoundingClientRect();
            const pad = 24;
            if (r.left < c.left + pad || r.right > c.right - pad) catsEl.scrollBy({ left: r.left + r.width / 2 - (c.left + c.width / 2), behavior: reduce ? 'auto' : 'smooth' });
          }
        }
      }),
    );
    // Soft edges on the category row where more chips are hidden.
    catsEl?.addEventListener('scroll', () => paintCatEdges(), { passive: true });
    const paintCatEdges = () => {
      if (!catsEl) return;
      const max = catsEl.scrollWidth - catsEl.clientWidth;
      catsEl.classList.toggle('has-left', catsEl.scrollLeft > 2);
      catsEl.classList.toggle('has-right', catsEl.scrollLeft < max - 2);
    };
    new ResizeObserver(paintCatEdges).observe(catsEl ?? root);
    paintCatEdges();

    /*
     * When the categories do not fit (phones), the row drifts slowly back and forth on its own so
     * the hidden ones show up, resting a moment at each end. It holds still while the reader
     * touches, hovers or focuses it (and for a few seconds after they scroll it themselves), while a
     * category is picked, off screen, or with reduced motion.
     */
    if (catsEl && !reduce) {
      const SPEED = 22; // px per second
      const REST = 1600; // ms at each end
      let pos = 0;
      let dir = 1;
      let restUntil = performance.now() + 2500; // a moment before it starts
      let holdUntil = 0;
      let touching = false;
      let hovering = false;
      let visible = false;
      let raf = 0;
      let lastT = 0;
      const running = () => visible && !touching && !hovering && filter === 'all' && !catsEl.contains(document.activeElement);
      const tick = (t: number) => {
        raf = 0;
        const dt = lastT ? Math.min(64, t - lastT) : 0;
        lastT = t;
        const max = catsEl.scrollWidth - catsEl.clientWidth;
        if (running() && max > 4 && t > restUntil && t > holdUntil) {
          pos = Math.min(max, Math.max(0, pos + (dir * SPEED * dt) / 1000));
          if (pos >= max || pos <= 0) {
            dir = pos >= max ? -1 : 1;
            restUntil = t + REST;
          }
          catsEl.scrollLeft = pos;
        }
        if (visible) raf = requestAnimationFrame(tick);
      };
      const start = () => {
        if (!raf) {
          lastT = 0;
          raf = requestAnimationFrame(tick);
        }
      };
      // The reader's own scrolling (not ours): follow it and pause for a while.
      catsEl.addEventListener(
        'scroll',
        () => {
          if (Math.abs(catsEl.scrollLeft - pos) > 2) {
            pos = catsEl.scrollLeft;
            holdUntil = performance.now() + 3500;
          }
        },
        { passive: true },
      );
      catsEl.addEventListener('pointerdown', () => (touching = true));
      addEventListener('pointerup', () => {
        if (!touching) return;
        touching = false;
        holdUntil = performance.now() + 3500;
      });
      addEventListener('pointercancel', () => (touching = false));
      catsEl.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (hovering = true));
      catsEl.addEventListener('pointerleave', () => (hovering = false));
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) start();
      }).observe(catsEl);
      // Back to "All": it starts again after a short rest, from wherever the row is.
      root.querySelector('[data-filter="all"]')?.addEventListener('click', () => {
        holdUntil = performance.now() + 2500;
      });
    }
    // Year menu: a small glass list under the button (keyboard: arrows, Enter, Escape).
    const yearOpen = () => !!yearMenu && !yearMenu.hidden;
    const closeYear = (focusBtn = false) => {
      if (!yearMenu || yearMenu.hidden) return;
      yearMenu.hidden = true;
      yearBtn!.setAttribute('aria-expanded', 'false');
      if (focusBtn) yearBtn!.focus();
    };
    const openYear = () => {
      if (!yearMenu) return;
      yearMenu.hidden = false;
      yearBtn!.setAttribute('aria-expanded', 'true');
      (yearOpts.find((o) => o.dataset.yearOpt === year) ?? yearOpts[0])?.focus({ preventScroll: true });
    };
    yearBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (yearOpen()) closeYear();
      else openYear();
    });
    yearBtn?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        openYear();
      }
    });
    yearOpts.forEach((o) =>
      o.addEventListener('click', () => {
        year = o.dataset.yearOpt ?? 'all';
        closeYear(true);
        applyFilter();
      }),
    );
    yearMenu?.addEventListener('keydown', (e) => {
      const i = yearOpts.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        yearOpts[(i + (e.key === 'ArrowDown' ? 1 : -1) + yearOpts.length) % yearOpts.length]?.focus();
      } else if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        yearOpts[e.key === 'Home' ? 0 : yearOpts.length - 1]?.focus();
      } else if (e.key === 'Escape') {
        e.stopPropagation();
        closeYear(true);
      } else if (e.key === 'Tab') closeYear();
    });
    document.addEventListener('click', (e) => {
      if (yearOpen() && !(e.target as Element).closest('[data-year]')) closeYear();
    });
    let typing = 0;
    searchEl?.addEventListener('input', () => {
      clearTimeout(typing);
      typing = window.setTimeout(() => {
        query = fold(searchEl.value.trim());
        applyFilter();
      }, 120);
    });
    // Enter on a phone keyboard: put the keyboard away so the results show.
    searchEl?.addEventListener('keydown', (e) => e.key === 'Enter' && searchEl.blur());

    // ---- Play: fly through the milestones shown on the globe, oldest first, one card at a time.
    function stopTour() {
      if (!touring) return;
      touring = false;
      clearTimeout(tourTimer);
      playBtn.setAttribute('aria-pressed', 'false');
    }
    /** Rough distance in degrees, to zoom out first between far-apart places. */
    const apart = (a: Pin, b: Pin) => Math.hypot(a.lat - b.lat, (a.lng - b.lng) * Math.cos(((a.lat + b.lat) / 2) * (Math.PI / 180)));
    async function startTour() {
      await ensureGlobe();
      if (!globe) return;
      const date = (p: Pin) => byId(p.id)?.dataset.date ?? '';
      const order = pins().sort((a, b) => date(a).localeCompare(date(b)) || a.id.localeCompare(b.id));
      if (!order.length) return;
      globe.setSpin(false);
      touring = true;
      playBtn.setAttribute('aria-pressed', 'true');
      const dwell = 1800; // the card stays this long after the camera arrives
      const fly = reduce ? 0 : 1700;
      let prev: Pin | null = current ? (order.find((p) => p.id === current) ?? null) : null;
      let i = 0;
      const step = () => {
        if (!touring || !globe) return;
        if (i >= order.length) {
          if (order.length >= 3) track('journey-tour');
          stopTour();
          return;
        }
        const next = order[i++];
        const go = () => {
          if (!touring) return;
          pick(next.id, false, true);
          tourTimer = window.setTimeout(step, fly + dwell);
        };
        // Far apart (another city or country): pull back over both places first, then dive in.
        if (prev && !reduce && apart(prev, next) > 3) {
          panel.hidden = true;
          globe.flyToAll([prev, next]);
          tourTimer = window.setTimeout(go, 1100);
        } else go();
        prev = next;
      };
      step();
    }
    playBtn.addEventListener('click', () => (touring ? stopTour() : startTour()));

    globeEl.querySelector('[data-globe-reset]')!.addEventListener('click', () => {
      stopTour();
      globe?.reset();
    });
    // Long-press on a phone: no context menu (save image / select) over the globe.
    stage.addEventListener('contextmenu', (e) => e.preventDefault());
    globeEl.querySelector('[data-globe-close]')!.addEventListener('click', closePanel);
    backBtn.addEventListener('click', () => list && openList(list, false));
    globeEl.querySelector('[data-globe-read]')!.addEventListener('click', () => {
      const m = current ? byId(current) : null;
      if (!m) return;
      stopTour();
      root.dataset.view = 'timeline'; // just this once: the page still opens on the globe next time
      paintView();
      const d = m.querySelector('details')!;
      d.open = true;
      m.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      d.querySelector('summary')?.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden && root.dataset.view === 'globe') closePanel();
    });
    // Language switched in place: redraw the cards and the open panel from the new text.
    document.addEventListener('langswap', () => {
      paintView();
      applyFilter();
      globe?.redraw();
      if (current) fillPanel(current);
      else if (list) fillList(list);
    });
  }
</script>


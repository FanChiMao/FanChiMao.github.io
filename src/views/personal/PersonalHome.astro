---
import PersonalLayout from '@/layouts/PersonalLayout.astro';
import AbyssHero from '@/components/personal/AbyssHero.astro';
import WhaleNote from '@/components/personal/WhaleNote.astro';
import ChapterIndex from '@/components/personal/ChapterIndex.astro';
import Frequencies from '@/components/personal/Frequencies.astro';
import type { Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<PersonalLayout {lang} path="/personal/">
  <AbyssHero {lang} />
  <WhaleNote {lang} />
  <ChapterIndex {lang} />
  <Frequencies {lang} />
</PersonalLayout>

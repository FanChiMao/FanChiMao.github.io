---
import { AJIE_POST_IDS } from '@/data/ajie-posts';
/**
 * /personal/companion/: Ajie, as an IG-style profile. A header with Ajie's facts, a grid of
 * square thumbnails, and one dialog per post (photos / clips, caption, date, place).
 * Posts come from src/content/ajie/*.json; nothing here is invented.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import PersonalLayout from '@/layouts/PersonalLayout.astro';
import PostMedia from '@/components/personal/PostMedia.astro';
import { localeMeta, type Locale } from '@/i18n/ui';
import { personalUi } from '@/i18n/personal';
import { asset } from '@/lib/assets';
import { ajieProfile } from '@/data/ajie';
import { statsEnabled } from '@/lib/passport-stats';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const p = personalUi[lang];
const c = p.chapters.companion;
const pick = (v: string | Record<Locale, string> | null | undefined) => (v == null ? undefined : typeof v === 'string' ? v : v[lang]);
const fmt = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const day = (iso: string) => (/^\d{4}$/.test(iso) ? iso : fmt.format(new Date(`${iso}T00:00:00Z`)));
const utc = (iso: string) => new Date(`${iso}T00:00:00Z`);
/**
 * The days a post covers, e.g. "Oct 5 – 11, 2025" / "2025年10月5日 – 11日". English uses Intl's
 * range format; Node's ICU collapses CJK ranges to "2025/10/5至2025/10/11", so those are built here.
 */
const when = (d: { from?: string; date: string }) => {
  if (!d.from || d.from === d.date) return day(d.date);
  if (lang === 'en') return fmt.formatRange(utc(d.from), utc(d.date));
  const [y1, m1, d1] = d.from.split('-').map(Number);
  const [y2, m2, d2] = d.date.split('-').map(Number);
  const sep = lang === 'ja' ? '～' : ' – ';
  if (y1 !== y2) return `${day(d.from)}${sep}${day(d.date)}`;
  if (m1 !== m2) return `${y1}年${m1}月${d1}日${sep}${m2}月${d2}日`;
  return `${y1}年${m1}月${d1}日${sep}${d2}日`;
};
/** Compact form for small tiles: 10/27, 10/20–26, 10/30–11/2 (years only when a period crosses one). */
const whenShort = (d: { from?: string; date: string }) => {
  const [y2, m2, d2] = d.date.split('-').map(Number);
  if (!d.from || d.from === d.date) return `${m2}/${d2}`;
  const [y1, m1, d1] = d.from.split('-').map(Number);
  const sep = lang === 'ja' ? '～' : '–';
  if (y1 !== y2) return `${y1}/${m1}/${d1}${sep}${y2}/${m2}/${d2}`;
  if (m1 !== m2) return `${m1}/${d1}${sep}${m2}/${d2}`;
  return `${m1}/${d1}${sep}${d2}`;
};

const posts = (await getCollection('ajie', ({ data }) => !data.draft)).sort((a, b) => Number(!!b.data.pinned) - Number(!!a.data.pinned) || b.data.date.localeCompare(a.data.date));
const hasAiCovers = posts.some((post) => Boolean(post.data.cover));
// The stats Worker only accepts likes on listed posts: fail the build if one is missing.
const unlisted = posts.map((post) => post.id).filter((id) => !(AJIE_POST_IDS as readonly string[]).includes(id));
if (unlisted.length) throw new Error(`Add these Ajie post IDs to src/data/ajie-posts.ts (and redeploy the stats Worker): ${unlisted.join(', ')}`);
/** Thumbnail: the first photo, or the poster of the first clip. */
const thumbOf = (m: (typeof posts)[number]['data']['media'][number]) => (m.type === 'image' ? m.src : m.poster);
const facts = [
  { label: p.ajie.posts, value: String(posts.length) },
  ajieProfile.adopted && { label: p.ajie.adopted, value: day(ajieProfile.adopted) },
  ajieProfile.born && { label: p.ajie.born, value: day(ajieProfile.born) },
  ajieProfile.sex && { label: p.ajie.sexLabel, value: p.ajie.sex[ajieProfile.sex], sex: ajieProfile.sex },
].filter(Boolean) as { label: string; value: string; sex?: 'male' | 'female' }[];
const bio = pick(ajieProfile.bio);

// Calendar view: one month at a time (switchable), from the first post's month to the last's.
// Weeks start on Sunday; dates are plain calendar days (UTC, like the post dates). A post covers
// its period (from .. date): the last day (the post's date) shows its thumbnail, the days
// before it a band leading up to it.
const monthFmt = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { year: 'numeric', month: 'long', timeZone: 'UTC' });
const weekdayFmt = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { weekday: 'narrow', timeZone: 'UTC' });
// 2023-01-01 was a Sunday.
const weekdays = Array.from({ length: 7 }, (_, i) => weekdayFmt.format(new Date(Date.UTC(2023, 0, 1 + i))));
const iso = (t: Date) => t.toISOString().slice(0, 10);
/** Day -> posts covering it, oldest-starting first. */
const cover = new Map<string, number[]>();
posts.forEach((post, i) => {
  for (let t = utc(post.data.from ?? post.data.date); t <= utc(post.data.date); t.setUTCDate(t.getUTCDate() + 1)) {
    const k = iso(t);
    cover.set(k, [...(cover.get(k) ?? []), i]);
  }
});
for (const list of cover.values()) list.sort((a, b) => (posts[a].data.from ?? posts[a].data.date).localeCompare(posts[b].data.from ?? posts[b].data.date));
const starts = posts.map((post) => post.data.from ?? post.data.date);
const span = posts.length ? [starts.reduce((a, b) => (a < b ? a : b)), posts.map((post) => post.data.date).reduce((a, b) => (a > b ? a : b))] : null;
const months: { ym: string; label: string; lead: number; cells: { day: number; iso: string; post?: number; start: boolean; end: boolean; more: number }[] }[] = [];
if (span) {
  for (let t = utc(`${span[0].slice(0, 7)}-01`); iso(t).slice(0, 7) <= span[1].slice(0, 7); t.setUTCMonth(t.getUTCMonth() + 1)) {
    const y = t.getUTCFullYear();
    const m = t.getUTCMonth();
    const ym = iso(t).slice(0, 7);
    const lead = t.getUTCDay();
    const days = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
    const cells = Array.from({ length: days }, (_, d) => {
      const k = `${ym}-${String(d + 1).padStart(2, '0')}`;
      const list = cover.get(k) ?? [];
      // Where periods overlap, the post that ends here wins the cell (its thumbnail belongs here).
      const pi = list.find((i) => posts[i].data.date === k) ?? list[0];
      if (pi === undefined) return { day: d + 1, iso: k, start: false, end: false, more: 0 };
      const post = posts[pi].data;
      return { day: d + 1, iso: k, post: pi, start: k === (post.from ?? post.date), end: k === post.date, more: list.length - 1 };
    });
    months.push({ ym, label: monthFmt.format(t), lead, cells });
  }
}
---

<PersonalLayout {lang} path="/personal/companion/" title={c.name} description={c.blurb} overlay={false} noindex={posts.length === 0}>
  <div class="ajie pw-page pw-sea" data-ajie data-ai-illustrations="show" data-view="grid">
    <script is:inline>
      try {
        const root = document.currentScript.closest('[data-ajie]');
        if (localStorage.getItem('ajie:ai-illustrations:v1') === 'hide') root.dataset.aiIllustrations = 'hide';
        if (localStorage.getItem('ajie:view:v1') === 'calendar') root.dataset.view = 'calendar';
      } catch {}
    </script>
    <div class="container ajie__inner">
      <!-- Same centred header as the other chapters, plus Ajie's facts. -->
      <header class="ajie__profile pw-head">
        <p class="pw-kicker" data-reveal>{c.kind}</p>
        <h1 class="pw-head__title serif" data-reveal style="--i:1">{c.name}</h1>
        <p class="pw-head__lead" data-reveal style="--i:2">{bio ?? c.blurb}</p>
        <dl class="ajie__facts" data-reveal style="--i:3">
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>
                  {f.sex && (
                    <span class:list={['ajie__sex', `ajie__sex--${f.sex}`]} aria-hidden="true">
                      <Icon name={f.sex === 'male' ? 'lucide:mars' : 'lucide:venus'} />
                    </span>
                  )}
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </header>

      {
        posts.length === 0 ? (
          <p class="ajie__empty" data-reveal>
            <Icon name="lucide:paw-print" />
            {p.posts.empty}
          </p>
        ) : (
          <div class="ajie__posts">
          <!-- Display settings, like the tab row on an IG profile. -->
          <div class="ajie__bar">
            <div class="ajie__views" role="group" aria-label={p.ajie.view}>
              <button type="button" data-view-btn="grid" aria-pressed="true" aria-label={p.ajie.viewGrid} title={p.ajie.viewGrid}>
                <Icon name="lucide:grid-3x3" />
              </button>
              <button type="button" data-view-btn="calendar" aria-pressed="false" aria-label={p.ajie.viewCalendar} title={p.ajie.viewCalendar}>
                <Icon name="lucide:calendar-days" />
              </button>
            </div>
            {hasAiCovers && (
              <div class="ajie__art" role="group" aria-label={p.ajie.aiIllustrations} title={p.ajie.aiDisclosure}>
                <span class="ajie__art-thumb" aria-hidden="true" />
                <button type="button" data-ai-set="show" aria-pressed="true">
                  <Icon name="lucide:pencil-line" />
                  {p.ajie.aiShowArt}
                </button>
                <button type="button" data-ai-set="hide" aria-pressed="false">
                  <Icon name="lucide:camera" />
                  {p.ajie.aiShowPhotos}
                </button>
              </div>
            )}
          </div>
          <ul class="ajie__grid">
            {posts.map((post, i) => {
              const first = post.data.media[0];
              const realBadge = first.type !== 'image' ? 'lucide:clapperboard' : post.data.media.length > 1 ? 'lucide:copy' : null;
              const caption = pick(post.data.caption) ?? '';
              return (
                <li data-reveal style={`--i:${i % 3}`}>
                  <button class="ajie__tile" type="button" data-open={i} aria-label={`${p.ajie.open}: ${pick(post.data.title) ?? caption.slice(0, 60)}, ${when(post.data)}`}>
                    {post.data.cover && <Image class="ajie__thumb ajie__thumb--ai" src={asset(post.data.cover.src)} alt="" widths={[320, 480, 720]} sizes="(min-width: 900px) 33vw, 50vw" quality={74} loading={i < 6 ? 'eager' : 'lazy'} />}
                    <Image class:list={['ajie__thumb', 'ajie__thumb--real', { 'ajie__thumb--behind-ai': post.data.cover }]} src={asset(thumbOf(first)!)} alt="" widths={[320, 480, 720]} sizes="(min-width: 900px) 33vw, 50vw" quality={74} loading={i < 6 ? 'eager' : 'lazy'} />
                    {post.data.cover && <span class="ajie__badge ajie__badge--ai" aria-hidden="true"><Icon name="lucide:copy" /></span>}
                    {realBadge && <span class:list={['ajie__badge', 'ajie__badge--real', { 'ajie__badge--behind-ai': post.data.cover }]} aria-hidden="true"><Icon name={realBadge} /></span>}
                    <span class="ajie__hover" aria-hidden="true">
                      <span class="ajie__tile-text">
                        {post.data.title && <span class="ajie__tile-title">{pick(post.data.title)}</span>}
                        <span class="ajie__tile-date">{when(post.data)}</span>
                        <span class="ajie__tile-date ajie__tile-date--short">{whenShort(post.data)}</span>
                      </span>
                      {statsEnabled && (
                        <span class="ajie__tile-likes" data-tile-likes={post.id} data-swap-skip hidden>
                          <svg class="heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
                          <b />
                        </span>
                      )}
                    </span>
                  </button>
                </li>
              );
            })}
          </ul>
          <div class="ajie__cal" data-cal>
            <div class="ajie__cal-nav" data-cal-nav hidden>
              <button type="button" class="ajie__cal-step" data-cal-step="-1" aria-label={p.ajie.prevMonth} title={p.ajie.prevMonth}>
                <Icon name="lucide:chevron-left" />
              </button>
              <p class="ajie__month-name" data-cal-label aria-live="polite" data-swap-skip />
              <button type="button" class="ajie__cal-step" data-cal-step="1" aria-label={p.ajie.nextMonth} title={p.ajie.nextMonth}>
                <Icon name="lucide:chevron-right" />
              </button>
            </div>
            {months.map((mo) => (
              <section class="ajie__month" data-month={mo.ym} data-label={mo.label} aria-label={mo.label}>
                <h2 class="ajie__month-name ajie__month-title">{mo.label}</h2>
                <ol class="ajie__days">
                  {weekdays.map((w) => (
                    <li class="ajie__weekday" aria-hidden="true">
                      {w}
                    </li>
                  ))}
                  {mo.cells.map((cell, k) => {
                    const lead = k === 0 && mo.lead ? `grid-column-start:${mo.lead + 1}` : undefined;
                    if (cell.post === undefined)
                      return (
                        <li class="ajie__day" style={lead}>
                          <span class="ajie__day-num">{cell.day}</span>
                        </li>
                      );
                    const post = posts[cell.post];
                    const first = post.data.media[0];
                    const wd = (mo.lead + k) % 7;
                    // Band edges: rounded where the period starts, or the week wraps; it runs into the thumbnail.
                    const cls = ['ajie__day', 'ajie__day--post', cell.end ? 'is-thumb' : 'is-mid', { 'is-from': cell.start || wd === 0, 'is-to': cell.end || wd === 6 }];
                    return (
                      <li class:list={cls} style={lead}>
                        <button class="ajie__day-btn" type="button" data-open={cell.post} aria-label={`${p.ajie.open}: ${pick(post.data.title) ?? when(post.data)}, ${when(post.data)}`}>
                          {cell.end && post.data.cover && <Image class="ajie__thumb ajie__thumb--ai" src={asset(post.data.cover.src)} alt="" widths={[160, 320]} sizes="(min-width: 900px) 90px, 14vw" quality={70} loading="lazy" />}
                          {cell.end && <Image class:list={['ajie__thumb', 'ajie__thumb--real', { 'ajie__thumb--behind-ai': post.data.cover }]} src={asset(thumbOf(first)!)} alt="" widths={[160, 320]} sizes="(min-width: 900px) 90px, 14vw" quality={70} loading="lazy" />}
                          <span class="ajie__day-num" aria-hidden="true">{cell.day}</span>
                          {cell.more > 0 && (
                            <span class="ajie__day-more" aria-hidden="true">
                              +{cell.more}
                            </span>
                          )}
                        </button>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))}
          </div>
          </div>
        )
      }
    </div>

    {
      posts.map((post, i) => {
        const caption = pick(post.data.caption) ?? '';
        const place = pick(post.data.location);
        return (
          <dialog class="ajie-post" data-post={i} data-slug={post.id} data-date={post.data.date} aria-label={`${c.name}${post.data.title ? ` – ${pick(post.data.title)}` : ''} · ${when(post.data)}`}>
            <div class="ajie-post__media">
              <PostMedia {lang} media={post.data.cover ? [{ type: 'image', src: post.data.cover.src, alt: post.data.cover.alt, fit: 'contain' }, ...post.data.media] : post.data.media} firstIsAi={Boolean(post.data.cover)} label={`${c.name} · ${when(post.data)}`} ratio="4 / 5" sizes="(min-width: 900px) 520px, 100vw" />
            </div>
            <div class="ajie-post__text">
              <header class="ajie-post__head">
                <h2 class="ajie-post__who">
                  {c.name}
                  {post.data.title && (
                    <>
                      <span class="ajie-post__sep" aria-hidden="true"> – </span>
                      <span class="sr-only">: </span>
                      {pick(post.data.title)}
                    </>
                  )}
                </h2>
                <p class="ajie-post__meta">
                  <time class="ajie-post__date" datetime={post.data.from ? `${post.data.from}/${post.data.date}` : post.data.date}>
                    {when(post.data)}
                  </time>
                  {place && (
                    <span class="ajie-post__place">
                      <Icon name="lucide:map-pin" />
                      {place}
                    </span>
                  )}
                </p>
              </header>
              <div class="ajie-post__caption">
                {caption.split(/\n{2,}/).map((para) => (
                  <p>{para}</p>
                ))}
              </div>
              {statsEnabled && (
                <footer class="ajie-post__foot">
                  <button class="ajie-like" type="button" data-like={post.id} aria-pressed="false" aria-label={p.ajie.like} data-label-on={p.ajie.unlike} data-label-off={p.ajie.like} data-count-label={p.ajie.likes(0)} hidden>
                    <svg class="heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
                    <span class="ajie-like__count" data-like-count data-swap-skip>
                      0
                    </span>
                  </button>
                </footer>
              )}
            </div>
            <button class="icon-btn ajie-post__close" type="button" data-close aria-label={p.posts.close}>
              <Icon name="lucide:x" />
            </button>
            {posts.length > 1 && (
              <>
                <button class="ajie-post__nav ajie-post__nav--prev" type="button" data-step="-1" aria-label={p.posts.prev}>
                  <Icon name="lucide:chevron-left" />
                </button>
                <button class="ajie-post__nav ajie-post__nav--next" type="button" data-step="1" aria-label={p.posts.next}>
                  <Icon name="lucide:chevron-right" />
                </button>
              </>
            )}
          </dialog>
        );
      })
    }
  </div>
</PersonalLayout>

<script>
  import { track } from '@/lib/passport';
  import { canLike, getLikes, likedPosts, setLike, startSync, statsEnabled } from '@/lib/passport-stats';
  const root = document.querySelector<HTMLElement>('[data-ajie]');
  if (root) {
    // ---- Calendar months: one at a time, newest first; the arrows step through them.
    const cal = root.querySelector<HTMLElement>('[data-cal]');
    const monthEls = Array.from(root.querySelectorAll<HTMLElement>('[data-month]'));
    let month = monthEls.length - 1;
    const paintMonth = () => {
      if (!cal || !monthEls.length) return;
      cal.classList.add('is-paged');
      root.querySelector<HTMLElement>('[data-cal-nav]')!.hidden = false;
      monthEls.forEach((el, k) => (el.hidden = k !== month));
      root.querySelector('[data-cal-label]')!.textContent = monthEls[month].dataset.label ?? '';
      root.querySelectorAll<HTMLButtonElement>('[data-cal-step]').forEach((b) => (b.disabled = month + Number(b.dataset.calStep) < 0 || month + Number(b.dataset.calStep) >= monthEls.length));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-cal-step]').forEach((b) =>
      b.addEventListener('click', () => {
        month = Math.min(monthEls.length - 1, Math.max(0, month + Number(b.dataset.calStep)));
        paintMonth();
      }),
    );
    paintMonth();
    // After a language swap the month names are new: repaint the label.
    document.addEventListener('langswap', paintMonth);

    // ---- Grid / calendar view (remembered in this browser).
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
    const paintView = () => viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === root.dataset.view)));
    paintView();
    viewBtns.forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.view = b.dataset.viewBtn;
        try {
          localStorage.setItem('ajie:view:v1', root.dataset.view!);
        } catch {}
        paintView();
      }),
    );
    document.addEventListener('langswap', paintView);

    // ---- Illustrations / photos: what each post opens on (remembered in this browser).
    const artBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ai-set]'));
    const paintAiPreference = () => artBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.aiSet === (root.dataset.aiIllustrations === 'hide' ? 'hide' : 'show'))));
    paintAiPreference();
    artBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const next = b.dataset.aiSet === 'hide' ? 'hide' : 'show';
        if (root.dataset.aiIllustrations === next) return;
        root.dataset.aiIllustrations = next;
        try {
          localStorage.setItem('ajie:ai-illustrations:v1', next);
        } catch {}
        paintAiPreference();
        document.dispatchEvent(new Event('ajie-ai-change'));
      }),
    );
    document.addEventListener('langswap', paintAiPreference);

    const dialogs = Array.from(root.querySelectorAll<HTMLDialogElement>('dialog[data-post]'));
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-open]'));
    let opener: HTMLElement | null = null;
    /**
     * The order the arrows walk, matching what the reader sees: the grid runs newest first (left
     * to right, top to bottom), the calendar runs by date (older on the left, newer on the right).
     */
    const sequence = () =>
      root.dataset.view === 'calendar'
        ? dialogs.map((_, i) => i).sort((a, b) => (dialogs[a].dataset.date ?? '').localeCompare(dialogs[b].dataset.date ?? '') || b - a)
        : dialogs.map((_, i) => i);
    const open = (i: number) => {
      const d = dialogs[i];
      if (!d) return;
      dialogs.forEach((x) => x !== d && x.open && x.close());
      const seq = sequence();
      const at = seq.indexOf(i);
      d.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => {
        const to = seq[at + Number(b.dataset.step)];
        b.hidden = to === undefined;
        b.dataset.to = to === undefined ? '' : String(to);
      });
      if (!d.open) d.showModal();
      track('ajie-post', d.dataset.slug ?? String(i));
    };
    tiles.forEach((t) =>
      t.addEventListener('click', () => {
        opener = t;
        open(Number(t.dataset.open));
      }),
    );
    // ---- Likes: optimistic heart, server count when it answers.
    if (statsEnabled) {
      startSync();
      const counts = new Map<string, number>();
      const liked = likedPosts();
      const paint = () => {
        root.querySelectorAll<HTMLElement>('[data-tile-likes]').forEach((el) => {
          const n = counts.get(el.dataset.tileLikes!) ?? 0;
          el.querySelector('b')!.textContent = String(n);
          el.hidden = n === 0;
        });
        root.querySelectorAll<HTMLButtonElement>('[data-like]').forEach((b) => {
          const id = b.dataset.like!;
          const on = liked.has(id);
          b.hidden = !canLike() && !counts.has(id);
          b.disabled = !canLike();
          b.setAttribute('aria-pressed', String(on));
          b.setAttribute('aria-label', (on ? b.dataset.labelOn : b.dataset.labelOff) ?? '');
          b.querySelector<HTMLElement>('[data-like-count]')!.textContent = String(counts.get(id) ?? 0);
        });
      };
      paint();
      getLikes().then((c) => {
        if (c) for (const [k, v] of Object.entries(c)) counts.set(k, v);
        paint();
      });
      root.querySelectorAll<HTMLButtonElement>('[data-like]').forEach((b) =>
        b.addEventListener('click', async () => {
          const id = b.dataset.like!;
          const on = !liked.has(id);
          const before = counts.get(id) ?? 0;
          // Optimistic: flip straight away, then settle on the server's number.
          if (on) liked.add(id);
          else liked.delete(id);
          counts.set(id, Math.max(0, before + (on ? 1 : -1)));
          b.classList.toggle('is-popping', on);
          paint();
          const server = await setLike(id, on);
          if (server === null) {
            if (on) liked.delete(id);
            else liked.add(id);
            counts.set(id, before);
          } else counts.set(id, server);
          paint();
        }),
      );
      document.addEventListener('langswap', paint);
    }

    for (const d of dialogs) {
      d.addEventListener('click', (ev) => {
        const target = ev.target as Element;
        if (ev.target === d || target.closest('[data-close]')) return d.close();
        const step = target.closest<HTMLElement>('[data-step]');
        if (step?.dataset.to) open(Number(step.dataset.to));
      });
      d.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowRight' && !(ev.target as Element).closest('.pmedia__track')) d.querySelector<HTMLElement>('[data-step="1"]:not([hidden])')?.click();
        if (ev.key === 'ArrowLeft' && !(ev.target as Element).closest('.pmedia__track')) d.querySelector<HTMLElement>('[data-step="-1"]:not([hidden])')?.click();
      });
      d.addEventListener('close', () => {
        d.querySelectorAll('video').forEach((v) => v.pause());
        if (!dialogs.some((x) => x.open)) opener?.focus({ preventScroll: true });
      });
    }
  }
</script>


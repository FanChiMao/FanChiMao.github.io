---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import About from '@/components/About.astro';
import Patents from '@/components/Patents.astro';
import Experience from '@/components/Experience.astro';
import Competitions from '@/components/Competitions.astro';
import Publications from '@/components/Publications.astro';
import Education from '@/components/Education.astro';
import GoDeeper from '@/components/GoDeeper.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import StructuredData from '@/components/StructuredData.astro';
import { site } from '@/lib/site';
import type { Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<Base {lang} path="/">
  <StructuredData slot="head" {lang} />
  <Nav {lang} path="/" home />
  <main id="main">
    <Hero {lang} />
    <About {lang} />
    <Experience {lang} />
    <Publications {lang} />
    <Patents {lang} />
    <Competitions {lang} />
    <Education {lang} />
    <Contact {lang} />
  </main>
  {
    site.personalEntry ? (
      // The ending: "Go Deeper?" and the footer share exactly one screen, like the hero.
      <div class="finale">
        <GoDeeper {lang} />
        <Footer {lang} path="/" visitors abyss />
      </div>
    ) : (
      <Footer {lang} path="/" visitors />
    )
  }
</Base>

<style>
  .finale {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: #020814;
  }
  .finale > :global(.deeper) {
    flex: 1;
  }
</style>

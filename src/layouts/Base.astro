---
import '@/styles/global.css';
import { Icon } from 'astro-icon/components';
import { locales, localeMeta, localePath, ui, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
  /** Locale-agnostic path of this page, e.g. '/' or '/gallery/ramen/'. Used for hreflang + canonical. */
  path: string;
  title?: string;
  /** Use this exact <title> instead of "title · site title". */
  fullTitle?: string;
  description?: string;
  /** Social card path under /public, defaults to the professional card for this locale. */
  ogImage?: string;
  ogAlt?: string;
  /** Which side of the site this page belongs to; restyles tokens via html[data-world]. */
  world?: 'pro' | 'personal';
  /** Keep the page reachable but out of search results (e.g. unfinished chapters). */
  noindex?: boolean;
}

const { lang, path, title, fullTitle, description, ogImage, world = 'pro', noindex = false } = Astro.props;
const t = ui[lang];
const pageTitle = fullTitle ?? (title ? `${title} · ${t.meta.title}` : t.meta.title);
const desc = description ?? t.meta.description;
const site = Astro.site!;
const canonical = new URL(localePath(lang, path), site).href;
// 1200x630 social card per locale, generated by scripts/og.mjs into public/og/.
const ogUrl = new URL(ogImage ?? `/og/${lang}.png`, site).href;
const ogAlt = Astro.props.ogAlt ?? `${t.hero.name} · ${t.hero.position}`;
---

<!doctype html>
<html lang={localeMeta[lang].htmlLang} data-theme="dark" data-world={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content="Chi-Mao Fan" />
    <meta name="keywords" content="Chi-Mao Fan, Jonathan Fan, FanChiMao, 52hzfan, 范植貿, AI R&amp;D engineer, computer vision, deep learning, object detection, image restoration, ASUS" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={new URL(localePath(l, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content="Chi-Mao Fan" />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="shortcut icon" href="/icon.ico" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#060a14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f7fb" media="(prefers-color-scheme: light)" />

    <script is:inline>
      // An address without a language (52hzfan.com, /personal/, ...) opens in the reader's
      // language on their first visit: the browser's languages, with the time zone deciding
      // between Traditional and Simplified for a plain "zh". Picking a language in the switcher
      // is remembered and always wins (including English). Crawlers are left alone.
      (() => {
        const p = location.pathname;
        if (/^\/(?:zh-tw|zh-cn|ja)(?:\/|$)/.test(p) || /^\/(?:admin|playground)(?:\/|$)/.test(p)) return;
        if (navigator.webdriver || /bot|crawl|spider|slurp|lighthouse|headless|preview/i.test(navigator.userAgent)) return;
        let pref = null;
        try { pref = localStorage.getItem('lang'); } catch {}
        if (pref === 'en') return;
        const tz = (Intl.DateTimeFormat().resolvedOptions().timeZone || '');
        const pick = (tag) => {
          tag = String(tag || '').toLowerCase();
          if (tag.startsWith('ja')) return 'ja';
          if (tag.startsWith('zh')) {
            if (/hant|-tw|-hk|-mo/.test(tag)) return 'zh-tw';
            if (/hans|-cn|-sg|-my/.test(tag)) return 'zh-cn';
            return /Taipei|Hong_Kong|Macau/.test(tz) ? 'zh-tw' : 'zh-cn';
          }
          if (tag.startsWith('en')) return 'en';
          return null;
        };
        let lang = pref === 'zh-tw' || pref === 'zh-cn' || pref === 'ja' ? pref : null;
        if (!lang) for (const t of navigator.languages || [navigator.language]) if ((lang = pick(t))) break;
        if (!lang || lang === 'en') return;
        location.replace('/' + lang + p + location.search + location.hash);
      })();
    </script>
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        // Mouse / trackpad: overlay scrollbar (lib/scrollbar.ts) instead of the native gutter.
        if (matchMedia('(pointer: fine)').matches) d.classList.add('has-overlay-scrollbar');
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="scrollbar" data-scrollbar aria-hidden="true" hidden><div class="scrollbar__thumb"></div></div>
    <slot />

    <script is:inline>
      // Language switch: land on the same spot of the translated page. Runs before
      // first paint so the view transition snapshots the restored position.
      (() => {
        let s = null;
        try {
          s = JSON.parse(sessionStorage.getItem('lang-switch') || 'null');
          sessionStorage.removeItem('lang-switch');
        } catch {}
        const norm = (p) => p.replace(/\/+$/, '') || '/';
        if (!s || norm(s.to) !== norm(location.pathname) || Date.now() - s.t > 30000) return;
        const target = () => {
          const el = s.id && document.getElementById(s.id);
          if (el) return el.getBoundingClientRect().top + scrollY + s.r * el.offsetHeight;
          return s.p * (document.documentElement.scrollHeight - innerHeight);
        };
        // Keep expanded "Load more" lists expanded, or the anchor section changes height.
        if (s.more) document.querySelector('[data-comp-grid]')?.classList.add('is-expanded');
        const go = () => scrollTo({ top: target(), behavior: 'instant' });
        go();
        // Show what is already on screen instead of replaying the reveal animation.
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom > 0 && r.top < innerHeight) el.classList.add('is-visible', 'is-instant');
        });
        // Web fonts can shift layout a little; re-align once unless the user already scrolled.
        const y = scrollY;
        document.fonts?.ready.then(() => scrollY === y && go());
      })();
    </script>

    <dialog class="media-dialog" id="media-dialog" aria-label="Media">
      <button class="icon-btn media-dialog__close" type="button" data-dialog-close aria-label={t.a11y.close}>
        <Icon name="lucide:x" />
      </button>
      <div class="media-dialog__body" data-dialog-body></div>
    </dialog>

    <script>
      import { swapLanguage, warm, handleHistory } from '@/lib/lang-swap';
      import { setupScrollbar } from '@/lib/scrollbar';

      const bar = document.querySelector<HTMLElement>('[data-scrollbar]');
      if (bar && document.documentElement.classList.contains('has-overlay-scrollbar')) setupScrollbar(bar);

      // ---- Language links ([data-lang-link])
      // Personal world: swap text in place (no reload). Elsewhere, or if the swap is not
      // possible: prefetch on intent, remember the scroll spot and navigate.
      const inPlace = document.documentElement.dataset.world === 'personal';
      if (inPlace) handleHistory();

      const prefetched = new Set<string>();
      const canPrefetch = document.createElement('link').relList.supports?.('prefetch');
      const prefetch = (a: HTMLAnchorElement) => {
        if (a.hasAttribute('aria-current') || prefetched.has(a.href)) return;
        prefetched.add(a.href);
        if (inPlace) return warm(a.href);
        if (canPrefetch) {
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.href = a.href;
          document.head.append(link);
        } else {
          fetch(a.href, { credentials: 'same-origin' }).catch(() => prefetched.delete(a.href));
        }
      };
      const langLink = (ev: Event) => (ev.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-lang-link]');
      for (const type of ['pointerover', 'focusin', 'touchstart']) {
        document.addEventListener(type, (ev) => {
          const a = langLink(ev);
          if (a) prefetch(a);
        }, { passive: true });
      }
      // Opening the nav language menu is already a strong signal: warm every option.
      document.querySelector<HTMLDetailsElement>('[data-lang-menu]')?.addEventListener('toggle', (ev) => {
        const menu = ev.currentTarget as HTMLDetailsElement;
        if (menu.open) menu.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach(prefetch);
      });

      /** Remember which section (and how far into it) is at the top, for the page we load next. */
      const rememberSpot = (to: string) => {
        let id = '';
        let r = 0;
        for (const sec of document.querySelectorAll<HTMLElement>('main section[id]')) {
          const top = sec.getBoundingClientRect().top;
          if (top > 1) break;
          id = sec.id;
          r = Math.min(1, -top / sec.offsetHeight);
        }
        const max = document.documentElement.scrollHeight - innerHeight;
        const more = !!document.querySelector('[data-comp-grid].is-expanded');
        const state = { to: new URL(to).pathname, id, r, p: max > 0 ? scrollY / max : 0, more, t: Date.now() };
        try {
          sessionStorage.setItem('lang-switch', JSON.stringify(state));
        } catch {}
      };

      document.addEventListener('click', (ev) => {
        const a = langLink(ev);
        if (!a || ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
        // A language picked by hand is the reader's choice from now on (see the redirect in <head>).
        try {
          localStorage.setItem('lang', new URL(a.href).pathname.match(/^\/(zh-tw|zh-cn|ja)(?:\/|$)/)?.[1] ?? 'en');
        } catch {}
        a.closest('details')?.removeAttribute('open');
        if (a.hasAttribute('aria-current')) {
          // Already in this language: nothing to do.
          ev.preventDefault();
          return;
        }
        if (!inPlace) return rememberSpot(a.href);
        ev.preventDefault();
        const href = a.href;
        swapLanguage(href).then((ok) => {
          if (ok) return;
          rememberSpot(href);
          location.assign(href);
        });
      });

      // ---- Scroll reveal
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              reveal.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

      // ---- Cursor spotlight on cards
      document.addEventListener(
        'pointermove',
        (ev) => {
          const card = (ev.target as Element | null)?.closest?.<HTMLElement>('.spotlight');
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          card.style.setProperty('--my', `${ev.clientY - r.top}px`);
        },
        { passive: true },
      );

      // ---- Theme toggle (buttons carry data-theme-toggle)
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const d = document.documentElement;
          const next = d.dataset.theme === 'dark' ? 'light' : 'dark';
          const apply = () => {
            d.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
          };
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          // A page with its own theme scene (the personal hero's sunrise / moonrise) animates itself.
          if (!document.startViewTransition || reduce || document.querySelector('[data-theme-scene]')) return apply();
          document.startViewTransition(apply);
        }),
      );

      // ---- Shared media dialog: [data-video="<youtube id>"] or [data-image="<url>"]
      const dialog = document.getElementById('media-dialog') as HTMLDialogElement;
      const body = dialog.querySelector<HTMLElement>('[data-dialog-body]')!;
      document.addEventListener('click', (ev) => {
        const trigger = (ev.target as Element).closest<HTMLElement>('[data-video], [data-image]');
        if (!trigger) return;
        ev.preventDefault();
        body.replaceChildren();
        if (trigger.dataset.video) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${trigger.dataset.video}?autoplay=1&rel=0`;
          iframe.title = trigger.dataset.title ?? 'YouTube video';
          iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          iframe.className = 'media-dialog__video';
          body.append(iframe);
        } else if (trigger.dataset.image) {
          const img = document.createElement('img');
          img.src = trigger.dataset.image;
          img.alt = trigger.dataset.title ?? '';
          img.className = 'media-dialog__image';
          body.append(img);
        }
        dialog.showModal();
      });
      dialog.addEventListener('click', (ev) => {
        if (ev.target === dialog || (ev.target as Element).closest('[data-dialog-close]')) dialog.close();
      });
      dialog.addEventListener('close', () => body.replaceChildren());
    </script>

    <script>
      // 52Hz Logbook event sources that exist on every page (lib/passport.ts decides what unlocks).
      import { LOCALE_OF, track } from '@/lib/passport';

      const reportLang = () => track('lang', LOCALE_OF[document.documentElement.lang] ?? document.documentElement.lang);
      reportLang();
      document.addEventListener('langswap', reportLang);
      // One entry per local calendar day, for the "regular" badge.
      const today = new Date();
      track('day', `${today.getFullYear()}-${today.getMonth() + 1}-${today.getDate()}`);
      // Paper abstracts on the professional home (toggle does not bubble: listen in the capture phase).
      document.addEventListener(
        'toggle',
        (e) => {
          const d = e.target as HTMLDetailsElement;
          if (d.open && d.matches?.('.pub__abstract')) track('abstract', d.dataset.pub ?? '');
        },
        true,
      );
      // Outbound links: a patent record, or any project's code on GitHub (mouse, keyboard or middle click).
      const onLink = (e: Event) => {
        const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href]');
        if (!a) return;
        const url = new URL(a.href, location.href);
        if (url.hostname === 'patents.google.com') track('patent', url.pathname);
        if (url.hostname === 'github.com' && url.pathname.split('/').filter(Boolean).length >= 2) track('github', url.pathname);
      };
      document.addEventListener('click', onLink, true);
      document.addEventListener('auxclick', onLink, true);
      // Dragging the thesis restoration before/after slider.
      document.addEventListener('input', (e) => {
        if ((e.target as Element).matches?.('.ba__range')) track('restore');
      });
      // Theme changes on a page with its own sunrise / moonlit scene (the personal hero).
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (!document.querySelector('[data-theme-scene]')) return;
          // The main toggle handler has already flipped data-theme by now.
          requestAnimationFrame(() => track('scene-theme', document.documentElement.dataset.theme ?? ''));
        }),
      );
    </script>

    <style is:global>
      .media-dialog {
        width: min(100% - 2rem, 1040px);
        max-height: calc(100dvh - 2rem);
        padding: 52px 0 0;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        background: var(--bg-elev);
        color: var(--text);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        opacity: 0;
        scale: 0.96;
        transition:
          opacity 0.3s var(--ease-out),
          scale 0.3s var(--ease-out),
          overlay 0.3s allow-discrete,
          display 0.3s allow-discrete;
      }
      .media-dialog[open] {
        opacity: 1;
        scale: 1;
      }
      @starting-style {
        .media-dialog[open] {
          opacity: 0;
          scale: 0.96;
        }
      }
      .media-dialog::backdrop {
        background: rgb(3 6 14 / 0.75);
        backdrop-filter: blur(6px);
      }
      .media-dialog__close {
        position: absolute;
        top: 6px;
        right: 8px;
        z-index: 1;
      }
      .media-dialog__video {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 0;
      }
      .media-dialog__image {
        width: 100%;
        max-height: calc(100dvh - 2rem - 52px);
        object-fit: contain;
        background: #000;
      }
    </style>
  </body>
</html>
